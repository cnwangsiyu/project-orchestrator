                previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, (signal.SIGINT, signal.SIGTERM, signal.SIGHUP))
                try:
                    try: os.mkdir(directory)
                    except FileExistsError: continue
                    created = (directory, os.open(directory, os.O_RDONLY | os.O_DIRECTORY))
                finally: signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
                hold = dict(by=by, project=project, task=task, **{'for': purpose}, since=datetime.datetime.now().strftime('%Y-%m-%d %H:%M'),
                            until=until, pid=str(pid), host=host, start=str(int(time.time())), pool_controller=controller_key)
                if not alive(pid): hold['pid_warning'] = 'short-lived pid'
                if previous_holder: hold['reclaimed_from'] = previous_holder
                if id in dynamic_ids:
                    claim_kind = 'LIGHT' if request == 'devbox-cn-light' else 'HEAVY'
                    _, _, _, weights, _ = evaluate(id, box, claimed=True)
                    hold.update(claim_kind=claim_kind, claim_cores=str(weights[0]), claim_mem=str(weights[1]), claim_disk=str(weights[2]))
                    catalog = os.path.join(root, 'devbox-leases'); os.makedirs(catalog, exist_ok=True)
                    machine_helpers['atomic_json'](os.path.join(catalog, id + '.json'), dict(slot=id, host=box, category=claim_kind))
                publish(directory, hold)
                description = rows[id][3]
            scratch = os.path.realpath(root) != os.path.realpath(os.path.expanduser('~/.claude/orchestrator/_shared'))
            inject = os.environ.get('RES_TEST_POOL_REJECT', '') if scratch else ''
            check_log = os.environ.get('RES_TEST_POOL_CHECK_LOG', '') if scratch else ''
            if check_log:
                with open(check_log, 'a') as stream: stream.write(id + '\n')
            if inject == 'error': raise ValueError('injected health read failure after reservation')
            if inject == 'expire' and waiter:
                own['heartbeat'] = '1'; publish(waiter, own)
            barrier = os.environ.get('RES_TEST_POOL_CLAIM_BARRIER', '') if scratch else ''
            if barrier:
                with open(os.path.join(barrier, controller), 'w'): pass
                while not os.path.exists(os.path.join(barrier, 'release')): time.sleep(0.02)
            # Recheck the current registry, health, and FIFO after the atomic claim.
            with admission(), host_guard(box):
                state = health()
                rejected = False
                if action == 'wait':
                    rows, remote = read_registry()
                    rejected = not eligible(id) or rows[id][3] != description or quarantined(id, state)
                    refresh_waiter()
                elif box:
                    rows, remote = read_registry()
                    rejected = (id not in rows or rows[id][3] != description or rows[id][1] == 'never'
                                or rows[id][1] == 'ask-user' and not force)
                if box: dynamic, _, _ = devbox_settings()
                permitted = not rejected and fifo_allows(id, state, claimed=True)
                if box and os.path.lexists(pending_file(id)): rejected = True
                if not rejected and not permitted: blocked = True; heads = waiting()
                if rejected or not permitted or inject == 'all':
                    rollbacks += int(rollback())
                    if rollbacks >= 3:
                        last_order = max((int(order) for order, _, _ in waiting() if order.isdecimal()), default=0)
                        own['order'] = '%020d' % max(time.time_ns(), last_order + 1)
                        own['blocked'] = 'rollback'; refresh_waiter()
                        log('waiter-yield', request + '-any', by + ' (' + project + ('/' + task if task else '') + ')', 'rollbacks=3')
                        print("res: yielding pool '%s' (FIFO) after 3 candidate rollbacks" % request, file=sys.stderr)
                        break
                    continue
                if box:
                    reason, detail, entries, cost, current = evaluate(id, box, can_override(), claimed=True)
                    if not gate_open(reason):
                        rollback()
                        continue
                    if cost: reserve(box, entries, current, cost, id, hold)
                    if id in dynamic_ids:
                        hold['admitted']='1'; publish(os.path.join(locks,id+'.d'), hold)
                    for directory, earlier in bypass_pending:
                        latest = info(directory)
                        if latest.get('order') == earlier.get('order'):
                            count=bypass_count(latest)+1
                            os.makedirs(os.path.join(root,'pool-bypasses'),exist_ok=True)
                            machine_helpers['atomic_json'](bypass_file(latest), count)
                            latest['bypasses'] = str(count); publish(directory, latest)
                            log('waiter-bypass', id, by, 'older=' + latest.get('holder','?') + ' count=' + latest['bypasses'])
                    if cost or floating(id): log('gate-admit', id, holder, 'reason=' + reason + ' ' + detail)
            log('take', id, by + ' (' + project + ('/' + task if task else '') + ')', purpose + (' · until ' + until if until else ''))
            print('took ' + id)
            print_notes(id)
            if action == 'wait':
                log('waiter-acquire', request + '-any', by + ' (' + project + ('/' + task if task else '') + ')', 'slot=' + id)
                remove_waiter(); print('slot=' + id)
            committed = True; sys.exit(0)
    if action == 'take':
        hold = info(os.path.join(locks, request + '.d'))
        if blocked: print("res: '%s': reserved for waiting pool %s (FIFO); retry or use wait-pool" % (request, heads[0][2].get('holder', '?') if heads else '?'), file=sys.stderr)
        elif gate_reasons:
            reason = next(iter(gate_reasons))
            print("res: '%s': devbox gate %s" % (request, reason), file=sys.stderr)
            if reason.startswith('closed-'): sys.exit(3)
        else: print("res: '%s' is held by %s (pid=%s, since=%s)" % (request, hold.get('by', '?'), hold.get('pid', '?'), hold.get('since', '?')), file=sys.stderr)
        sys.exit(2)
    heads = waiting()
    if 'load' in gate_reasons and heads and current_waiter(heads[0][1], heads[0][2]):
        own.setdefault('load_blocked_since', str(time.time()))
    else:
        own.pop('load_blocked_since', None)
    own['blocked'] = ('io-pressure' if 'io-pressure' in gate_reasons else 'disk' if 'disk' in gate_reasons else 'memory' if 'memory' in gate_reasons else 'load' if 'load' in gate_reasons else
                      'FIFO' if blocked else own.get('blocked', 'slot'))
    refresh_waiter()
    remaining = float(own['started_at']) + float(timeout) * 60 - time.time()
    if remaining <= 0:
        log('waiter-timeout', request + '-any', by + ' (' + project + ('/' + task if task else '') + ')', 'after ' + timeout + ' minutes')
        remove_waiter(); print("res: timed out waiting for pool '%s' after %s minutes" % (request, timeout), file=sys.stderr); sys.exit(2)
    wait = min(float(delay), remaining)
    print("res: waiting for pool '%s' (FIFO); retry in %ss" % (request, '%g' % wait), file=sys.stderr, flush=True)
    scratch = os.path.realpath(root) != os.path.realpath(os.path.expanduser('~/.claude/orchestrator/_shared'))
    if scratch:
        mark = os.environ.get('PAUSE_MARK', '') if float(delay) == 1 else os.environ.get('SECOND_MARK', os.environ.get('PAUSE_ON_SECOND', '')) if float(delay) == 2 else ''
        if mark:
            with open(mark, 'w'): pass
            while not os.path.exists(mark + '.release'):
                time.sleep(0.02)
            refresh_waiter()
        if os.environ.get('RES_TEST_POOL_FAST_POLL') == '1': wait = min(wait, 0.03)
    time.sleep(wait); sys.exit(6)
except (OSError, ValueError, TypeError, KeyError) as error:
    label = 'box health' if action == 'box-health' else 'pool'
    print('res: ' + label + ': ' + str(error), file=sys.stderr); sys.exit(1)
finally:
    if not committed and created:
        # In particular, a light-slot rollback must serialize with stale reclaim.
        with admission(): rollback()
    elif created: os.close(created[1])
    if sys.exc_info()[0] is not None and not (isinstance(sys.exc_info()[1], SystemExit) and sys.exc_info()[1].code == 6): remove_waiter()
PY
}


cmd_wait_pool() {
  local pool="${1:-}"; shift || true; pool="${pool%-}"
  [[ "$pool" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "wait-pool needs a resource prefix"
  local timeout= args=() ALLOW_PID=1 prefer_host= prefer_slot= POOL_NEED= excluded_slots= excluded_hosts= exclude_reason= hard_slots= hard_hosts= warm_family= delay=1 rc POOL_CHILD_PID=
  local POOL_EPISODE="$RANDOM.$RANDOM.$RANDOM"
  local POOL_PENDING_SIGNAL=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout|--need|--prefer-host|--prefer-slot|--exclude-slot|--exclude-host|--exclude-reason|--hard-exclude-slot|--hard-exclude-host|--warm-family)
        [ $# -ge 2 ] || die "$1 needs a value"
        case "$1" in
          --timeout) [ -z "$timeout" ] || die "duplicate --timeout"; timeout="$2" ;;
          --need) POOL_NEED="$2" ;;
          --warm-family) warm_family="$2" ;;
          --prefer-host) prefer_host="$2" ;;
          --prefer-slot) prefer_slot="$2" ;;
          --exclude-slot) excluded_slots="$2" ;;
          --exclude-host) excluded_hosts="$2" ;;
          --exclude-reason)
            [[ "$2" =~ [^[:space:]] && "$2" != *$'\n'* && "$2" != *$'\r'* && "$2" != *$'\t'* ]] || die "invalid --exclude-reason"
            exclude_reason="$2" ;;
          --hard-exclude-slot) hard_slots="$2" ;;
          --hard-exclude-host) hard_hosts="$2" ;;
        esac; shift 2 ;;
      --by|--project|--for|--task|--until|--note|--pid|--disk-gib|--disk-gib-file|--placement-file|--extra-disk-gib|--cores|--mem-gib)
        [ $# -ge 2 ] || die "$1 needs a value"; args+=("$1" "$2"); shift 2 ;;
      --force|--offline|--maintenance) args+=("$1"); shift ;;
      *) die "unknown option '$1'" ;;
    esac
  done
  [[ "$timeout" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "wait-pool needs --timeout <non-negative minutes>"
  parse ${args[@]+"${args[@]}"}; validate_pid
  [ -n "$BY" ] && [ -n "$PROJECT" ] && [ -n "$PURPOSE" ] || die "wait-pool needs --by, --project and --for"
  pool_cancel() {
    local code="$1"
    [ "$POOL_PENDING_SIGNAL" -eq 0 ] || code="$POOL_PENDING_SIGNAL"
    trap '' INT TERM HUP
    [ -z "$POOL_CHILD_PID" ] || kill -s "$2" "$POOL_CHILD_PID" 2>/dev/null || true
    [ -z "$POOL_CHILD_PID" ] || wait "$POOL_CHILD_PID" 2>/dev/null || true
    pool_controller cancel "$pool" 0 0 >/dev/null
    trap - EXIT
    exit "$code"
  }
  trap 'pool_controller cleanup "$pool" 0 0 >/dev/null' EXIT
  trap 'pool_cancel 130 INT' INT
  trap 'pool_cancel 143 TERM' TERM
  trap 'pool_cancel 129 HUP' HUP
  while :; do
    POOL_PENDING_SIGNAL=0
    trap '[ "$POOL_PENDING_SIGNAL" -ne 0 ] || POOL_PENDING_SIGNAL=130' INT
    trap '[ "$POOL_PENDING_SIGNAL" -ne 0 ] || POOL_PENDING_SIGNAL=143' TERM
    trap '[ "$POOL_PENDING_SIGNAL" -ne 0 ] || POOL_PENDING_SIGNAL=129' HUP
    POOL_EXEC_CHILD=1 pool_controller wait "$pool" "$timeout" "$delay" & POOL_CHILD_PID=$!
    trap 'pool_cancel 130 INT' INT
    trap 'pool_cancel 143 TERM' TERM
    trap 'pool_cancel 129 HUP' HUP
    case "$POOL_PENDING_SIGNAL" in 130) pool_cancel 130 INT ;; 143) pool_cancel 143 TERM ;; 129) pool_cancel 129 HUP ;; esac
    if wait "$POOL_CHILD_PID"; then rc=0; else rc=$?; fi
    POOL_CHILD_PID=
    [ "$rc" -eq 6 ] || { trap - EXIT INT TERM HUP; return "$rc"; }
    delay=$((delay * 2)); [ "$delay" -le 15 ] || delay=15
  done
}


registry_record() {
  local wanted="$1" id
  if [[ "$wanted" =~ ^heavy-build-[23]$ ]] && [ "${BUILD_SLOT_INTERNAL:-0}" = 1 ]; then wanted=heavy-build; fi
  REG_KIND= REG_POLICY= REG_DEVICE= REG_DESCRIPTION=
  while IFS=$'\t' read -r id REG_KIND REG_POLICY REG_DEVICE REG_DESCRIPTION; do
    [ "$id" != "$wanted" ] || return 0
  done <"$REG"
  if [[ "$wanted" = devbox-cn-* ]]; then
    local resolved
    resolved=$(pool_report slot-host "$wanted" 2>/dev/null) || return 1
    IFS=$'\t' read -r REG_KIND REG_POLICY REG_DEVICE REG_DESCRIPTION < <(python3 -c 'import json,sys; v=json.loads(sys.argv[1]); print(v["kind"]+"\t"+v["policy"]+"\t-\t"+v["target"])' "$resolved")
    return 0
  fi
  return 1
}

cmd_return_build() {
  local ALLOW_PID=1 id owner selected_pid options=() BUILD_SLOT_INTERNAL=1; parse "$@"
  [ -n "$BY" ] || die "return-build needs --by"
  [ -z "$PID_EXPLICIT" ] || validate_pid
  [ -z "$FORCE$PROJECT$PURPOSE$TASK$UNTIL$OFFLINE$DEVICE$POLICY" ] || die "return-build accepts only --by, --pid and --note"
  options=(--by "$BY" --note "$NOTE")
  owner="$BY"; selected_pid="${PID_EXPLICIT:+$PID}"
  for id in heavy-lane-3 heavy-lane-2 heavy-lane-1 heavy-build-3 heavy-build-2 heavy-build; do
    [ "$(field "$id" by)" = "$owner" ] || continue
    [ -z "$selected_pid" ] || [ "$(field "$id" pid)" = "$selected_pid" ] || continue
    cmd_return "$id" "${options[@]}"
  done
}

# Preserve the mkdir verdict through a signal before the shell can set its
# ownership flag. Only new transactions use this; legacy take is unchanged.
transaction_mkdir() {
  local rc=0
  trap '[ "$TRANSACTION_PENDING_SIGNAL" -ne 0 ] || TRANSACTION_PENDING_SIGNAL=130' INT
  trap '[ "$TRANSACTION_PENDING_SIGNAL" -ne 0 ] || TRANSACTION_PENDING_SIGNAL=143' TERM
  trap '[ "$TRANSACTION_PENDING_SIGNAL" -ne 0 ] || TRANSACTION_PENDING_SIGNAL=129' HUP
  (trap '' INT TERM HUP; mkdir "$1" 2>/dev/null) || rc=$?
  [ "$rc" -ne 0 ] || TAKE_CREATED=1
  arm_transaction_signals
  [ "$TRANSACTION_PENDING_SIGNAL" -eq 0 ] || transaction_signal "$TRANSACTION_PENDING_SIGNAL"
  return "$rc"
}

take_mkdir() {
  if [ "${TAKE_TRANSACTION:-0}" = 1 ]; then transaction_mkdir "$1"
  else mkdir "$1" 2>/dev/null; fi
}

pool_report() {
