        # Distinct rows can compete for the same measured headroom. Keep that
        # host available to its older eligible waiters while allowing other hosts.
        box = remote[id][1]
        if box in dynamic and sample(box, time.time()) and any(
                remote[slot][1] == box for choices in options for slot in choices):
