import datetime
import fcntl
import hashlib
import json
import math
import os
import re
import stat
import subprocess
import tempfile
import time

HEAVY_DEFAULTS = dict(LOAD_LIMIT=12, LOAD_LIMIT_WITH_LANES=20, MIN_AVAIL_GIB=16,
    LANE3_LOAD=8, LANE3_AVAIL_GIB=32, LANE_LOAD_PER_CORE=1.25, LANE_MIN_AVAIL_GIB=12,
    BUILD_LOAD_PER_CORE=1.5, BUILD_MAX_CONCURRENCY=2, BUILD_CONCURRENT_LOAD_PER_CORE=0.6,
    BUILD_CONCURRENT_MIN_AVAIL_GIB=24, LOAD_OVERRIDE_MINUTES=20, LOAD_POLL_SECONDS=15,
    HEAD_OVERRIDE_BASE_LOAD=0, MEM_GUARD=1, MEM_GUARD_COMPRESSOR_GIB=24,
    MEM_GUARD_SWAP_GIB=36, MEM_GUARD_SWAP_GROWTH_GIB=6, MEM_GUARD_WINDOW_SEC=120,
    MEM_GUARD_SUSTAIN=6, MEM_GUARD_SWAPFILES=48,
    MEM_GUARD_SAMPLES='~/.claude/orchestrator/_shared/reports/mini-memory/samples-%Y-%m-%d.tsv')
DEVBOX_DEFAULTS = dict(LOAD_PER_CORE=1, MIN_AVAIL_GIB=4, HEAVY_CORES=3, HEAVY_GIB=4,
    LIGHT_CORES=1, LIGHT_GIB=2, HEAVY_DISK_GIB=20, LIGHT_DISK_GIB=2,
    IO_SOME_AVG60_MAX=25, IO_FULL_AVG10_MAX=10, MAX_CLAIMS=0, MAX_BYPASS=3)

def regular_config(file, maximum=65536):
    with os.fdopen(os.open(file, os.O_RDONLY | os.O_NONBLOCK), 'rb') as stream:
        before = os.fstat(stream.fileno())
        if not stat.S_ISREG(before.st_mode) or before.st_size > maximum:
            raise ValueError('machine.conf must be a readable regular file <=64 KiB')
        data = stream.read(before.st_size + 1)
        after = os.fstat(stream.fileno())
    stamp = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
    if stamp(before) != stamp(after) or len(data) != before.st_size:
        raise ValueError('machine.conf changed during the read')
    if not data or not data.endswith(b'\n'): raise ValueError('incomplete machine.conf (final newline required)')
    return data.decode('utf-8')

def parse_config(content):
    heavy = dict(HEAVY_DEFAULTS); values = {}; local = {}; unknown = set(); seen = set()
    host = r'[A-Za-z0-9][A-Za-z0-9.-]*'
    for line in content.splitlines():
        if not line.strip() or line.lstrip().startswith('#'): continue
        name, sep, value = (part.strip() for part in line.partition('='))
        if not sep or not re.fullmatch(r'[A-Z][A-Z0-9_]*(\.[A-Za-z0-9_.-]+)?', name) or name in seen:
            raise ValueError('invalid machine.conf line or duplicate setting')
        seen.add(name)
        if name in ('LOCAL_LOAD_LIMIT','LOCAL_MIN_AVAILABLE_GIB','LOCAL_HEAVY_CORES','LOCAL_HEAVY_GIB',
                    'LOCAL_MEDIUM_CORES','LOCAL_MEDIUM_GIB','LOCAL_LIGHT_CORES','LOCAL_LIGHT_GIB','LOCAL_MIN_FREE_GIB','LOCAL_MAX_BYPASS','LOCAL_METRICS_TTL_SECONDS'):
            derived = name in ('LOCAL_LOAD_LIMIT','LOCAL_MIN_AVAILABLE_GIB','LOCAL_HEAVY_CORES','LOCAL_HEAVY_GIB','LOCAL_MEDIUM_CORES','LOCAL_MEDIUM_GIB')
            integer = name in ('LOCAL_MAX_BYPASS','LOCAL_METRICS_TTL_SECONDS')
            if value == 'derived' and derived: local[name]=value; continue
            if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)?',value) or not 0<float(value)<=65536 or integer and not value.isdecimal():
                raise ValueError('invalid local capacity setting ' + name)
            if name == 'LOCAL_MAX_BYPASS' and float(value)>32 or name == 'LOCAL_METRICS_TTL_SECONDS' and float(value)>30:
                raise ValueError('local capacity setting exceeds bound ' + name)
            local[name]=int(value) if integer else float(value); continue
        if name == 'MEM_GUARD_SAMPLES':
            if not value.startswith(('/', '~/')) or len(value) > 4096 or not value.endswith('.tsv') or any(ord(c) < 32 for c in value):
                raise ValueError('invalid memory sample path')
            heavy[name] = value; continue
        if name in heavy:
            if name in ('MEM_GUARD', 'HEAD_OVERRIDE_BASE_LOAD'):
                if value not in ('0', '1') or name == 'HEAD_OVERRIDE_BASE_LOAD' and value != '1':
                    raise ValueError('invalid machine.conf switch ' + name)
                heavy[name] = int(value); continue
            ceiling = 65536 if name.endswith('GIB') else 86400 if name == 'MEM_GUARD_WINDOW_SEC' else 1440 if name == 'LOAD_OVERRIDE_MINUTES' else 1024
            if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)?', value) or not 0 < float(value) <= ceiling:
                raise ValueError('invalid machine.conf number ' + name)
            if name in ('BUILD_MAX_CONCURRENCY', 'LOAD_POLL_SECONDS', 'MEM_GUARD_WINDOW_SEC', 'MEM_GUARD_SUSTAIN', 'MEM_GUARD_SWAPFILES') and not value.isdecimal():
                raise ValueError('invalid machine.conf integer ' + name)
            heavy[name] = int(value) if value.isdecimal() else float(value)
        elif name in ('DEVBOX_DYNAMIC_ADMISSION', 'DEVBOX_LIGHT_STALE_RECLAIM', 'DEVBOX_HEAVY_STALE_RECLAIM', 'DEVBOX_REBUILD_PLACEMENT', 'DEVBOX_RANK_BY_SPARE'):
            if value not in ('0', '1'): raise ValueError('invalid devbox switch ' + name)
            values[name] = value
        elif name in ('DEVBOX_INPUT_TTL_SECONDS', 'DEVBOX_INPUT_WAIT_CAP_SECONDS', 'DEVBOX_INPUT_SEED_MAX_SECONDS'):
            if not value.isdecimal() or not 0 < int(value) <= 86400: raise ValueError('invalid input setting ' + name)
            values[name] = int(value)
        elif name == 'DEVBOX_DYNAMIC_HOSTS':
            if value and not re.fullmatch(host + '(,' + host + ')*', value): raise ValueError('invalid dynamic hosts')
            values[name] = value
        else:
            setting, _, suffix = name[7:].partition('.') if name.startswith('DEVBOX_') else ('', '', '')
            if setting not in DEVBOX_DEFAULTS and not (setting == 'SOFT_EXCLUDE_MINUTES' and not suffix):
                unknown.add(name); continue
            pattern = r'[A-Za-z0-9][A-Za-z0-9_.-]*' if suffix.startswith('project.') and setting.endswith('_DISK_GIB') else host
            target = suffix[8:] if suffix.startswith('project.') and setting.endswith('_DISK_GIB') else suffix
            if suffix and not re.fullmatch(pattern, target): raise ValueError('invalid devbox override')
            io = setting in ('IO_SOME_AVG60_MAX', 'IO_FULL_AVG10_MAX')
            integer = setting in ('MAX_CLAIMS', 'MAX_BYPASS')
            if integer and not value.isdecimal(): raise ValueError('invalid integer ' + name)
            if (not re.fullmatch(r'[0-9]+(?:\.[0-9]+)?', value)
                    or not (0 <= float(value) <= (100 if io else 65536) if io or integer else 0 < float(value) <= 65536)):
                raise ValueError('invalid devbox cost ' + name)
            values[name] = float(value)
    if not (heavy['LOAD_LIMIT_WITH_LANES'] >= heavy['LOAD_LIMIT'] >= heavy['LANE3_LOAD']
            and heavy['LANE3_AVAIL_GIB'] >= heavy['MIN_AVAIL_GIB']
            and heavy['BUILD_CONCURRENT_LOAD_PER_CORE'] <= heavy['LANE_LOAD_PER_CORE'] <= heavy['BUILD_LOAD_PER_CORE']
            and heavy['BUILD_CONCURRENT_MIN_AVAIL_GIB'] >= heavy['LANE_MIN_AVAIL_GIB']
            and 1 <= heavy['BUILD_MAX_CONCURRENCY'] <= 3 and 15 <= heavy['LOAD_POLL_SECONDS'] <= 30
            and 1 <= heavy['MEM_GUARD_SUSTAIN'] <= 9):
        raise ValueError('invalid machine.conf threshold relations')
    return dict(heavy=heavy, devbox=values, local=local, unknown=sorted(unknown))

def atomic_json(file, value):
    temporary = None
    try:
        fd, temporary = tempfile.mkstemp(prefix='.' + os.path.basename(file) + '.', dir=os.path.dirname(file))
        with os.fdopen(fd, 'w') as stream:
            json.dump(value, stream, separators=(',', ':'), allow_nan=False)
            stream.write('\n')
        os.replace(temporary, file)
    finally:
        if temporary and os.path.exists(temporary): os.unlink(temporary)

def read_json(file, default):
    try: return json.loads(regular_config(file, maximum=1048576))
    except (OSError, ValueError): return default

def journal(root, event, resource, holder, detail):
    with open(os.path.join(root, 'log.tsv'), 'a') as stream:
        stream.write(datetime.datetime.now().strftime('%Y-%m-%d %H:%M') + '\t' + event + '\t' + resource + '\t' + holder + '\t' + detail + '\n')

def throttled(root, category, identity, event, resource, holder, detail):
    file = os.path.join(root, category + '.json')
    try:
        with open(file + '.lock', 'a') as guard:
            fcntl.flock(guard, fcntl.LOCK_EX)
            rates = read_json(file, {})
            if not isinstance(rates, dict): rates = {}
            current = time.time(); code = hashlib.sha256(identity.encode()).hexdigest()
            recent = rates.get(code, 0)
            if isinstance(recent, (int, float)) and 0 <= current - recent < 60: return False
            rates = {k: v for k, v in rates.items() if isinstance(v, (int, float)) and 0 <= current - v < 60}
            rates[code] = current
            # JSON state always ends with a newline so the same bounded reader applies.
            journal(root, event, resource, holder, detail) if event else None
            atomic_json(file, rates)
            return True
    except OSError: return True

def machine_config(root, warn=True):
    file = os.path.join(root, 'machine.conf'); saved = os.path.join(root, 'machine-last-good.json')
    try:
        try: content = regular_config(file); source = 'machine.conf'
        except FileNotFoundError:
            if os.path.lexists(file): raise ValueError('machine.conf is a dangling symlink')
            content = '\n'; source = 'defaults'
        result = parse_config(content)
        atomic_json(saved, dict(version=1, source=source, content='\n'.join(
            ['%s=%s' % (n, v) for n, v in {**result['heavy'], **result['devbox']}.items()
             if n != 'HEAD_OVERRIDE_BASE_LOAD' or v != 0] + ['%s=ignored' % n for n in result['unknown']]) + '\n'))
    except (OSError, ValueError) as error:
        cached = read_json(saved, None)
        if not isinstance(cached, dict) or cached.get('version') != 1 or not isinstance(cached.get('content'), str):
            raise ValueError('invalid machine.conf; no last-good thresholds: ' + str(error))
        result = parse_config(cached['content']); source = cached.get('source', 'machine.conf')
        result['fallback'] = True
        if throttled(root, 'config-invalid', 'config', 'config-invalid', 'machine.conf', '-', 'using last-good thresholds') and warn:
            print('res: warning: invalid machine.conf reload; keeping last-good thresholds and FIFO position', file=__import__('sys').stderr)
    result['source'] = source
    return result

def sampler_rows(file, current):
    """Read only a bounded tail; ignore columns after the five numeric memory fields."""
    try:
        with os.fdopen(os.open(file, os.O_RDONLY | os.O_NONBLOCK), 'rb') as stream:
            before = os.fstat(stream.fileno())
            if not stat.S_ISREG(before.st_mode) or not 0 <= current - before.st_mtime <= 60: return []
            offset = max(0, before.st_size - 32768)
            stream.seek(offset); data = stream.read(32769)
            after = os.fstat(stream.fileno())
        if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns): return []
        lines = data.decode().splitlines()
        if data and not data.endswith(b'\n'): lines = lines[:-1]
        if offset: lines = lines[1:]
        rows = []
        for line in lines:
            fields = line.split('\t')
            if len(fields) < 5: continue
            try:
                stamp = fields[0]
                if re.fullmatch(r'[0-9]+(?:\.[0-9]+)?', stamp): at = float(stamp)
                else:
                    if re.fullmatch(r'\d{2}:\d{2}:\d{2}(?:\.\d+)?', stamp):
                        stamp = datetime.datetime.fromtimestamp(current).strftime('%Y-%m-%dT') + stamp
                    at = datetime.datetime.fromisoformat(stamp.replace('Z', '+00:00')).timestamp()
                numbers = [float(value) for value in fields[1:5]]
                if not all(math.isfinite(v) and v >= 0 for v in [at] + numbers) or at > current: continue
                rows.append([at] + numbers)
            except (ValueError, OverflowError): continue
        # A sampler is fresh only when the data, as well as the file, is recent.
        rows.sort(reverse=True)
        if not rows or current - rows[0][0] > 60: return []
        spaced = []
        for row in rows:
            if not spaced or spaced[-1][0] - row[0] >= 10:
                spaced.append(row)
                if len(spaced) == 9: break
        return spaced
    except (OSError, ValueError): return []

def native_memory_readings():
    """Observer fast path: the same read-only Mach/sysctl counters as the two CLIs."""
    import ctypes
    lib = ctypes.CDLL('/usr/lib/libSystem.B.dylib', use_errno=True)
    lib.mach_host_self.restype = ctypes.c_uint
    lib.host_page_size.argtypes = [ctypes.c_uint, ctypes.POINTER(ctypes.c_uint)]
    lib.host_statistics64.argtypes = [ctypes.c_uint, ctypes.c_int, ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint)]
    lib.mach_port_deallocate.argtypes = [ctypes.c_uint, ctypes.c_uint]
    host = lib.mach_host_self(); page = ctypes.c_uint()
    values = (ctypes.c_uint * 256)(); count = ctypes.c_uint(256)
    try:
        if not host or lib.host_page_size(host, ctypes.byref(page)) or lib.host_statistics64(host, 4, values, ctypes.byref(count)):
            raise ValueError('native memory counters unavailable')
        # vm_statistics64 rev1 prefix: free/ inactive words 0/2, speculative 23,
        # occupied compressor pages 32. vm_stat excludes speculative from free.
        if count.value < 38 or not page.value or values[0] < values[23]:
            raise ValueError('invalid native memory counters')
        pages = ('Mach Virtual Memory Statistics: (page size of %d bytes)\n'
                 'Pages free: %d.\nPages inactive: %d.\nPages occupied by compressor: %d.\nPages stored in compressor: %d.\n') % (
                     page.value, values[0] - values[23], values[2], values[32], int(values[36]) | (int(values[37]) << 32))
    finally:
        if host: lib.mach_port_deallocate(ctypes.c_uint.in_dll(lib, 'mach_task_self_').value, host)
    lib.sysctlbyname.argtypes = [ctypes.c_char_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_size_t), ctypes.c_void_p, ctypes.c_size_t]
    swap = ctypes.create_string_buffer(32); size = ctypes.c_size_t(32)
    if lib.sysctlbyname(b'vm.swapusage', swap, ctypes.byref(size), None, 0) or size.value != 32:
        raise ValueError('native swap counter unavailable')
    used = int.from_bytes(swap.raw[16:24], __import__('sys').byteorder)
    return pages, 'used = %.8fK' % (used / 1024)

def memory_probe(root, config, platform=None, readings=None, prefer_native=False):
    heavy = config['heavy']
    state = dict(memory='UNKNOWN', guard='unavailable', compressor_gib=None, swap_used_gib=None,
                 swap_growth_gib=None, free_inactive_gib=None, swapfiles=None, samples=0,
                 compressor_high=0, swap_high=0, sample_source='single')
    if heavy['MEM_GUARD'] == 0:
        state.update(memory='DISABLED', guard='disabled'); return state
    live = os.path.realpath(os.path.expanduser('~/.claude/orchestrator/_shared'))
    if (os.environ.get('RES_TEST_MEMORY_GUARD') == '0' or os.environ.get('RES_TEST_METRICS') == '1' or os.environ.get('RES_TEST_SWAPFILE_DIR')) and os.path.realpath(root) == live:
        raise ValueError('test guard overrides require scratch state')
    try:
        if os.environ.get('RES_TEST_MEMORY_GUARD') == '0':
            state.update(memory='DISABLED', guard='test-disabled'); return state
        def output(args): return subprocess.check_output(args, stderr=subprocess.DEVNULL, timeout=2, env={**os.environ, 'LC_ALL': 'C'}).decode()
        platform = platform or (output(['uname', '-s']).strip() if os.environ.get('RES_TEST_SWAPFILE_DIR') else os.uname().sysname)
        if platform != 'Darwin':
            state.update(memory='UNSUPPORTED', guard='unsupported')
            raise ValueError('unsupported platform')
        if readings is None and prefer_native and os.environ.get('RES_TEST_METRICS') != '1' and not os.environ.get('RES_TEST_SWAPFILE_DIR'):
            try: readings = native_memory_readings()
            except (OSError, ValueError, AttributeError): pass  # CLI fallback preserves the no-op warning contract.
        if readings is None:
            if os.environ.get('RES_TEST_METRICS') == '1':
                if os.path.realpath(root) == live: raise ValueError('test metrics require scratch state')
                readings = (os.environ.get('RES_TEST_VM_STAT', ''), os.environ.get('RES_TEST_SWAPUSAGE', ''))
            else: readings = (output(['vm_stat']), output(['sysctl', '-n', 'vm.swapusage']))
        pages, swap = readings
        def page_count(label):
            found = re.search(r'^' + re.escape(label) + r':\s*([0-9]+)\.?\s*$', pages, re.M)
            if not found: raise ValueError('unreadable page metric')
            return int(found[1])
        size = re.search(r'page size of ([0-9]+) bytes', pages)
        used = re.search(r'\bused\s*=\s*([0-9]+(?:\.[0-9]+)?)([KMGT])\b', swap)
        if not size or int(size[1]) <= 0 or not used: raise ValueError('unreadable memory metrics')
        compressor = page_count('Pages occupied by compressor') * int(size[1]) / 2**30
        free = (page_count('Pages free') + page_count('Pages inactive')) * int(size[1]) / 2**30
        swap_used = float(used[1]) * 1024**('KMGT'.index(used[2]) + 1) / 2**30
        if not math.isfinite(compressor + free + swap_used): raise ValueError('invalid memory metrics')
        # Current macOS keeps swapfiles on the VM volume; /private/var/vm is the legacy location (empty today).
        swap_dir = next((d for d in ('/System/Volumes/VM', '/private/var/vm') if os.path.isdir(d)), '/private/var/vm')
        if os.environ.get('RES_TEST_SWAPFILE_DIR'):
            if os.path.realpath(root) == live: raise ValueError('test swap directory requires scratch state')
            swap_dir = os.environ['RES_TEST_SWAPFILE_DIR']
        with os.scandir(swap_dir) as entries:
            swapfiles = sum(bool(re.fullmatch(r'swapfile[0-9]+', entry.name)) for entry in entries)
        current = time.time(); growth = 0; window = heavy['MEM_GUARD_WINDOW_SEC']
        history_file = os.path.join(root, 'memory-samples.json')
        def recent_history():
            history = read_json(history_file, [])
            if not isinstance(history, list): return []
            return [v for v in history if isinstance(v, list) and len(v) == 2 and all(type(n) in (int, float) and math.isfinite(n) for n in v)
                    and 0 <= current - v[0] <= window and v[1] >= 0]
        history = recent_history()
        if history: growth = max(0, swap_used - min(v[1] for v in history))
        if not prefer_native:  # Observers read diagnostics without a cache write or wait.
            try:
                with open(history_file + '.lock', 'a') as guard:
                    fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    history = recent_history()
                    if history: growth = max(0, swap_used - min(v[1] for v in history))
                    buckets = {}; width = max(1, window / 127)
                    for value in history + [[current, swap_used]]:
                        bucket = int(value[0] / width)
                        if bucket not in buckets or value[1] < buckets[bucket][1]: buckets[bucket] = value
                    atomic_json(history_file, list(buckets.values())[-128:])
            except OSError:
                pass  # Optional diagnostics must not suppress sustained/current hard stops.
        file = datetime.datetime.fromtimestamp(current).strftime(os.path.expanduser(heavy['MEM_GUARD_SAMPLES']))
        samples = sampler_rows(file, current)
        if prefer_native:
            recent_swap = [row[3] for row in samples if 0 <= current - row[0] <= window]
            if recent_swap: growth = max(0, swap_used - min(recent_swap))
        compressor_high = sum(row[1] > heavy['MEM_GUARD_COMPRESSOR_GIB'] for row in samples)
        swap_high = sum(row[3] > heavy['MEM_GUARD_SWAP_GIB'] for row in samples)
        hard = swapfiles >= heavy['MEM_GUARD_SWAPFILES'] or free < 2
        high = hard or compressor_high >= heavy['MEM_GUARD_SUSTAIN'] or swap_high >= heavy['MEM_GUARD_SUSTAIN']
        state.update(memory='HIGH' if high else 'OK', guard='enabled', compressor_gib=compressor,
                     swap_used_gib=swap_used, swap_growth_gib=growth, free_inactive_gib=free, swapfiles=swapfiles,
                     samples=len(samples), compressor_high=compressor_high, swap_high=swap_high,
                     sample_source='external' if samples else 'single')
    except (OSError, ValueError, subprocess.SubprocessError):
        if throttled(root, 'memory-warning', 'probe', '', '', '', ''):
            print('res: warning: memory guard unavailable (%s); no memory-pressure denial' % state['guard'], file=__import__('sys').stderr)
    return state

def memory_line(state):
    value = lambda name: '?' if state[name] is None else '%.3f' % state[name]
    return 'memory=%s guard=%s compressor_gib=%s swap_used_gib=%s swap_growth_gib=%s free_inactive_gib=%s swapfiles=%s samples=%d sustained_compressor=%d sustained_swap=%d sample_source=%s' % (
        state['memory'], state['guard'], value('compressor_gib'), value('swap_used_gib'), value('swap_growth_gib'),
        value('free_inactive_gib'), state['swapfiles'] if state['swapfiles'] is not None else '?', state['samples'],
        state['compressor_high'], state['swap_high'], state['sample_source'])

def memory_denial(root, state, identity, resource, holder):
    if state['memory'] == 'HIGH':
        throttled(root, 'memory-denials', identity, 'gate-denied', resource, holder, 'reason=memory ' + memory_line(state))
