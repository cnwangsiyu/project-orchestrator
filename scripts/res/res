# Each attempt is an unwindable transaction, never a wait with a partial hold.
# Atomic mkdir still arbitrates against legacy take/wait callers. The private
# build-admission lock serializes slot selection; it is not a capacity hold.
acquire_attempt() {
  local mode="$1" candidate="$2" build_created=0 lane_created=0 build_id=
  local TAKE_CREATED=0 TAKE_TRANSACTION=1 TAKE_FRESH_ONLY=1 current_id= rc=0 CHECK_FRESH=1
  local BUILD_SLOT= BUILD_ACTIVE_COUNT= REQUEST_CHECKOUTS= BUILD_SLOT_INTERNAL=0 BUILD_GUARD=0 LOAD_OVERRIDE_ACTIVE=0
  local TRANSACTION_PENDING_SIGNAL=0 TRANSACTION_CLEANING=0 TRANSACTION_COMMITTED=0
  local cleanup_failed=0
  ACQUIRE_ROLLED_BACK=0
  # Keep retry metadata intact when rollback invokes the normal return parser.
  local BY="$BY" PROJECT="$PROJECT" PURPOSE="$PURPOSE" TASK="$TASK" UNTIL="$UNTIL"
  local NOTE="$NOTE" FORCE="$FORCE" OFFLINE="$OFFLINE" DEVICE="$DEVICE" POLICY="$POLICY"
  local PID="$PID" PID_EXPLICIT="$PID_EXPLICIT"
  rollback_attempt() {
    local status=0
    if [ "$TAKE_CREATED" -eq 1 ]; then
      if [ -n "$build_id" ] && [ "$current_id" = "$build_id" ]; then build_created=1; else lane_created=1; fi
      TAKE_CREATED=0
    fi
    if [ "$lane_created" -eq 1 ]; then
      [ "$mode" != pool ] || ACQUIRE_ROLLED_BACK=1
      if protected_rollback_created "$candidate" "$BY"; then lane_created=0
      else [ ! -d "$LOCKS/$candidate.d" ] && lane_created=0; status=1; fi
    fi
    if [ "$build_created" -eq 1 ]; then
      if { [ "$build_id" = heavy-build ] && protected_rollback_created heavy-build "$BY"; } || \
         { [ "$build_id" != heavy-build ] && protected_rollback_created "$build_id" "$BY"; }; then build_created=0
      else [ ! -d "$LOCKS/$build_id.d" ] && build_created=0; status=1; fi
    fi
    return "$status"
  }
  transaction_signal() {
    local code="$1"
    [ "$TRANSACTION_PENDING_SIGNAL" -ne 0 ] || TRANSACTION_PENDING_SIGNAL="$code"
    [ "$TRANSACTION_CLEANING" -eq 0 ] || return 0
    TRANSACTION_CLEANING=1
    rollback_attempt || cleanup_failed=1
    TRANSACTION_CLEANING=0
    build_guard_end
    cleanup_build_waiter
    trap - EXIT
    [ "$cleanup_failed" -eq 0 ] || exit 1
    exit "$TRANSACTION_PENDING_SIGNAL"
  }
  arm_transaction_signals() {
    trap 'transaction_signal 130' INT
    trap 'transaction_signal 143' TERM
    trap 'transaction_signal 129' HUP
  }
  unwind() {
    local status=$?
    if [ "$TRANSACTION_COMMITTED" -eq 1 ] && [ "$status" -eq 0 ]; then
      # transaction_signal remains armed until exit, so cancellation cannot
      # land after rollback protection has been removed.
      trap - EXIT
      exit 0
    fi
    TRANSACTION_CLEANING=1
    rollback_attempt || cleanup_failed=1
    TRANSACTION_CLEANING=0
    build_guard_end
    cleanup_build_waiter
    trap - EXIT
    [ "$cleanup_failed" -eq 0 ] || exit 1
    [ "$TRANSACTION_PENDING_SIGNAL" -eq 0 ] || exit "$TRANSACTION_PENDING_SIGNAL"
    exit "$status"
  }
  finish_attempt() {
    local status="$1"
    TRANSACTION_CLEANING=1
    rollback_attempt || cleanup_failed=1
    TRANSACTION_CLEANING=0
    build_guard_end
    trap - EXIT
    [ "$cleanup_failed" -eq 0 ] || exit 1
    [ "$TRANSACTION_PENDING_SIGNAL" -eq 0 ] || exit "$TRANSACTION_PENDING_SIGNAL"
    trap - INT TERM HUP
    arm_build_waiter_cleanup
    return "$status"
  }
  trap unwind EXIT
  arm_transaction_signals
  local options=(--by "$BY" --project "$PROJECT" --for "$PURPOSE" --task "$TASK" --until "$UNTIL" --pid "$PID")
  [ -z "$FORCE" ] || options+=(--force)
  if [ "$mode" = build ]; then
    if ! build_guard_start; then finish_attempt 2; return $?; fi
    if build_slot_select; then :
    else rc=$?; [ "$rc" -ne 2 ] || ATTEMPT_BLOCK_REASON=slot; finish_attempt "$rc"; return $?; fi
    if [ "$BUILD_ACTIVE_COUNT" -eq 0 ] && [ "${REQUEST_LOAD_OVERRIDE:-0}" = 1 ]; then LOAD_OVERRIDE_ACTIVE=1; fi
    build_id="$BUILD_SLOT"; current_id="$build_id"; TAKE_CREATED=0
    BUILD_SLOT_INTERNAL=1
    if [ "$build_id" = heavy-build ]; then
      if cmd_take heavy-build "${options[@]}"; then :
      else rc=$?; [ "$rc" -ne 2 ] || ATTEMPT_BLOCK_REASON=slot; finish_attempt "$rc"; return $?; fi
    else
      if cmd_take "$build_id" "${options[@]}"; then :
      else rc=$?; [ "$rc" -ne 2 ] || ATTEMPT_BLOCK_REASON=slot; finish_attempt "$rc"; return $?; fi
    fi
    build_created="$TAKE_CREATED"; TAKE_CREATED=0
    printf 'checkouts\t%s\nbuild_mode\t%s\npeak_concurrent\t%s\n' "$REQUEST_CHECKOUTS" \
      "$([ "$BUILD_ACTIVE_COUNT" -eq 0 ] && printf solo || printf concurrent)" "$((BUILD_ACTIVE_COUNT + 1))" >>"$LOCKS/$build_id.d/info"
  fi
  [ ! -d "$LOCKS/$candidate.d" ] || { finish_attempt 2; return $?; }
  current_id="$candidate"
  if cmd_take "$candidate" "${options[@]}"; then :
  else rc=$?; finish_attempt "$rc"; return $?; fi
  lane_created="$TAKE_CREATED"; TAKE_CREATED=0
  # The stable holder is validated after both locks are available, not while
  # waiting for a lane. Signals during this check still unwind the entire pair.
  if [ -n "$ACQUIRE_PID_EXPLICIT" ]; then
    if [ "$mode" = build ]; then check_holder_after_take "$build_id" "$candidate"
    else check_holder_after_take "$candidate"; fi
  fi
  if [ "$mode" = build ]; then build_mark_peak "$build_id"; fi
  if [ "$mode" = build ]; then printf 'build-lane=%s\n' "$candidate"
  elif [ "$mode" = pool ]; then printf 'slot=%s\n' "$candidate"
  else printf 'lane=%s\n' "$candidate"; fi
  TRANSACTION_COMMITTED=1
  if [ "$mode" = build ] && [ "${LOAD_OVERRIDE_ACTIVE:-0}" = 1 ]; then
    log load-override "$build_id" "$BY ($PROJECT${TASK:+/$TASK})" "FIFO head exceeded ${OVERRIDE_MINUTES_ACTIVE:-20} minutes; existing build/lane-3 gates retained"
  fi
  build_guard_end
  if [ "$mode" = pool ]; then finish_build_waiter acquire "slot=$candidate"
  elif [ "$mode" = build ]; then finish_build_waiter acquire "slot=$build_id lane=$candidate"
  else finish_build_waiter acquire "lane=$candidate"; fi
  trap - EXIT
  exit 0
}

cmd_acquire() {
  local mode="$1" blocking="$2"; shift 2
  if [ "${1:-}" = --help ]; then build_usage; return 0; fi
  local timeout=0 timeout_seen= pin= args=() ALLOW_PID=1 CHECKOUT=
  local duration deadline remaining delay=1 rc reading candidate missing3=0 ACQUIRE_PID_EXPLICIT can_attempt
  local BUILD_WAITER_DIR= BUILD_WAITER_STAGING= BUILD_WAITER_HOST= BUILD_WAITER_SINCE= BUILD_WAITER_START=
  local BUILD_WAITER_ORDER= BUILD_WAITER_GATE_STREAK=0 lane3_state=CLOSED block_reason LOAD_HEAD_SINCE=0
  local REQUEST_LOAD_OVERRIDE=0 ATTEMPT_BLOCK_REASON= ATTEMPT_POLL_SECONDS= ATTEMPT_OVERRIDE_MINUTES=
  local poll_seconds=15 override_minutes=20 OVERRIDE_MINUTES_ACTIVE=20
  local WAITER_ROOT="$WAITERS" WAITER_RESOURCE=heavy-build
  if [ "$mode" = lane ]; then WAITER_ROOT="$LANE_WAITERS"; WAITER_RESOURCE=heavy-lane-any; fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout)
        [ $# -ge 2 ] || die "--timeout needs minutes"
        [ -z "$timeout_seen" ] || die "duplicate --timeout"
        timeout="$2"; timeout_seen=1; shift 2 ;;
      --lane)
        [ "$mode" = build ] && [ $# -ge 2 ] || die "--lane is a build option and needs a value"
        [ -z "$pin" ] || die "duplicate --lane"
        pin="$2"; shift 2 ;;
      --checkout)
        [ "$mode" = build ] && [ $# -ge 2 ] || die "--checkout is a build option and needs a value"
        [ -z "$CHECKOUT" ] || die "duplicate --checkout"
        CHECKOUT="$2"; shift 2 ;;
      --by|--project|--for|--task|--until|--pid)
        [ $# -ge 2 ] || die "$1 needs a value"
        args+=("$1" "$2"); shift 2 ;;
      --force) args+=("$1"); shift ;;
      *) die "unknown option '$1'" ;;
    esac
  done
  [[ "$timeout" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "wait needs --timeout <non-negative minutes>"
  [ "$blocking" = 0 ] || [ -n "$timeout_seen" ] || die "wait needs --timeout <non-negative minutes>"
  [ "$blocking" = 1 ] || [ -z "$timeout_seen" ] || die "take-build does not accept --timeout; use wait-build"
  [ -z "$pin" ] || [[ "$pin" =~ ^heavy-lane-[123]$ ]] || die "--lane must be heavy-lane-1, 2 or 3"
  parse ${args[@]+"${args[@]}"}; validate_pid
  ACQUIRE_PID_EXPLICIT="$PID_EXPLICIT"
  [ -n "$BY" ] && [ -n "$PROJECT" ] && [ -n "$PURPOSE" ] || die "acquisition needs --by, --project and --for"
  [ "$mode" != build ] || need_id heavy-build
  [ -z "$pin" ] || need_id "$pin"
  if [ "$mode" = lane ]; then
    for candidate in heavy-lane-1 heavy-lane-2 heavy-lane-3; do
      if [ "$(field "$candidate" by)" = "$BY" ] && [ "$(field "$candidate" pid)" = "$PID" ]; then
        printf 'lane=%s\n' "$candidate"
        return 0
      fi
    done
  fi
  duration=$(awk -v t="$timeout" 'BEGIN {s=t*60; printf "%.0f\n", int(s)+(s>int(s))}')
  deadline=$((SECONDS + duration))
  if [ "$blocking" = 1 ]; then
    start_build_waiter
    arm_build_waiter_cleanup
  fi
  while :; do
    rc=0; can_attempt=1; REQUEST_LOAD_OVERRIDE=0; ATTEMPT_BLOCK_REASON=; ATTEMPT_POLL_SECONDS=; ATTEMPT_OVERRIDE_MINUTES=
    # Refresh (or re-publish) before heavy-check, which can be slow under load.
    [ "$blocking" = 0 ] || update_build_waiter "${block_reason:-starting}" "${lane3_state:-CLOSED}"
    if [ "$blocking" = 1 ] && [ "$mode" = build ] && ! waiter_is_current "$(oldest_live_waiter "$WAITERS")"; then
      can_attempt=0; rc=2; block_reason=FIFO; update_load_head FIFO; update_build_waiter FIFO "$lane3_state"
    fi
    if [ "$can_attempt" = 1 ]; then
      if [ "$mode" = lane ]; then
        reading=$(cmd_heavy_check --pid "$PID" --admission lane) || rc=$?
      else
        reading=$(cmd_heavy_check --pid "$PID") || rc=$?
      fi
    fi
    if [ "$can_attempt" = 1 ] && [ "$rc" -eq 0 ]; then
      printf '%s\n' "$reading"
      lane3_state=CLOSED; lane3_open "$reading" && lane3_state=OPEN
      BUILD_WAITER_GATE_STREAK=0
      update_build_waiter lane "$lane3_state"
      if [ "$mode" = build ] && [ "$blocking" = 1 ]; then
        for candidate in heavy-build heavy-build-2 heavy-build-3; do reclaim_stale_heavy "$candidate" "$BY" || true; done
      fi
      if [ "$mode" = build ] && [ "$blocking" = 1 ] && head_load_override "$override_minutes"; then
        REQUEST_LOAD_OVERRIDE=1; OVERRIDE_MINUTES_ACTIVE="$override_minutes"
      fi
      if [ "$mode" = build ] && [ "$pin" != heavy-lane-3 ]; then
        local lane_args=(--pid "$PID" --admission lane)
        [ "$REQUEST_LOAD_OVERRIDE" != 1 ] || lane_args+=(--load-override)
        if reading=$(cmd_heavy_check "${lane_args[@]}"); then
          printf '%s\n' "$reading"
        else
          rc=$?; [ -z "$reading" ] || printf '%s\n' "$reading"
          ATTEMPT_BLOCK_REASON=$(reading_field "$reading" blocked)
          ATTEMPT_POLL_SECONDS=$(reading_field "$reading" poll_seconds)
          ATTEMPT_OVERRIDE_MINUTES=$(reading_field "$reading" override_minutes)
        fi
      fi
      if [ "$rc" -eq 0 ]; then for candidate in ${pin:-heavy-lane-1 heavy-lane-2 heavy-lane-3}; do
        if [ -z "$(reg_line "$candidate")" ]; then
          if [ "$candidate" = heavy-lane-3 ]; then
            if [ "$missing3" -eq 0 ]; then echo 'res: lane 3 is not registered; continuing bounded waits on lanes 1/2' >&2; fi
            missing3=1; continue
          fi
          die "unknown resource '$candidate' (see: res status)"
        fi
        [ "$candidate" != heavy-lane-3 ] || lane3_open "$reading" || continue
        if [ "$blocking" = 1 ]; then reclaim_stale_heavy "$candidate" "$BY" || true; fi
        [ ! -d "$LOCKS/$candidate.d" ] || continue
        if acquire_attempt "$mode" "$candidate"; then return 0; else rc=$?; fi
        [ "$rc" -eq 2 ] || [ "$rc" -eq 5 ] || return "$rc"
        if [ "$rc" -eq 5 ]; then break; fi
        if [ "$mode" = build ] && [ "${ATTEMPT_BLOCK_REASON:-}" = slot ]; then break; fi
      done; fi
      if [ "$rc" -eq 5 ]; then
        block_reason="${ATTEMPT_BLOCK_REASON:-load}"
        case "$ATTEMPT_POLL_SECONDS" in ''|*[!0-9]*) ;; *) poll_seconds="$ATTEMPT_POLL_SECONDS" ;; esac
        case "$ATTEMPT_OVERRIDE_MINUTES" in ''|*[!0-9.]*) ;; *) override_minutes="$ATTEMPT_OVERRIDE_MINUTES" ;; esac
        BUILD_WAITER_GATE_STREAK=$((BUILD_WAITER_GATE_STREAK + 1))
        if [ "$mode" = build ] && [ "$block_reason" = load ]; then update_load_head load
        else update_load_head "$block_reason"; fi
        update_build_waiter "$block_reason" "$lane3_state"
        [ "$block_reason" != load ] || delay="$poll_seconds"
      else
        rc=2; block_reason=lane
        if [ "$mode" = build ]; then
          for candidate in heavy-build heavy-build-2 heavy-build-3; do
            if [ -d "$LOCKS/$candidate.d" ]; then block_reason=slot; break; fi
          done
        fi
        update_load_head "$block_reason"
        update_build_waiter "$block_reason" "$lane3_state"
      fi
    elif [ "$can_attempt" = 1 ]; then
      [ -z "$reading" ] || printf '%s\n' "$reading"
      [ "$rc" -eq 5 ] || return "$rc"
      if [ "$mode" = lane ]; then
        poll_seconds=$(reading_field "$reading" poll_seconds)
      fi
      BUILD_WAITER_GATE_STREAK=$((BUILD_WAITER_GATE_STREAK + 1))
      block_reason="${ATTEMPT_BLOCK_REASON:-$([ "$mode" = build ] && printf gate || printf load)}"
      if [ "$mode" = build ] && [ "$block_reason" = load ]; then update_load_head load
      else update_load_head "$block_reason"; fi
      update_build_waiter "$block_reason" "$lane3_state"
      [ "$block_reason" != load ] || delay="$poll_seconds"
    fi
    if [ "$blocking" = 0 ]; then return "$rc"; fi
    remaining=$((deadline - SECONDS))
    if [ "$remaining" -le 0 ]; then
      finish_build_waiter timeout "after $timeout minutes"
      echo "res: timed out waiting for '$mode' after $timeout minutes" >&2; return 2
    fi
    [ "$delay" -le "$remaining" ] || delay="$remaining"
    echo "res: waiting for '$mode'; retry in ${delay}s" >&2
    sleep "$delay"
    delay=$((delay * 2)); [ "$delay" -le 15 ] || delay=15
  done
}

cmd_wait_pool_legacy() {
  if [ "${1:-}" = --help ]; then usage; return 0; fi
  local pool="${1:-}"; shift || true
  pool="${pool%-}"
  [[ "$pool" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "wait-pool needs a resource prefix (for example devbox-cn)"
  local timeout= timeout_seen= args=() ALLOW_PID=1 pin= ACQUIRE_PID_EXPLICIT prefer_host= prefer_slot= POOL_NEED= excluded_slots= excluded_hosts= POOL_ACQUIRE=1
  local duration deadline remaining delay=1 candidate rc ids rollbacks ACQUIRE_ROLLED_BACK=0
  local BUILD_WAITER_DIR= BUILD_WAITER_STAGING= BUILD_WAITER_HOST= BUILD_WAITER_SINCE= BUILD_WAITER_START=
  local BUILD_WAITER_ORDER= BUILD_WAITER_GATE_STREAK=0
  local WAITER_ROOT="$POOL_WAITERS/$pool" WAITER_RESOURCE="$pool-any"
  case "$pool" in *-light) WAITER_RESOURCE="$pool" ;; esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --prefer-host)
        [ $# -ge 2 ] && [ -n "$2" ] || die "--prefer-host needs a host"
        [ -z "$prefer_host" ] || die "duplicate --prefer-host"
        prefer_host="$2"; shift 2 ;;
      --prefer-slot)
        [ $# -ge 2 ] && [ -n "$2" ] || die "--prefer-slot needs a slot ID"
        [ -z "$prefer_slot" ] || die "duplicate --prefer-slot"
        prefer_slot="$2"; shift 2 ;;
      --exclude-slot|--exclude-host)
        [ $# -ge 2 ] && [[ "$2" =~ ^[A-Za-z0-9_.-]+(,[A-Za-z0-9_.-]+)*$ ]] || die "$1 needs comma-separated IDs"
        if [ "$1" = --exclude-slot ]; then excluded_slots="${excluded_slots:+$excluded_slots,}$2"
        else excluded_hosts="${excluded_hosts:+$excluded_hosts,}$2"; fi
        shift 2 ;;
      --need)
        [ $# -ge 2 ] && [[ "$2" =~ ^[A-Za-z0-9_.-]+(,[A-Za-z0-9_.-]+)*$ ]] || die "--need needs comma-separated capability names"
        [ -z "$POOL_NEED" ] || die "duplicate --need"
        POOL_NEED="$2"; shift 2 ;;
      --timeout)
        [ $# -ge 2 ] || die "--timeout needs minutes"
        [ -z "$timeout_seen" ] || die "duplicate --timeout"
        timeout="$2"; timeout_seen=1; shift 2 ;;
      --by|--project|--for|--task|--until|--pid)
        [ $# -ge 2 ] || die "$1 needs a value"
        args+=("$1" "$2"); shift 2 ;;
      --force) args+=("$1"); shift ;;
      *) die "unknown option '$1'" ;;
    esac
  done
  [[ "$timeout" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "wait-pool needs --timeout <non-negative minutes>"
  parse ${args[@]+"${args[@]}"}; validate_pid
  ACQUIRE_PID_EXPLICIT="$PID_EXPLICIT"
  [ -n "$BY" ] && [ -n "$PROJECT" ] && [ -n "$PURPOSE" ] || die "wait-pool needs --by, --project and --for"
  ids=$(box_health members "$pool" "$prefer_host" "$prefer_slot" "$POOL_NEED" "$excluded_slots" "$excluded_hosts") || return $?
  for candidate in $ids; do
    if [ "$(field "$candidate" by)" = "$BY" ] && [ "$(field "$candidate" pid)" = "$PID" ] && \
      [ "$(field "$candidate" host)" = "$(local_host)" ]; then
      printf 'slot=%s\n' "$candidate"; return 0
    fi
  done
  duration=$(awk -v t="$timeout" 'BEGIN {s=t*60; printf "%.0f\n", int(s)+(s>int(s))}')
  deadline=$((SECONDS + duration))
  start_build_waiter
  while :; do
    update_build_waiter slot CLOSED
    if [ "$BUILD_WAITER_DIR" = "$(oldest_build_waiter "$WAITER_ROOT")" ]; then
      # Refresh membership on every retry, including newly registered capacity.
      ids=$(box_health select "$pool" "$prefer_host" "$prefer_slot" "$POOL_NEED" "$excluded_slots" "$excluded_hosts") || { rc=$?; cleanup_build_waiter; return "$rc"; }
      rollbacks=0
      for candidate in $ids; do
        [ ! -d "$LOCKS/$candidate.d" ] || continue
        # A member retired (policy never/ask-user) after membership was read is skipped, not fatal.
        [ "$(reg_line "$candidate" | cut -f3)" = open ] || continue
        update_build_waiter slot CLOSED
        if acquire_attempt pool "$candidate"; then return 0; else rc=$?; fi
        if [ "$rc" -ne 2 ] && [ "$rc" -ne 3 ]; then cleanup_build_waiter; return "$rc"; fi
        if [ "$ACQUIRE_ROLLED_BACK" -eq 1 ]; then
          rollbacks=$((rollbacks + 1))
          if [ "$rollbacks" -gt 2 ]; then
            # Keep the original wait episode, but give already queued callers the head.
            BUILD_WAITER_ORDER=$(next_waiter_order)
            update_build_waiter rollback CLOSED
            log waiter-yield "$WAITER_RESOURCE" "$BY ($PROJECT${TASK:+/$TASK})" "rollbacks=$rollbacks"
            echo "res: yielding pool '$pool' (FIFO) after $rollbacks candidate rollbacks" >&2
            break
          fi
        fi
        [ "$SECONDS" -lt "$deadline" ] || break
      done
    else
      update_build_waiter FIFO CLOSED
    fi
    remaining=$((deadline - SECONDS))
    if [ "$remaining" -le 0 ]; then
      finish_build_waiter timeout "after $timeout minutes"
      echo "res: timed out waiting for pool '$pool' after $timeout minutes" >&2; return 2
    fi
    [ "$delay" -le "$remaining" ] || delay="$remaining"
    echo "res: waiting for pool '$pool' (FIFO); retry in ${delay}s" >&2
    sleep "$delay"
    delay=$((delay * 2)); [ "$delay" -le 15 ] || delay=15
  done
}

pool_controller() {
  local runner=
  if [ "${POOL_EXEC_CHILD:-0}" = 1 ]; then runner=exec; fi
  ${runner:+$runner} python3 - "$RES_DIR" "$@" "$BY" "$PROJECT" "$TASK" "$PURPOSE" "$PID" "$UNTIL" "${FORCE:-}" "${POOL_NEED:-}" "${prefer_host:-}" "${prefer_slot:-}" "${excluded_slots:-}" "${excluded_hosts:-}" "${WAITER_STALE_SECONDS}" "$$" "${POOL_EPISODE:-none}" <<'PY'
