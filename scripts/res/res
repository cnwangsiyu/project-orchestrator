        except FileNotFoundError: pass
        values = capacity({member[1] for id, member in remote.items() if slot_type(id)})
        active = {box for box in hosts if any(member[0] == 'open' and member[1] == box and slot_type(id) for id, member in remote.items())}
        total_cores = sum(values[box]['cores'] or 0 for box in active)
        total_takes = sum(counts.get(id, 0) for id in remote if slot_type(id))
        shown = {}
        for box, value in sorted(values.items()):
