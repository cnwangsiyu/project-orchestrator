    local memory_reading
    memory_reading=$(RES_MEMORY_ID="${WAIT_CONFIG_FILE:-$BY:$PID}" RES_MEMORY_RESOURCE="$id" RES_MEMORY_HOLDER="$BY" python3 -c "$RES_MACHINE_SOURCE
import sys
try:
    config = machine_config(sys.argv[1]); state = memory_probe(sys.argv[1], config)
    print(memory_line(state))
    memory_denial(sys.argv[1], state, os.environ['RES_MEMORY_ID'], os.environ['RES_MEMORY_RESOURCE'], os.environ['RES_MEMORY_HOLDER'])
except (OSError, ValueError) as error:
    print('res: ' + str(error), file=sys.stderr); sys.exit(1)
" "$RES_DIR") || return $?
    if [[ "$memory_reading" == *memory=HIGH* ]]; then
      printf '%s\n' "$memory_reading"
      return 5
    fi
  fi
  if [[ "$id" =~ ^heavy-lane-[123]$ ]] || { [[ "$id" =~ ^heavy-build(-[23])?$ ]] && [ "${BUILD_SLOT_INTERNAL:-0}" = 1 ]; }; then
    local reading rc=0 admission=legacy check_args=(--memory-details --pid "$PID")
    case "$id" in
      heavy-lane-1|heavy-lane-2)
        admission=lane; check_args+=(--admission lane)
        [ "${LOAD_OVERRIDE_ACTIVE:-0}" != 1 ] || check_args+=(--load-override) ;;
      heavy-build|heavy-build-2|heavy-build-3)
        if [ "${BUILD_ACTIVE_COUNT:-0}" -eq 0 ]; then admission=build
        else admission=build-concurrent; fi
        check_args+=(--admission "$admission")
        [ "${LOAD_OVERRIDE_ACTIVE:-0}" != 1 ] || check_args+=(--load-override) ;;
    esac
    reading=$(cmd_heavy_check "${check_args[@]}") || rc=$?
    [ -z "$reading" ] || print_gate_reading "$reading"
    ATTEMPT_BLOCK_REASON=$(reading_field "$reading" blocked)
    ATTEMPT_POLL_SECONDS=$(reading_field "$reading" poll_seconds)
    ATTEMPT_OVERRIDE_MINUTES=$(reading_field "$reading" override_minutes)
    [ "$rc" -eq 0 ] || return "$rc"
    if [ "$id" = heavy-lane-3 ] && ! lane3_open "$reading"; then
      echo "res: heavy-lane-3 unavailable (see active LANE3_LOAD and LANE3_AVAIL_GIB thresholds above)" >&2
      ATTEMPT_BLOCK_REASON=load
      return 5
    fi
  fi
  if [ "$dev" != - ] && [ -z "$OFFLINE" ] && [ "$(field "$id" by)" != "$BY" ]; then
    probe quick; link=$(conn "$dev")
    [ "$link" = connected ] || { DEVS=; probe; link=$(conn "$dev"); }
    [ "$link" = connected ] || { echo "res: '$id' is not connected ($link) — ask the user to plug in / unlock / trust it; --offline holds it anyway" >&2; exit 4; }
  fi
  local device_evidence=$'adb_device_lines\tunknown\ndevice_clients\tunknown'
  local device_log= device_pid_dead=0 device_probe_rc=0
  if [ "$dev" != - ] && [ ! -d "$LOCKS/$id.d" ]; then
    # Finish both bounded probes before creating a lease. A hung probe can
    # produce unknown evidence, but cannot strand half-published ownership.
    device_evidence=$(device_clients 2>/dev/null) || device_probe_rc=$?
    case "$device_probe_rc" in
      0) ;;
      10) device_pid_dead=1 ;;
      *) device_evidence=$'adb_device_lines\tunknown\ndevice_clients\tunknown' ;;
    esac
  fi
  mkdir -p "$LOCKS"
  if take_mkdir "$LOCKS/$id.d"; then
    TAKE_CREATED=1
    write_info "$(now)" "$id" || return $?
    # Recheck the health snapshot after mkdir; a losing pool transaction unwinds.
    if [ "${POOL_ACQUIRE:-0}" = 1 ]; then
      box_health check "$id" "$POOL_NEED" "$excluded_slots" "$excluded_hosts" || return $?
      # A slow health read may expire/delete our heartbeat. Restore it before
      # the FIFO recheck, or a fresh hold is spuriously returned to younger waiters.
      update_build_waiter slot CLOSED
    fi
    local RESERVED_MESSAGE=
    if lane_reserved_for_waiter "$id"; then
      RESERVED_MESSAGE="reserved for waiting build $RESERVED_WAITER_HOLDER; retry or use wait-lane"
    elif lane_waiter_blocks "$id"; then :
    elif pool_waiter_blocks "$id"; then :; fi
    if [ -n "$RESERVED_MESSAGE" ]; then
      echo "res: '$id': $RESERVED_MESSAGE" >&2
      if [ "${TAKE_TRANSACTION:-0}" = 1 ]; then
        return 2
      fi
      protected_rollback_created "$id" "$BY" || die "failed to yield '$id' to waiter"
      TAKE_CREATED=0
      return 2
    fi
    if [ -n "$PID_EXPLICIT" ]; then
      if { [ "$dev" != - ] && [ "$device_pid_dead" = 1 ]; } || { [ "$dev" = - ] && pid_dead "$PID"; }; then
        warn_holder; mark_holder_warning "$id"
      fi
    fi
    if [ "$dev" != - ]; then
      printf '%s\n' "$device_evidence" >>"$LOCKS/$id.d/info" || true
      device_log=" · $(printf '%s\n' "$device_evidence" | awk -F'\t' '{printf "%s%s=%s", (NR>1 ? " " : ""), $1, $2}')" || device_log=' · device_clients=unknown'
    fi
    log take "$id" "$BY ($PROJECT${TASK:+/$TASK})" "$PURPOSE${UNTIL:+ · until $UNTIL}$device_log"
    echo "took $id"; show_notes "$id"
  # A concurrent same-name wrapper may win after the transaction's precheck.
  # Single-resource take/wait may reuse a hold; build/lane acquisition must own mkdir.
  elif [ "${TAKE_FRESH_ONLY:-0}" != 1 ] && [ "$(field "$id" by)" = "$BY" ]; then
    echo "already held: $id by $(holder_details "$id")"; show_notes "$id"
  else
    echo "res: '$id' is held by $(holder_details "$id") ($(field "$id" project)), until $(field "$id" until | sed 's/^$/?/') — $(field "$id" for)" >&2
    echo "res: message that session (SendMessage; for a codex:<thread> holder, its project's orchestrator) and wait; do not use the resource meanwhile" >&2
    return 2
  fi
}

cmd_extend() {
  local id="${1:-}"; shift || true; need_id "$id"; parse "$@"
  [ -n "$BY" ] && [ -n "$UNTIL" ] || die "extend needs --by and --until"
  [ -d "$LOCKS/$id.d" ] || die "'$id' is not held"
  [ "$(field "$id" by)" = "$BY" ] || die "'$id' is held by $(field "$id" by), not $BY"
  local info="$LOCKS/$id.d/info" tmp; tmp=$(mktemp)
  awk -F'\t' -v u="$UNTIL" 'BEGIN{OFS="\t"} $1=="until"{$2=u} {print}' "$info" >"$tmp" && mv "$tmp" "$info"
  log extend "$id" "$BY" "until $UNTIL"
  echo "extended $id until $UNTIL"
}

cmd_return() {
  local id="${1:-}"; shift || true
  registry_record "$id" || die "unknown resource '$id'"
  parse "$@"
  [ -n "$BY" ] || die "return needs --by"
  if [ "$REG_KIND" = remote ] && [ "$REG_DEVICE" = - ]; then
    local PURPOSE="$NOTE" POOL_NEED= prefer_host= prefer_slot= excluded_slots= excluded_hosts=
    pool_controller return "$id" 0 0
    return $?
  fi
  [ -d "$LOCKS/$id.d" ] || { echo "$id was not held"; return 0; }
  local holder owned_guard=0 build_detail= start peak duration mode; holder=$(field "$id" by)
  # Reject an unauthorized return before taking the private build guard. A
  # fatal ownership diagnostic has no transaction cleanup handler here.
  if [ "$holder" != "$BY" ]; then
    [ -n "$FORCE" ] && [ -n "$NOTE" ] || die "'$id' is held by $holder; only --force --note \"<why>\" may reclaim it"
  fi
  case "$id" in heavy-build|heavy-build-2|heavy-build-3)
    if [ "${BUILD_GUARD:-0}" != 1 ]; then
      build_guard_start || { echo "res: build admission is changing; retry return-build" >&2; return 2; }
      owned_guard=1
    fi ;;
  esac
  if [ "$holder" != "$BY" ]; then
    [ -n "$FORCE" ] && [ -n "$NOTE" ] || die "'$id' is held by $holder; only --force --note \"<why>\" may reclaim it"
    log reclaim "$id" "$BY" "from $holder: $NOTE"
  else
    if [[ "$id" =~ ^heavy-build(-[23])?$ ]] && [ "$(field "$id" build_committed)" = 1 ]; then
      start=$(field "$id" start); peak=$(field "$id" peak_concurrent)
      case "$start" in ''|*[!0-9]*) start=0 ;; esac
      case "$peak" in ''|*[!0-9]*) peak=1 ;; esac
      duration=$(( $(date +%s) - start )); [ "$duration" -ge 0 ] || duration=0
      mode=solo; [ "$peak" -le 1 ] || mode=concurrent
      build_detail="build_mode=$mode peak_concurrent=$peak duration_seconds=$duration"
    fi
    log return "$id" "$BY" "$NOTE${build_detail:+${NOTE:+ · }$build_detail}"
  fi
  rm -rf "$LOCKS/$id.d"
  [ "$owned_guard" -eq 0 ] || build_guard_end
  echo "returned $id"
}

show_notes() {
  if [ -s "$NOTES/$1.md" ]; then
    echo; echo "── notes for $1 ($NOTES/$1.md) — read before use ──"; cat "$NOTES/$1.md"
  fi
  case "$1" in
    heavy-*)
      if [ "$1" != heavy-build ] && [ -s "$NOTES/heavy-build.md" ]; then
        echo; echo "── heavy-task protocol ($NOTES/heavy-build.md) — read before use ──"; cat "$NOTES/heavy-build.md"
      fi ;;
  esac
}

cmd_note() {
  local id="${1:-}"; shift || true; need_id "$id"; parse "$@"
  [ -n "$BY" ] && [ -n "$NOTE" ] || die "note needs --by and --note"
  mkdir -p "$NOTES"
  [ -f "$NOTES/$id.md" ] || printf '# %s\n\n' "$(reg_line "$id" | cut -f5)" >"$NOTES/$id.md"
  printf -- '- %s (%s): %s\n' "$(date '+%Y-%m-%d')" "$BY" "$NOTE" >>"$NOTES/$id.md"
  log note "$id" "$BY" "$NOTE"
  echo "noted on $id"
}

cmd_log() { [ -f "$LOG" ] && tail -n "${1:-20}" "$LOG" || true; }

case "${1:-}" in
  status) shift; cmd_status "$@"; if [ -f "$RES_DIR/mini2-config.json" ]; then mini2_controller status; fi ;;
  holder) shift; cmd_holder "$@" ;;
  take) shift; cmd_take "$@" ;;
  wait) shift; cmd_wait "$@" ;;
  take-build)
    shift
    if [ "${1:-}" = --wait ]; then shift; cmd_acquire build 1 "$@"
    else cmd_acquire build 0 "$@"; fi ;;
  wait-build) shift; cmd_acquire build 1 "$@" ;;
  wait-lane) shift; cmd_acquire lane 1 "$@" ;;
  wait-pool)
    shift
    cmd_wait_pool "$@"
    # Bash can read more source after a long wait if the executable was overwritten.
    exit 0 ;;
  pool-capacity)
    request="${2:-}"; shift 2
    ALLOW_PID=1 parse "$@"
    pool_report pool-capacity "$request" ;;
  devbox-registry)
    shift
    [ "$#" -eq 0 ] || die 'devbox-registry accepts no id'
    registry_json=$(pool_report devbox-registry '') || exit $?
    if [ -f "$RES_DIR/mini2-config.json" ] && [ -n "$(reg_line mini2-exec-1)" ]; then
      mini2_json=$(mini2_controller devbox-registry) || exit $?
      registry_json=$(printf '%s' "$registry_json" | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin)+json.loads(sys.argv[1])))' "$mini2_json")
    fi
    if local_controller enabled; then
      local_json=$(local_controller devbox-registry) || exit $?
      registry_json=$(printf '%s' "$registry_json" | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin)+json.loads(sys.argv[1])))' "$local_json")
    fi
    printf '%s\n' "$registry_json" ;;
  slot-host|reserved-disk)
    action="$1"; shift
    [ "$#" -le 1 ] || die "$action accepts at most one id"
    pool_report "$action" "${1:-}" ;;
  box-health)
    shift
    [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = --json ]; } || die 'box-health accepts only --json'
    pool_report box-health "${1:-}" ;;
  audit)
    shift
    [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = --json ]; } || die 'audit accepts only --json'
    if [ "${1:-}" = --json ] && [ -f "$RES_DIR/mini2-config.json" ]; then
      pool_report audit --json | python3 -c 'import json,sys; value=json.load(sys.stdin); value["mini2"]=json.loads(sys.argv[1]); print(json.dumps(value,indent=2))' "$(mini2_controller status --json)"
    else
      pool_report audit "${1:-}"
      if [ -f "$RES_DIR/mini2-config.json" ]; then mini2_controller status; fi
    fi ;;
  release-dead|retain-remote)
    action="$1"
    id="${2:-}"; shift 2
    ALLOW_PID=1 parse "$@"; validate_pid
    pool_controller "$action" "$id" 0 0 ;;
  quarantine|unquarantine|report-infra) box_health "$@" ;;
  return-build) shift; cmd_return_build "$@" ;;
  check-config) shift; cmd_check_config "$@" ;;
  heavy-check) shift; cmd_heavy_check "$@" ;;
  extend) shift; cmd_extend "$@" ;;
  return) shift; cmd_return "$@" ;;
  add) shift; cmd_add "$@" ;;
  note) shift; cmd_note "$@" ;;
  log) shift; cmd_log "$@" ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 1 ;;
esac
