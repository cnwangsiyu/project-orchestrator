res report-infra <slot> --kind ssh|disk|upload
                                      3 failures/30 min quarantine for 20 min; next failure repeats
res check-config [FILE]               validate candidate machine.conf without changing state
res heavy-check [--pid <pid>]         print lane-aware load limit and available memory; 5 if overloaded
res extend <id> --by <session> --until <when>
res return <id> --by <session> [--note "<text>"]
res return <id> --by <session> --force --note "<why>"   reclaim a hold whose holder is gone
res add <id> --device <udid|serial|-> --for "<description>" [--policy open|ask-user|never]
                                      register a resource (default policy ask-user: the user
                                      decides whether a newly plugged-in device may be shared)
res note <id> --by <session> --note "<pitfall and workaround>"
                                      append a dated pitfall to notes/<id>.md (shown on every take)
res log [<n>]                         last n history lines (default 20)
Devices show their live link (usbmux / devicectl / adb). take refuses a device that is not connected
unless --offline (booking ahead of a plug-in).
Exit codes: 0 ok, 2 held/wait timeout, 3 policy forbids, 4 device not connected,
5 heavy gate overloaded, 1 usage/other error (including unavailable gate metrics).
status/holder: 0 answered (including PENDING/unknown link), 1 real state/usage error;
never 2 for transient contention. Lease guards should use holder and retry a failed read.
EOF
}

die() { echo "res: $*" >&2; exit 1; }
now() { date '+%Y-%m-%d %H:%M'; }

local_host() { printf '%s\n' "$HOSTNAME"; }

# Legacy holds and other hosts cannot be judged safely from this machine's PID table.
hold_pid_stale() {
  local pid host
  pid=$(field "$1" pid); host=$(field "$1" host)
  case "$pid" in ''|*[!0-9]*|0) return 1 ;; esac
  [ "$host" = "$(local_host)" ] || return 1
  if ps -p "$pid" -o pid= >/dev/null 2>&1; then
    return 1
  else
    [ "$?" -eq 1 ]
  fi
}

# A dead wrapper does not establish that its orphaned build has exited.
hold_stale() {
  hold_pid_stale "$1" || return 1
  case "$1" in heavy-*) python3 -c "$RES_BUILD_PROCESS_SOURCE" "$LOCKS/$1.d/info" >/dev/null ;; *) return 0 ;; esac
}

hold_old() {
  local start current
  start=$(field "$1" start)
  case "$start" in ''|*[!0-9]*) return 1 ;; esac
  current=$(date +%s)
  # awk avoids interpreting epoch strings with leading zeroes as shell octal.
  awk -v start="$start" -v current="$current" 'BEGIN { exit !(current - start > 600) }'
}

# Count other holders conservatively: incomplete/legacy/remote holds still use
# a lane unless the existing local-PID liveness check proves them STALE.
heavy_lanes_held() {
  local caller_pid="$1" lock id held=0
  for lock in "$LOCKS"/heavy-lane-*.d; do
    [ -d "$lock" ] || continue
    id="${lock##*/}"; id="${id%.d}"
    [ "$(field "$id" pid)" != "$caller_pid" ] || continue
    hold_stale "$id" && continue
    held=$((held + 1))
  done
  printf '%s\n' "$held"
}

# Configuration is data, never shell code. Unknown well-formed keys are ignored;
# Configuration is validated by the same module as observers and remote controllers.
machine_thresholds() {
  local snapshot name value previous= warned= next known
  if [ -n "${WAIT_CONFIG_FILE:-}" ] && [ -f "$WAIT_CONFIG_FILE" ]; then
    previous=$(cat "$WAIT_CONFIG_FILE")
    warned=$(printf '%s\n' "$previous" | awk -F'\t' '$1=="UNKNOWN_KEYS_WARNED" {print $2}')
  fi
  snapshot=$(python3 -c "$RES_MACHINE_SOURCE
import sys
try:
    config = machine_config(sys.argv[1])
    for name, value in config['heavy'].items(): print(name, value, sep='\t')
    print('THRESHOLDS_SOURCE', config['source'], sep='\t')
    print('UNKNOWN_KEYS', ','.join(config['unknown']), sep='\t')
except (OSError, ValueError) as error:
    print('res: ' + str(error), file=sys.stderr); sys.exit(1)
" "$RES_DIR") || return $?
  while IFS=$'\t' read -r name value; do
    case "$name" in
      LOAD_LIMIT|LOAD_LIMIT_WITH_LANES|MIN_AVAIL_GIB|LANE3_LOAD|LANE3_AVAIL_GIB|LANE_LOAD_PER_CORE|LANE_MIN_AVAIL_GIB|BUILD_LOAD_PER_CORE|BUILD_MAX_CONCURRENCY|BUILD_CONCURRENT_LOAD_PER_CORE|BUILD_CONCURRENT_MIN_AVAIL_GIB|LOAD_OVERRIDE_MINUTES|LOAD_POLL_SECONDS|HEAD_OVERRIDE_BASE_LOAD|MEM_GUARD|MEM_GUARD_COMPRESSOR_GIB|MEM_GUARD_SWAP_GIB|MEM_GUARD_SWAP_GROWTH_GIB|MEM_GUARD_WINDOW_SEC|MEM_GUARD_SUSTAIN|MEM_GUARD_SWAPFILES|MEM_GUARD_SAMPLES|THRESHOLDS_SOURCE|UNKNOWN_KEYS)
        printf -v "$name" '%s' "$value" ;;
    esac
  done <<<"$snapshot"
  local unknown_ifs="$IFS"; IFS=,
  for name in $UNKNOWN_KEYS; do
    case ",$warned," in *",$name,"*) ;; *)
      printf 'res: warning: ignoring unknown machine.conf key %s\n' "$name" >&2
      warned="${warned}${warned:+,}$name" ;;
    esac
  done
  IFS="$unknown_ifs"
  if [ -n "${WAIT_CONFIG_FILE:-}" ]; then
    next="$WAIT_CONFIG_FILE.$$.$RANDOM.tmp"
    (umask 077; printf '%s\nUNKNOWN_KEYS_WARNED\t%s\n' "$snapshot" "$warned" >"$next")
    mv -f "$next" "$WAIT_CONFIG_FILE"
  fi
}

cmd_check_config() {
  [ "$#" -le 1 ] || die 'check-config accepts at most one candidate file'
  python3 -c "$RES_MACHINE_SOURCE
import sys
try:
    parse_config(regular_config(sys.argv[1]))
    print('configuration valid')
except (OSError, ValueError) as error:
    print('res: ' + str(error), file=sys.stderr); sys.exit(1)
" "${1:-$RES_DIR/machine.conf}"
}

# Reuse macOS readings collected by heavy-check; observers probe in their existing Python.
local_memory_reading() {
  RES_MEMORY_PAGES="$1" RES_MEMORY_SWAP="$2" python3 -c "$RES_MACHINE_SOURCE
import sys
heavy = dict(HEAVY_DEFAULTS)
for item in sys.argv[3:]:
    name, value = item.split('=', 1); heavy[name] = value if name == 'MEM_GUARD_SAMPLES' else float(value)
state = memory_probe(sys.argv[1], {'heavy': heavy}, platform=sys.argv[2],
                     readings=(os.environ['RES_MEMORY_PAGES'], os.environ['RES_MEMORY_SWAP']))
print(memory_line(state))
memory_denial(sys.argv[1], state, os.environ.get('RES_MEMORY_ID', str(os.getppid())),
              os.environ.get('RES_MEMORY_RESOURCE', 'heavy-build'), os.environ.get('RES_MEMORY_HOLDER', '-'))
" "$RES_DIR" "$3" "MEM_GUARD=$MEM_GUARD" "MEM_GUARD_COMPRESSOR_GIB=$MEM_GUARD_COMPRESSOR_GIB" \
    "MEM_GUARD_SWAP_GIB=$MEM_GUARD_SWAP_GIB" "MEM_GUARD_SWAP_GROWTH_GIB=$MEM_GUARD_SWAP_GROWTH_GIB" "MEM_GUARD_WINDOW_SEC=$MEM_GUARD_WINDOW_SEC" "MEM_GUARD_SUSTAIN=$MEM_GUARD_SUSTAIN" \
    "MEM_GUARD_SWAPFILES=$MEM_GUARD_SWAPFILES" "MEM_GUARD_SAMPLES=$MEM_GUARD_SAMPLES"
}

legacy_heavy_check() {
  local PID="$PPID" lanes_held limit admission=legacy override=0 memory_details=0
  local MEM_GUARD MEM_GUARD_COMPRESSOR_GIB MEM_GUARD_SWAP_GIB MEM_GUARD_SWAP_GROWTH_GIB MEM_GUARD_WINDOW_SEC MEM_GUARD_SUSTAIN MEM_GUARD_SWAPFILES MEM_GUARD_SAMPLES
  local memory_reading memory_high=0
  local LOAD_LIMIT LOAD_LIMIT_WITH_LANES MIN_AVAIL_GIB LANE3_LOAD LANE3_AVAIL_GIB THRESHOLDS_SOURCE
  local LANE_LOAD_PER_CORE LANE_MIN_AVAIL_GIB BUILD_LOAD_PER_CORE BUILD_MAX_CONCURRENCY
  local BUILD_CONCURRENT_LOAD_PER_CORE BUILD_CONCURRENT_MIN_AVAIL_GIB LOAD_OVERRIDE_MINUTES LOAD_POLL_SECONDS cores=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --pid)
        [ $# -ge 2 ] || die "--pid needs a value"
        PID="$2"; shift 2 ;;
      --admission)
        [ $# -ge 2 ] || die "--admission needs lane, build or build-concurrent"
        case "$2" in lane|build|build-concurrent) admission="$2" ;; *) die "--admission needs lane, build or build-concurrent" ;; esac
        shift 2 ;;
      --memory-details) memory_details=1; shift ;;
      --load-override) override=1; shift ;;
      *) die "unknown option '$1'" ;;
    esac
  done
  validate_pid
  machine_thresholds || return $?
  lanes_held=$(heavy_lanes_held "$PID")
  limit="$LOAD_LIMIT"
  [ "$lanes_held" -eq 0 ] || limit="$LOAD_LIMIT_WITH_LANES"
  printf 'thresholds source=%s LOAD_LIMIT=%s LOAD_LIMIT_WITH_LANES=%s MIN_AVAIL_GIB=%s LANE3_LOAD=%s LANE3_AVAIL_GIB=%s\n' \
    "$THRESHOLDS_SOURCE" "$LOAD_LIMIT" "$LOAD_LIMIT_WITH_LANES" "$MIN_AVAIL_GIB" "$LANE3_LOAD" "$LANE3_AVAIL_GIB"
  if [ "$admission" != legacy ]; then
    printf 'admission-policy LANE_LOAD_PER_CORE=%s LANE_MIN_AVAIL_GIB=%s BUILD_LOAD_PER_CORE=%s BUILD_MAX_CONCURRENCY=%s BUILD_CONCURRENT_LOAD_PER_CORE=%s BUILD_CONCURRENT_MIN_AVAIL_GIB=%s LOAD_OVERRIDE_MINUTES=%s LOAD_POLL_SECONDS=%s\n' \
      "$LANE_LOAD_PER_CORE" "$LANE_MIN_AVAIL_GIB" "$BUILD_LOAD_PER_CORE" "$BUILD_MAX_CONCURRENCY" \
      "$BUILD_CONCURRENT_LOAD_PER_CORE" "$BUILD_CONCURRENT_MIN_AVAIL_GIB" "$LOAD_OVERRIDE_MINUTES" "$LOAD_POLL_SECONDS"
  fi
  local load headroom platform pages_reading pages_headroom memorystatus memsize swap_reading swap_used
  local has_memorystatus=1 test_dir live_dir
  platform=$(uname -s)
  case "$platform" in
    Darwin)
      if [ "${RES_TEST_METRICS:-0}" = 1 ]; then
        # Injected readings are restricted to scratch state, never the live registry.
        test_dir=$(cd "$RES_DIR" && pwd -P) || die "test metrics need an existing scratch RES_DIR"
        live_dir=$(cd "$HOME/.claude/orchestrator/_shared" && pwd -P) || die "cannot resolve live RES_DIR"
        [ "$test_dir" != "$live_dir" ] || die "test metrics require a scratch RES_DIR"
        load="${RES_TEST_LOAD1M-}"
        pages_reading="${RES_TEST_VM_STAT-}"
        memorystatus="${RES_TEST_MEMORYSTATUS_LEVEL-}"
        memsize="${RES_TEST_MEMSIZE-}"
        swap_reading="${RES_TEST_SWAPUSAGE-}"
        [ "$admission" = legacy ] || cores="${RES_TEST_PHYSICAL_CORES:-14}"
        if [ "$memorystatus" = missing ]; then has_memorystatus=0; fi
      else
        [ "$admission" = legacy ] || cores=$(LC_ALL=C sysctl -n hw.physicalcpu) || die "cannot read physical cores"
        load=$(LC_ALL=C sysctl -n vm.loadavg) || die "cannot read load1m"
        load=$(printf '%s\n' "$load" | awk '{print $2}')
        pages_reading=$(LC_ALL=C vm_stat) || die "cannot read memory headroom"
        if memorystatus=$(LC_ALL=C sysctl -n kern.memorystatus_level 2>&1); then
          memsize=$(LC_ALL=C sysctl -n hw.memsize) || die "cannot read physical memory"
        elif [ "$memorystatus" = "sysctl: unknown oid 'kern.memorystatus_level'" ]; then
          has_memorystatus=0
          memsize=
        else
          die "cannot read macOS memorystatus level"
        fi
        swap_reading=$(LC_ALL=C sysctl -n vm.swapusage) || die "cannot read swap usage"
      fi
      pages_headroom=$(printf '%s\n' "$pages_reading" | awk '
        /page size of/ { size = $8 }
        /^Pages free:/ { free = $3; sub(/[.]$/, "", free); nf = free ~ /^[0-9]+$/ }
        /^Pages inactive:/ { inactive = $3; sub(/[.]$/, "", inactive); ni = inactive ~ /^[0-9]+$/ }
        /^Pages speculative:/ { speculative = $3; sub(/[.]$/, "", speculative); ns = speculative ~ /^[0-9]+$/ }
        END {
          if (size <= 0 || !nf || !ni || !ns) exit 1
          printf "%.0f\n", (free + inactive + speculative) * size
        }') || die "cannot read memory headroom"
      swap_used=$(printf '%s\n' "$swap_reading" | awk '
        {
          for (i = 1; i <= NF - 2; i++) {
            if ($i != "used" || $(i + 1) != "=") continue
            value = $(i + 2)
            if (value !~ /^[0-9]+([.][0-9]+)?[KMGT]$/) exit 1
            unit = substr(value, length(value))
            sub(/[KMGT]$/, "", value)
            scale = unit == "K" ? 1024 : unit == "M" ? 1048576 : unit == "G" ? 1073741824 : 1099511627776
            printf "%.0f\n", value * scale
            found = 1
            break
          }
        }
        END { if (!found) exit 1 }') || die "cannot read swap usage"
      memory_reading=$(RES_MEMORY_ID="${WAIT_CONFIG_FILE:-${BY:-check}:$PID}" RES_MEMORY_RESOURCE="${WAITER_RESOURCE:-${id:-heavy-build}}" RES_MEMORY_HOLDER="${BY:-check}" local_memory_reading "$pages_reading" "$swap_reading" "$platform")
      [ "$memory_details" != 1 ] || printf '%s\n' "$memory_reading"
      [[ "$memory_reading" != *memory=HIGH* ]] || memory_high=1
      awk -v memory_high="$memory_high" -v load="$load" -v pages="$pages_headroom" -v level="$memorystatus" \
        -v has_level="$has_memorystatus" -v ram="$memsize" -v swap="$swap_used" \
        -v limit="$limit" -v lanes="$lanes_held" -v min_gib="$MIN_AVAIL_GIB" \
        -v admission="$admission" -v cores="$cores" -v override="$override" \
        -v lane_ratio="$LANE_LOAD_PER_CORE" -v lane_gib="$LANE_MIN_AVAIL_GIB" -v build_ratio="$BUILD_LOAD_PER_CORE" \
        -v concurrent_ratio="$BUILD_CONCURRENT_LOAD_PER_CORE" -v concurrent_gib="$BUILD_CONCURRENT_MIN_AVAIL_GIB" \
        -v poll="$LOAD_POLL_SECONDS" -v override_minutes="$LOAD_OVERRIDE_MINUTES" -v base="${HEAD_OVERRIDE_BASE_LOAD:-0}" \
        -v third_load="$LANE3_LOAD" -v third_gib="$LANE3_AVAIL_GIB" 'BEGIN {
        if (load !~ /^[0-9]+([.][0-9]+)?$/ || pages !~ /^[0-9]+$/ || swap !~ /^[0-9]+$/) exit 1
        if (has_level && (level !~ /^[0-9]+$/ || level > 100 || ram !~ /^[0-9]+$/ || ram <= 0)) exit 1
        if (admission != "legacy" && (cores !~ /^[0-9]+$/ || cores + 0 <= 0)) exit 1
        if ((admission == "lane" || admission == "build-concurrent") && !has_level) exit 1
        gib = (has_level ? level / 100 * ram : pages) / 1073741824
        legacy_bad = load > limit || gib < min_gib
        # User 2026-11-18: with HEAD_OVERRIDE_BASE_LOAD=1 the 20-minute FIFO head of a solo build
        # passes the base load limit too; memory still gates it.
        head_base = base == 1 && admission == "build"
        if (head_base && override) legacy_bad = gib < min_gib
        new_bad = admission == "lane" ? load > cores * lane_ratio || gib < lane_gib : load > cores * build_ratio
        if (admission == "build-concurrent") new_bad = load > cores * concurrent_ratio || gib < concurrent_gib
        used = override && admission != "build-concurrent" && new_bad
        overloaded = admission == "legacy" ? legacy_bad : admission == "lane" ? new_bad && !used : legacy_bad || (new_bad && !used)
        blocked = admission ~ /^build/ && legacy_bad ? "gate" : overloaded ? "load" : "none"
        if (head_base && blocked == "gate" && gib >= min_gib) blocked = "load"
        if (admission == "lane") { limit = cores * lane_ratio; min_gib = lane_gib }
        if (admission == "build" && cores * build_ratio < limit) limit = cores * build_ratio
        if (admission == "build-concurrent") { if (cores * concurrent_ratio < limit) limit = cores * concurrent_ratio; if (concurrent_gib > min_gib) min_gib = concurrent_gib }
        if (memory_high) { overloaded = 1; blocked = "memory" }
        lane3 = !memory_high && load <= third_load && gib >= third_gib ? "OPEN" : "CLOSED"
        source = has_level ? sprintf("memorystatus %d%%", level) : "memorystatus unavailable; pages fallback"
        printf "load1m=%.2f limit=%s lanes_held=%d avail=%.2fGiB (%s) pages_headroom=%.2fGiB swap_used=%.2fGiB gate=%s lane3=%s", \
          load, limit, lanes, gib, source, pages / 1073741824, swap / 1073741824, overloaded ? "OVERLOADED" : "OK", \
          lane3
        if (admission != "legacy") printf " admission=%s cores=%d min_avail_gib=%s load_override=%d blocked=%s poll_seconds=%s override_minutes=%s", \
          admission, cores, min_gib, used, blocked, poll, override_minutes
        printf "\n"
        exit overloaded ? 5 : 0
      }'
      return $?
      ;;
    Linux)
      memory_reading=$(local_memory_reading '' '' "$platform")
      [ "$memory_details" != 1 ] || printf '%s\n' "$memory_reading"
      if [ "$admission" != legacy ]; then
        if [ "${RES_TEST_METRICS:-0}" = 1 ]; then
          test_dir=$(cd "$RES_DIR" && pwd -P) || die "test metrics need an existing scratch RES_DIR"
          live_dir=$(cd "$HOME/.claude/orchestrator/_shared" && pwd -P) || die "cannot resolve live RES_DIR"
          [ "$test_dir" != "$live_dir" ] || die "test metrics require a scratch RES_DIR"
          cores="${RES_TEST_PHYSICAL_CORES:-14}"
        else
          cores=$(awk -F: '
            function save() { if (socket != "" && core != "") seen[socket ":" core] = 1; socket = core = "" }
            /^physical id/ { socket=$2; gsub(/ /, "", socket) }
            /^core id/ { core=$2; gsub(/ /, "", core) }
            /^$/ { save() }
            END { save(); for (id in seen) n++; if (!n) exit 1; print n }
          ' /proc/cpuinfo) || die "cannot read physical cores"
        fi
      fi
      load=$(awk '{print $1}' /proc/loadavg) || die "cannot read load1m"
      headroom=$(awk '/^MemAvailable:/ {printf "%.0f\n", $2 * 1024; found = 1}
        END {if (!found) exit 1}' /proc/meminfo) || die "cannot read memory headroom"
      ;;
    *) die "heavy-check is unsupported on this OS" ;;
  esac
  awk -v load="$load" -v bytes="$headroom" -v limit="$limit" -v lanes="$lanes_held" \
    -v admission="$admission" -v cores="$cores" -v override="$override" \
    -v lane_ratio="$LANE_LOAD_PER_CORE" -v lane_gib="$LANE_MIN_AVAIL_GIB" -v build_ratio="$BUILD_LOAD_PER_CORE" \
    -v concurrent_ratio="$BUILD_CONCURRENT_LOAD_PER_CORE" -v concurrent_gib="$BUILD_CONCURRENT_MIN_AVAIL_GIB" \
    -v poll="$LOAD_POLL_SECONDS" -v override_minutes="$LOAD_OVERRIDE_MINUTES" -v base="${HEAD_OVERRIDE_BASE_LOAD:-0}" \
    -v min_gib="$MIN_AVAIL_GIB" -v third_load="$LANE3_LOAD" -v third_gib="$LANE3_AVAIL_GIB" 'BEGIN {
    if (load !~ /^[0-9]+([.][0-9]+)?$/ || bytes !~ /^[0-9]+$/) exit 1
    if (admission != "legacy" && (cores !~ /^[0-9]+$/ || cores + 0 <= 0)) exit 1
    gib = bytes / 1073741824
    legacy_bad = load > limit || gib < min_gib
    # User 2026-11-18: with HEAD_OVERRIDE_BASE_LOAD=1 the 20-minute FIFO head of a solo build
    # passes the base load limit too; memory still gates it.
    head_base = base == 1 && admission == "build"
    if (head_base && override) legacy_bad = gib < min_gib
    new_bad = admission == "lane" ? load > cores * lane_ratio || gib < lane_gib : load > cores * build_ratio
    if (admission == "build-concurrent") new_bad = load > cores * concurrent_ratio || gib < concurrent_gib
    used = override && admission != "build-concurrent" && new_bad
    overloaded = admission == "legacy" ? legacy_bad : admission == "lane" ? new_bad && !used : legacy_bad || (new_bad && !used)
    blocked = admission ~ /^build/ && legacy_bad ? "gate" : overloaded ? "load" : "none"
    if (head_base && blocked == "gate" && gib >= min_gib) blocked = "load"
    if (admission == "lane") { limit = cores * lane_ratio; min_gib = lane_gib }
    if (admission == "build" && cores * build_ratio < limit) limit = cores * build_ratio
    if (admission == "build-concurrent") { if (cores * concurrent_ratio < limit) limit = cores * concurrent_ratio; if (concurrent_gib > min_gib) min_gib = concurrent_gib }
    lane3 = load <= third_load && gib >= third_gib ? "OPEN" : "CLOSED"
    printf "load1m=%.2f limit=%s lanes_held=%d avail=%.2fGiB headroom=%.2f GiB gate=%s lane3=%s", \
      load, limit, lanes, gib, gib, overloaded ? "OVERLOADED" : "OK", lane3
    if (admission != "legacy") printf " admission=%s cores=%d min_avail_gib=%s load_override=%d blocked=%s poll_seconds=%s override_minutes=%s", \
      admission, cores, min_gib, used, blocked, poll, override_minutes
    printf "\n"
    exit overloaded ? 5 : 0
  }'
}

cmd_heavy_check() {
  local legacy_rc=0 dynamic_rc=0
  legacy_heavy_check "$@" || legacy_rc=$?
  if local_controller enabled; then
    local_controller heavy-check || dynamic_rc=$?
  fi
  [ "$legacy_rc" -eq 0 ] || return "$legacy_rc"
  return "$dynamic_rc"
}

# Use the unrounded controller verdict, never the rounded load/avail display.
lane3_open() { [[ "$1" = *' lane3=OPEN'* ]]; }

# A PID dot lock serializes reclaimers and recovers dead reclaimers. Rename
# before deleting so cleanup cannot remove a newly acquired hold's directory.
reclaim_stale_heavy() (
  local id="$1" by="$2" lock="$LOCKS/$1.d" snapshot retired holder pid start
  case "$id" in heavy-*) ;; *) return 1 ;; esac
  [ -d "$lock" ] || return 1
  hold_pid_stale "$id" && hold_old "$id" || return 1
  snapshot=$(cat "$lock/info") || return 1
  retired=$(mktemp -d "$LOCKS/.stale-$id.XXXXXX") || return 1
  cd "$lock" || { rmdir "$retired"; return 1; }
  shlock -p "$$" -f .reclaim 2>/dev/null || { rmdir "$retired"; return 1; }
  trap 'rm -f .reclaim; rmdir "$retired" 2>/dev/null || true' EXIT
  trap 'exit 1' INT TERM HUP
  [ "$(cat info)" = "$snapshot" ] && hold_pid_stale "$id" && hold_old "$id" || return 1
  local evidence count checkout
  if evidence=$(python3 -c "$RES_BUILD_PROCESS_SOURCE" "$lock/info"); then :
  else
    IFS=$'\t' read -r count checkout <<<"$evidence"
    if [ ! -e .build-alive-noticed ]; then
      : >.build-alive-noticed
      local message="STALE pid but build processes alive under $checkout: $count"
      [ "$count" != unknown ] || message="STALE pid; build process check unavailable under $checkout; retaining hold"
      log stale-build-alive "$id" "$by" "$message"
      echo "res: $message" >&2
    fi
    return 1
  fi
  holder=$(field "$id" by); pid=$(field "$id" pid); start=$(field "$id" start)
  mv "$lock" "$retired/hold" || return 1
  log reclaim "$id" "$by" "auto-reclaim STALE heavy hold from $holder (pid=$pid start=$start; age > 10 minutes)"
  echo "res: auto-reclaimed STALE $id from $holder (pid=$pid; age > 10 minutes)" >&2
  rm -rf "$retired"
)

cmd_wait() {
  local id="${1:-}"; shift || true; need_id "$id"
  local timeout= args=() duration deadline remaining delay=1 rc reading load_poll ALLOW_PID=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout)
        [ $# -ge 2 ] || die "--timeout needs minutes"
        [ -z "$timeout" ] || die "duplicate --timeout"
        timeout="$2"; shift 2 ;;
      --by|--project|--for|--task|--until|--note|--device|--policy|--pid)
        [ $# -ge 2 ] || die "$1 needs a value"
        args+=("$1" "$2"); shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  [[ "$timeout" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "wait needs --timeout <non-negative minutes>"
  parse ${args[@]+"${args[@]}"}
  [ -n "$BY" ] && [ -n "$PROJECT" ] && [ -n "$PURPOSE" ] || die "wait needs --by, --project and --for"
  validate_pid
  duration=$(awk -v t="$timeout" 'BEGIN {s=t*60; printf "%.0f\n", int(s)+(s>int(s))}')
  deadline=$((SECONDS + duration))
  WAIT_CONFIG_FILE=$(mktemp "$RES_DIR/.wait-config.XXXXXX")
  trap 'cleanup_build_waiter' EXIT
  trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
  while :; do
    rc=0
    case "$id" in
      heavy-*)
        local admission_args=()
        case "$id" in
          heavy-lane-1|heavy-lane-2) admission_args=(--admission lane) ;;
        esac
        if reading=$(cmd_heavy_check --memory-details --pid "$PID" ${admission_args[@]+"${admission_args[@]}"}); then
          print_gate_reading "$reading"
          if [ "$id" != heavy-lane-3 ] || lane3_open "$reading"; then
            reclaim_stale_heavy "$id" "$BY" || true
          else
            rc=5
          fi
        else
          rc=$?
          [ -z "$reading" ] || print_gate_reading "$reading"
          [ "$rc" -eq 5 ] || { cleanup_build_waiter; return "$rc"; }
        fi ;;
    esac
    if [ "$rc" -ne 5 ]; then
      if wait_take_attempt "$id" ${args[@]+"${args[@]}"}; then cleanup_build_waiter; return 0; else rc=$?; fi
      [ "$rc" -eq 2 ] || [ "$rc" -eq 5 ] || { cleanup_build_waiter; return "$rc"; }
      trap 'cleanup_build_waiter' EXIT
      trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
    fi
    remaining=$((deadline - SECONDS))
    if [ "$remaining" -le 0 ]; then
      echo "res: timed out waiting for '$id' after $timeout minutes" >&2
      cleanup_build_waiter; return 2
    fi
    if [ "$rc" -eq 5 ] && [[ "$id" =~ ^heavy-lane-[12]$ ]]; then
      load_poll=$(reading_field "$reading" poll_seconds)
      [ -z "$load_poll" ] || delay="$load_poll"
    fi
    [ "$delay" -le "$remaining" ] || delay="$remaining"
    echo "res: waiting for '$id'; retry in ${delay}s" >&2
    sleep "$delay"
    delay=$((delay * 2)); [ "$delay" -le 15 ] || delay=15
  done
}

reg_line() {
  local line
  while IFS= read -r line; do
    [ "${line%%$'\t'*}" != "$1" ] || { printf '%s\n' "$line"; return 0; }
  done <"$REG"
}

need_id() {
  [ -n "${1:-}" ] || die "missing resource id"
  [ -n "$(reg_line "$1")" ] || die "unknown resource '$1' (see: res status)"
}
field() {
  local key value
  [ -f "$LOCKS/$1.d/info" ] || return 0
  while IFS=$'\t' read -r key value; do
    [ "$key" != "$2" ] || { printf '%s\n' "$value"; return 0; }
  done <"$LOCKS/$1.d/info"
  return 0
}

holder_details() {
  local details
  details=$(awk -F'\t' '
    $1 == "by" { holder = $2 }
    $1 == "pid" { pid = $2 }
    $1 == "since" { since = $2 }
    END { printf "%s (pid=%s, since=%s)", (holder != "" ? holder : "?"), (pid != "" ? pid : "?"), (since != "" ? since : "?") }
  ' "$LOCKS/$1.d/info" 2>/dev/null) || { printf 'unknown holder (metadata unavailable)'; return 0; }
  printf '%s' "$details"
}
# Live link of a device: connected | <devicectl state> | not seen. One probe per run.
# usbmux comes first: devicectl shows iOS < 17 devices only by ECID. The three sources run in
# parallel; idevice_id (libimobiledevice) is preferred over pymobiledevice3, which is ~1 s slower.
# `probe quick` skips devicectl (0.2 s to several s): enough when usbmux or adb sees the device.
DEVS=
probe() {
  [ -n "$DEVS" ] && return 0
  local t; t=$(mktemp -d)
  { if command -v idevice_id >/dev/null; then idevice_id -l 2>/dev/null | sed 's/$/ (USBMUX) device/'
    else pymobiledevice3 usbmux list 2>/dev/null | sed -nE 's/.*"Identifier": "([^"]+)".*/\1 (USBMUX) device/p'
    fi >"$t/1" || true; } &
  [ "${1:-}" = quick ] || { xcrun devicectl list devices >"$t/2" 2>/dev/null || true; } &
  { adb devices 2>/dev/null | awk -F'\t' 'NR>1 && NF==2{print $1 " (ADB) " $2}' >"$t/3" || true; } &
  wait
  DEVS=$(cat "$t/1" "$t/2" "$t/3" 2>/dev/null || true)
  rm -rf "$t"
  DEVS="${DEVS:-none}"
}
conn() {
  [ "$1" = - ] && { echo -; return; }
  probe
  local line state
  line=$(printf '%s\n' "$DEVS" | grep -F -- "$1 (" | head -1 || true)
  [ -n "$line" ] || { echo "not seen"; return; }
  state=$(printf '%s\n' "$line" | sed -E 's/.*\((UDID|ADB|USBMUX)\) +//; s/  .*//')
  case "$state" in available*|device) echo connected ;; *) echo "${state:-not seen}" ;; esac
}
log() { printf '%s\t%s\t%s\t%s\t%s\n' "$(now)" "$1" "$2" "$3" "$4" >>"$LOG"; }

waiter_field() {
  local key value
  [ -f "$1/info" ] || return 0
  while IFS=$'\t' read -r key value; do
    [ "$key" != "$2" ] || { printf '%s\n' "$value"; return 0; }
  done <"$1/info"
  return 0
}


waiter_is_current() {
  local dir="$1"
  [ -n "$dir" ] || return 1
  [ "${BUILD_WAITER_DIR:-}" != "$dir" ] || return 0
  [ -n "${BUILD_WAITER_ORDER:-}" ] && \
    [ "$(waiter_field "$dir" order)" = "$BUILD_WAITER_ORDER" ] && \
    [ "$(waiter_field "$dir" holder)" = "${BY:-}" ] && \
    [ "$(waiter_field "$dir" pid)" = "${PID:-}" ] && \
    [ "$(waiter_field "$dir" host)" = "${BUILD_WAITER_HOST:-}" ]
}

oldest_live_waiter() {
  local dir order root="${1:-$WAITERS}"
  cleanup_build_waiters "$root"
  for dir in "$root"/waiter.*; do
    [ -d "$dir" ] || continue
    order=$(waiter_field "$dir" order); [ -n "$order" ] || order=$(waiter_field "$dir" start)
    printf '%s\t%s\n' "$order" "$dir"
  done | LC_ALL=C sort -t $'\t' -k1,1 -k2,2 | head -1 | cut -f2-
}

reading_field() {
  printf '%s\n' "$1" | awk -v key="$2" '{for (i=1; i<=NF; i++) if (index($i, key "=") == 1) {sub(/^[^=]*=/, "", $i); print $i; exit}}'
}

# Keep successful legacy take/wait transcripts stable; internal checks retain details.
print_gate_reading() {
  local line
  while IFS= read -r line; do
    case "$line" in memory=HIGH*) ;; memory=*) continue ;; esac
    printf '%s\n' "$line"
  done <<<"$1"
}

# True when the legacy gate reading is blocked by load alone (memory fine) and the
# user-approved head override for the base load limit is enabled.
base_load_only() {
  [[ "$1" != *memory=HIGH* ]] || return 1
  ( machine_thresholds >/dev/null 2>&1 || exit 1
    [ "${HEAD_OVERRIDE_BASE_LOAD:-0}" = 1 ] || exit 1
    avail=$(reading_field "$1" avail); avail=${avail%GiB}
    awk -v a="$avail" -v m="$MIN_AVAIL_GIB" 'BEGIN { exit !(a ~ /^[0-9]+([.][0-9]+)?$/ && a + 0 >= m + 0) }' )
}

update_load_head() {
  local blocked="$1" head=
  if [ "$blocked" = load ]; then head=$(oldest_live_waiter "${WAITER_ROOT:-$WAITERS}"); fi
  if [ -n "$head" ] && waiter_is_current "$head"; then
    [ "${LOAD_HEAD_SINCE:-0}" != 0 ] || LOAD_HEAD_SINCE=$(date +%s)
  else
    LOAD_HEAD_SINCE=0
  fi
}

head_load_override() {
  [ -n "${BUILD_WAITER_DIR:-}" ] && [ "${LOAD_HEAD_SINCE:-0}" != 0 ] || return 1
  local current head; current=$(date +%s); head=$(oldest_live_waiter "${WAITER_ROOT:-$WAITERS}")
  waiter_is_current "$head" || return 1
  awk -v current="$current" -v since="$LOAD_HEAD_SINCE" -v minutes="$1" \
    'BEGIN { exit !(since ~ /^[0-9]+$/ && current >= since && current - since >= minutes * 60) }'
}

waiter_live() {
  local dir="$1" pid host heartbeat current rc=0
  [ -f "$dir/info" ] || return 1
  heartbeat=$(waiter_field "$dir" heartbeat); current=$(date +%s)
  case "$heartbeat" in ''|*[!0-9]*) return 1 ;; esac
  awk -v heartbeat="$heartbeat" -v current="$current" -v stale="$WAITER_STALE_SECONDS" \
    'BEGIN { exit !(current >= heartbeat && current - heartbeat <= stale) }' || return 1
  host=$(waiter_field "$dir" host)
  [ "$host" = "$(local_host)" ] || return 0
  pid=$(waiter_field "$dir" pid)
  case "$pid" in ''|*[!0-9]*|0) return 1 ;; esac
  ps -p "$pid" -o pid= >/dev/null 2>&1 || rc=$?
  # As with hold staleness, only ps exit 1 proves death. An unavailable probe
  # does not discard a fresh heartbeat.
  [ "$rc" -eq 0 ] || [ "$rc" -ne 1 ]
}

cleanup_build_waiters() {
  local dir root="${1:-$WAITERS}"
  [ -d "$root" ] || return 0
  for dir in "$root"/waiter.*; do
    [ -d "$dir" ] || continue
    # A slow post-mkdir check must not reap the pool caller's own live episode.
    if [ "${POOL_ACQUIRE:-0}" = 1 ] && waiter_is_current "$dir"; then continue; fi
    waiter_live "$dir" || rm -rf "$dir"
  done
}

oldest_build_waiter() {
  local dir order streak root="${1:-$WAITERS}"
  cleanup_build_waiters "$root"
  for dir in "$root"/waiter.*; do
    [ -d "$dir" ] || continue
    streak=$(waiter_field "$dir" gate_streak)
    case "$streak" in ''|*[!0-9]*) streak=0 ;; esac
    [ "$streak" -lt 3 ] || continue
    order=$(waiter_field "$dir" order)
    [ -n "$order" ] || order=$(waiter_field "$dir" start)
    printf '%s\t%s\n' "$order" "$dir"
  done | LC_ALL=C sort -t $'\t' -k1,1 -k2,2 | head -1 | cut -f2-
}

holder_has_live_waiter() {
  local holder="$1" pid="$2" dir
  cleanup_build_waiters
  for dir in "$WAITERS"/waiter.*; do
    [ -d "$dir" ] || continue
    [ "$(waiter_field "$dir" holder)" = "$holder" ] || continue
    [ "$(waiter_field "$dir" pid)" = "$pid" ] || continue
    return 0
  done
  return 1
}

# Return success only when this newly-created lane must be yielded. Checking
# after atomic mkdir makes concurrent non-waiters conservative: at least one
# of them rolls back rather than jointly consuming the last admitted lane.
lane_reserved_for_waiter() {
  local candidate="$1" waiter holder pin lane3 build_id build_holder build_pid lane free=0 eligible=0
  case "$candidate" in heavy-lane-[123]) ;; *) return 1 ;; esac
  waiter=$(oldest_build_waiter); [ -n "$waiter" ] || return 1
  holder=$(waiter_field "$waiter" holder); pin=$(waiter_field "$waiter" lane); lane3=$(waiter_field "$waiter" lane3)
  if [ "${WAITER_RESOURCE:-}" = heavy-build ] && [ -n "${BUILD_WAITER_DIR:-}" ] && [ "$holder" = "$BY" ] && [ "$(waiter_field "$waiter" pid)" = "$PID" ]; then
    return 1
  fi
  for build_id in heavy-build heavy-build-2 heavy-build-3; do
    [ -d "$LOCKS/$build_id.d" ] && ! hold_stale "$build_id" || continue
    build_holder=$(field "$build_id" by); build_pid=$(field "$build_id" pid)
    # A holder that still has a waiter record is an in-flight pair attempt,
    # not the established active build that suspends the reservation.
    holder_has_live_waiter "$build_holder" "$build_pid" || return 1
  done
  for lane in ${pin:-heavy-lane-1 heavy-lane-2 heavy-lane-3}; do
    [ -n "$(reg_line "$lane")" ] || continue
    [ "$lane" != heavy-lane-3 ] || [ "$lane3" = OPEN ] || continue
    if [ "$lane" = "$candidate" ]; then eligible=1; continue; fi
    [ -d "$LOCKS/$lane.d" ] || free=$((free + 1))
  done
  [ "$eligible" -eq 1 ] && [ "$free" -eq 0 ] || return 1
  RESERVED_WAITER_HOLDER="$holder"
  return 0
}

# The build queue keeps v1.5 priority. Lane waiters add a project cap while
# another project is ready, and reserve the last admitted lane for their head.
# Metadata is published before this check so simultaneous takers see each
# other's project; losing attempts unwind their own newly-created directory.
project_holds_lane() {
  local project="$1" candidate="${2:-}" lane
  for lane in "$LOCKS"/heavy-lane-*.d; do
    [ -d "$lane" ] || continue
    lane="${lane##*/}"; lane="${lane%.d}"
    [ "$lane" != "$candidate" ] || continue
    [ "$(field "$lane" project)" = "$project" ] || continue
    hold_stale "$lane" && continue
    return 0
  done
  return 1
}

ready_lane_waiters() {
  local dir streak
  cleanup_build_waiters "$LANE_WAITERS"
  for dir in "$LANE_WAITERS"/waiter.*; do
    [ -d "$dir" ] || continue
    streak=$(waiter_field "$dir" gate_streak)
    case "$streak" in ''|*[!0-9]*) streak=0 ;; esac
    [ "$streak" -lt 3 ] || continue
    printf '%s\t%s\n' "$(waiter_field "$dir" order)" "$dir"
  done | LC_ALL=C sort -t $'\t' -k1,1 -k2,2 | cut -f2-
}

oldest_lane_waiter() {
  local ready="$1" candidate="$2" dir other project capped
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    project=$(waiter_field "$dir" project); capped=0
    if project_holds_lane "$project" "$candidate"; then
      while IFS= read -r other; do
        [ -n "$other" ] || continue
        [ "$(waiter_field "$other" project)" != "$project" ] || continue
        project_holds_lane "$(waiter_field "$other" project)" "$candidate" && continue
        capped=1; break
      done <<<"$ready"
    fi
    [ "$capped" -eq 1 ] || { printf '%s\n' "$dir"; return 0; }
  done <<<"$ready"
}

lane_waiter_blocks() {
  local candidate="$1" oldest dir lane free=0 eligible=0
  local ready
  case "$candidate" in heavy-lane-[123]) ;; *) return 1 ;; esac
  ready=$(ready_lane_waiters)
  [ -n "$ready" ] || return 1
  if [ "${WAITER_RESOURCE:-}" = heavy-build ] && [ -n "${BUILD_WAITER_DIR:-}" ] && \
    [ "$BUILD_WAITER_DIR" = "$(oldest_build_waiter)" ]; then return 1; fi
  if project_holds_lane "$PROJECT" "$candidate"; then
    while IFS= read -r dir; do
      [ -n "$dir" ] || continue
      [ "$(waiter_field "$dir" project)" != "$PROJECT" ] || continue
      project_holds_lane "$(waiter_field "$dir" project)" "$candidate" && continue
      RESERVED_MESSAGE="project '$PROJECT' already holds a lane; waiting project $(waiter_field "$dir" project) has priority; retry or use wait-lane"
      return 0
    done <<<"$ready"
  fi
  oldest=$(oldest_lane_waiter "$ready" "$candidate")
  [ -n "$oldest" ] || return 1
  if [ "${WAITER_RESOURCE:-}" = heavy-lane-any ] && [ -n "${BUILD_WAITER_DIR:-}" ]; then
    [ "$BUILD_WAITER_DIR" != "$oldest" ] || return 1
    RESERVED_MESSAGE="reserved for waiting lane $(waiter_field "$oldest" holder) (FIFO); retry or use wait-lane"
    return 0
  fi
  for lane in heavy-lane-1 heavy-lane-2 heavy-lane-3; do
    [ -n "$(reg_line "$lane")" ] || continue
    [ "$lane" != heavy-lane-3 ] || [ "$(waiter_field "$oldest" lane3)" = OPEN ] || continue
    if [ "$lane" = "$candidate" ]; then eligible=1; continue; fi
    [ -d "$LOCKS/$lane.d" ] || free=$((free + 1))
  done
  [ "$eligible" -eq 1 ] && [ "$free" -eq 0 ] || return 1
  RESERVED_MESSAGE="reserved for waiting lane $(waiter_field "$oldest" holder); retry or use wait-lane"
  return 0
}

# Kept inline so the installed standalone res needs no companion deployment.
# A kernel lock serializes writers; atomic replacement gives readers a whole snapshot.
box_health() {
  python3 - "$RES_DIR" "$@" <<'PY'
import fcntl, json, math, os, re, sys, tempfile, time
root, action, *args = sys.argv[1:]
state_path = os.path.join(root, 'box-health.json')
now = time.time()
def host_of(description):
    match = re.search(r'[A-Za-z0-9_.-]+@([A-Za-z0-9][A-Za-z0-9.-]*)', description)
    return match.group(1).rstrip('.') if match else None
def read_state():
    try:
        with open(state_path) as stream: state = json.load(stream)
    except FileNotFoundError: return {}
    if not isinstance(state, dict): raise ValueError('invalid box-health.json')
    for host, value in state.items():
        if not isinstance(value, dict): raise ValueError('invalid box health entry')
        until = value.get('quarantinedUntil', 0)
        if not isinstance(until, (int, float)) or not math.isfinite(until) or until < 0:
            raise ValueError('invalid quarantine expiry')
        for key in ('manual', 'autoQuarantined'):
            if key in value and not isinstance(value[key], bool): raise ValueError('invalid quarantine flag')
        if not isinstance(value.get('failures', []), list): raise ValueError('invalid failure history')
        for failure in value.get('failures', []):
            if not isinstance(failure, dict) or not isinstance(failure.get('at'), (int, float)) or not math.isfinite(failure['at']):
                raise ValueError('invalid failure timestamp')
    return state
def quarantined(value):
    return value.get('manual', False) or value.get('quarantinedUntil', 0) > now
def display(state, hosts):
    return {host: {**state.get(host, {}), 'quarantined': quarantined(state.get(host, {})),
                   'failures30m': sum(now - 1800 <= f['at'] <= now for f in state.get(host, {}).get('failures', []))}
            for host in sorted(hosts)}
try:
    with open(os.path.join(root, 'resources.tsv')) as stream:
        rows = [line.rstrip('\n').split('\t') for line in stream if line.strip() and not line.startswith('#')]
    remote = {r[0]: (r[2], host_of('\t'.join(r[4:]))) for r in rows if len(r) >= 5 and r[1] == 'remote'}
    caps, preferences = {}, {}
    for row in rows:
        if row[0] not in remote: continue
        match = re.search(r'(?:^|\s)caps=([A-Za-z0-9_,.-]+)(?=\s|$)', '\t'.join(row[4:]))
        caps[row[0]] = set(match.group(1).split(',')) if match else set()
        prefer_tag = re.search(r'(?:^|\s)prefer=([^\s]+)', '\t'.join(row[4:]))
        preferences[row[0]] = set(prefer_tag.group(1).split(',')) if prefer_tag else set()
    def eligible(id, need, excluded_slots, excluded_hosts):
        return (id in remote and id not in excluded_slots.split(',') and remote[id][1] not in excluded_hosts.split(',')
                and need <= caps[id])
    hosts = {host for _, host in remote.values() if host}
    if action in ('select', 'members'):
        pool, prefer, preferred_slot, need, excluded_slots, excluded_hosts = args
        required = set(need.split(',')) if need else set()
        state = read_state() if action == 'select' else {}
        ids = [id for id, (policy, host) in remote.items() if policy == 'open'
               and (re.fullmatch(re.escape(pool) + r'-[0-9]+', id) or pool.endswith('-light') and id == pool)
               and eligible(id, required, excluded_slots, excluded_hosts)]
        if not ids:
            raise ValueError(f"no open remote member of pool '{pool}' satisfies --need '{need or '(none)'}'")
        ids = [id for id in ids if not quarantined(state.get(remote[id][1], {}))]
        preferred_host = remote.get(preferred_slot, (None, None))[1]
        def tier(id):
            if not preferences[id]: return 0
            return -1 if required & preferences[id] else 1
        print('\n'.join(sorted(ids, key=lambda id: (tier(id), id != preferred_slot,
              not preferred_host or remote[id][1] != preferred_host, remote[id][1] != prefer, id))))
    elif action == 'check':
        policy, host = remote.get(args[0], (None, None))
        required = set(args[1].split(',')) if args[1] else set()
        sys.exit(2 if policy != 'open' or not eligible(args[0], required, args[2], args[3]) or quarantined(read_state().get(host, {})) else 0)
    else:
        if action == 'quarantine' and len(args) == 3 and args[1] == '--reason' and args[2].strip():
            host, _, reason = args
            if any(c in reason for c in '\r\n\t'): raise ValueError('reason must be one line')
        elif action == 'unquarantine' and len(args) == 1: host = args[0]
        elif action == 'report-infra' and len(args) == 3 and args[1] == '--kind' and args[2] in ('ssh', 'disk', 'upload'):
            host = remote.get(args[0], (None, None))[1]
        else: raise ValueError('expected quarantine <host> --reason text, unquarantine <host>, or report-infra <slot> --kind ssh|disk|upload')
        if host not in hosts: raise ValueError('host must belong to a registered remote resource with user@host in its description')
        with open(os.path.join(root, '.box-health.lock'), 'a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            now = time.time()
            state = read_state(); value = state.setdefault(host, {})
            if action == 'unquarantine': state[host] = {}
            elif action == 'quarantine': value.update(manual=True, reason=reason)
            else:
                failures = [f for f in value.get('failures', []) if now - 1800 <= f['at'] <= now]
                failures.append({'at': now, 'kind': args[2]}); value['failures'] = failures
                if len(failures) >= 3 or value.get('autoQuarantined'):
                    value.update(autoQuarantined=True, quarantinedUntil=now + 1200)
                    if not value.get('manual'): value['reason'] = 'infrastructure failures: ' + args[2]
            fd, tmp = tempfile.mkstemp(prefix='.box-health.', dir=root)
            try:
                with os.fdopen(fd, 'w') as stream:
                    json.dump(state, stream, indent=2); stream.write('\n'); stream.flush(); os.fsync(stream.fileno())
                os.replace(tmp, state_path)
            finally:
                if os.path.exists(tmp): os.unlink(tmp)
            with open(os.path.join(root, 'log.tsv'), 'a') as stream:
                stream.write(f"{time.strftime('%Y-%m-%d %H:%M')}\t{action}\t{host}\tres\t" +
                             (args[2] if len(args) == 3 else 'cleared') + '\n')
        print(json.dumps(display(state, [host])))
except (OSError, ValueError, TypeError, KeyError) as error:
    print('res: box health: ' + str(error), file=sys.stderr); sys.exit(1)
PY
}

pool_waiter_blocks() {
  local candidate="$1" pool oldest root
  case "$candidate" in
    *-light) pool="$candidate" ;;
    *-[0-9]*) pool="${candidate%-*}"; [[ "${candidate##*-}" =~ ^[0-9]+$ ]] || return 1 ;;
    *) return 1 ;;
  esac
  root="$POOL_WAITERS/$pool"
  [ -d "$root" ] || return 1
  [ "$(reg_line "$candidate" | cut -f2)" = remote ] || return 1
  oldest=$(oldest_build_waiter "$root")
  [ -n "$oldest" ] || return 1
  [ "${BUILD_WAITER_DIR:-}" != "$oldest" ] || return 1
  waiter_is_current "$oldest" && return 1
  RESERVED_MESSAGE="reserved for waiting pool $(waiter_field "$oldest" holder) (FIFO); retry or use wait-pool $pool"
  return 0
}

write_build_waiter() {
  local blocked="$1" lane3="$2" tmp="$BUILD_WAITER_DIR/info.$$"
  printf 'holder\t%s\nproject\t%s\ntask\t%s\npid\t%s\nhost\t%s\nsince\t%s\nstart\t%s\norder\t%s\nheartbeat\t%s\nblocked\t%s\ngate_streak\t%s\nlane\t%s\nlane3\t%s\nhead_since\t%s\n' \
    "$BY" "$PROJECT" "$TASK" "$PID" "$BUILD_WAITER_HOST" "$BUILD_WAITER_SINCE" \
    "$BUILD_WAITER_START" "$BUILD_WAITER_ORDER" "$(date +%s)" "$blocked" \
    "$BUILD_WAITER_GATE_STREAK" "$pin" "$lane3" "${LOAD_HEAD_SINCE:-0}" >"$tmp"
  mv "$tmp" "$BUILD_WAITER_DIR/info"
}

next_waiter_order() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import time; print(f"{time.time_ns():020d}")'
  else
    printf '%010d-%010d' "$(date +%s)" "$$"
  fi
}

start_build_waiter() {
  local published suffix root="${WAITER_ROOT:-$WAITERS}" test_dir live_dir
  mkdir -p "$root"
  BUILD_WAITER_DIR=$(mktemp -d "$root/.staging.XXXXXX")
  BUILD_WAITER_HOST=$(local_host); BUILD_WAITER_SINCE=$(now); BUILD_WAITER_START=$(date +%s)
  BUILD_WAITER_ORDER=$(next_waiter_order)
  BUILD_WAITER_GATE_STREAK=0
  if [ -n "${RES_TEST_LOAD_HEAD_SINCE:-}" ]; then
    [ "${RES_TEST_METRICS:-0}" = 1 ] && [[ "$RES_TEST_LOAD_HEAD_SINCE" =~ ^[0-9]+$ ]] || die "test load-head age requires injected scratch metrics and an epoch"
    test_dir=$(cd "$RES_DIR" && pwd -P); live_dir=$(cd "$HOME/.claude/orchestrator/_shared" && pwd -P)
    [ "$test_dir" != "$live_dir" ] || die "test load-head age requires a scratch RES_DIR"
    LOAD_HEAD_SINCE="$RES_TEST_LOAD_HEAD_SINCE"
  fi
  write_build_waiter starting CLOSED
  arm_build_waiter_cleanup
  suffix="${BUILD_WAITER_DIR##*.staging.}"; published="$root/waiter.$suffix"
  BUILD_WAITER_STAGING="$BUILD_WAITER_DIR"; BUILD_WAITER_DIR="$published"
  mv "$BUILD_WAITER_STAGING" "$BUILD_WAITER_DIR"
  BUILD_WAITER_STAGING=
  WAIT_CONFIG_FILE="$root/.config.$suffix.tsv"
  log waiter-start "${WAITER_RESOURCE:-heavy-build}" "$BY ($PROJECT${TASK:+/$TASK})" "pid=$PID"
}

update_build_waiter() {
  local blocked="$1" lane3="$2" staging published
  [ -n "${BUILD_WAITER_DIR:-}" ] || return 0
  if [ ! -d "$BUILD_WAITER_DIR" ]; then
    # A slow loop pass (heavy-check under load) can outlive the heartbeat, and
    # another res call then removes this live waiter. Re-publish it with the
    # original order so it keeps its FIFO position instead of being orphaned.
    published="$BUILD_WAITER_DIR"; staging="$(dirname "$published")/.staging.rejoin.$$"
    rm -rf "$staging"; mkdir -p "$staging" || return 0
    BUILD_WAITER_STAGING="$staging"; BUILD_WAITER_DIR="$staging"
    write_build_waiter "$blocked" "$lane3"
    BUILD_WAITER_DIR="$published"
    if ! mv "$staging" "$published" 2>/dev/null; then rm -rf "$staging"; BUILD_WAITER_STAGING=; return 0; fi
    BUILD_WAITER_STAGING=
    log waiter-rejoin "${WAITER_RESOURCE:-heavy-build}" "$BY ($PROJECT${TASK:+/$TASK})" "pid=$PID"
    return 0
  fi
  write_build_waiter "$blocked" "$lane3"
}

cleanup_build_waiter() {
  [ -z "${WAIT_CONFIG_FILE:-}" ] || rm -f "$WAIT_CONFIG_FILE" "$WAIT_CONFIG_FILE.warn" "$WAIT_CONFIG_FILE.devbox"
  WAIT_CONFIG_FILE=
  [ -z "${BUILD_WAITER_DIR:-}" ] || rm -rf "$BUILD_WAITER_DIR"
  [ -z "${BUILD_WAITER_STAGING:-}" ] || rm -rf "$BUILD_WAITER_STAGING"
  BUILD_WAITER_DIR=
  BUILD_WAITER_STAGING=
}

arm_build_waiter_cleanup() {
  [ -n "${BUILD_WAITER_DIR:-}" ] || return 0
  trap 'cleanup_build_waiter' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
}

finish_build_waiter() {
  local outcome="$1" note="$2"
  [ -n "${BUILD_WAITER_DIR:-}" ] || return 0
  log "waiter-$outcome" "${WAITER_RESOURCE:-heavy-build}" "$BY ($PROJECT${TASK:+/$TASK})" "$note"
  cleanup_build_waiter
}

show_build_waiters() {
  local dir key value blocked holder project task since restricted reason found=0 root="${1:-$WAITERS}" label="${2:-builds}"
  cleanup_build_waiters "$root"
  for dir in "$root"/waiter.*; do [ -d "$dir" ] && found=1; done
  [ "$found" -eq 1 ] || return 0
  echo
  echo "Waiting $label:"
  printf '%-24s %-24s %-16s %s\n' HOLDER PROJECT/TASK SINCE BLOCKED
  for dir in "$root"/waiter.*; do
    [ -d "$dir" ] || continue
    printf '%s\t%s\n' "$(waiter_field "$dir" order)" "$dir"
  done | LC_ALL=C sort -t $'\t' -k1,1 | while IFS=$'\t' read -r _ dir; do
    blocked= holder= project= task= since= restricted= reason=
    while IFS=$'\t' read -r key value; do
      case "$key" in
        blocked) blocked="$value" ;;
        holder) holder="$value" ;;
        project) project="$value" ;;
        task) task="$value" ;;
        since) since="$value" ;;
        self_restricted) restricted="$value" ;;
        restriction_reason) reason="$value" ;;
      esac
    done 2>/dev/null <"$dir/info" || continue
    [ "$blocked" != load ] || blocked=blocked=load
    if [ -n "$restricted" ]; then blocked="$blocked self_restricted reason=$reason free_hosts=$restricted"; fi
    printf '%-24s %-24s %-16s %s\n' "$holder" "$project/$task" "$since" "$blocked"
  done
}

parse() {
  BY= PROJECT= PURPOSE= TASK= UNTIL= NOTE= FORCE= OFFLINE= DEVICE= POLICY= PID="$PPID" PID_EXPLICIT= DISK_GIB= DISK_GIB_FILE= PLACEMENT_FILE= MAINTENANCE= EXTRA_DISK_GIB= CLAIM_CORES= CLAIM_MEM=
  while [ $# -gt 0 ]; do
    case "$1" in
      --by) BY="$2"; shift 2 ;;
      --project) PROJECT="$2"; shift 2 ;;
      --for) PURPOSE="$2"; shift 2 ;;
      --task) TASK="$2"; shift 2 ;;
      --until) UNTIL="$2"; shift 2 ;;
      --note) NOTE="$2"; shift 2 ;;
      --force) FORCE=1; shift ;;
      --offline) OFFLINE=1; shift ;;
      --device) DEVICE="$2"; shift 2 ;;
      --policy) POLICY="$2"; shift 2 ;;
      --cores|--mem-gib)
        [ $# -ge 2 ] || die "$1 needs a value"
        [[ "$2" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "invalid claim weight"
        if [ "$1" = --cores ]; then CLAIM_CORES="$2"; else CLAIM_MEM="$2"; fi; shift 2 ;;
      --maintenance) MAINTENANCE=1; shift ;;
      --placement-file) [ $# -ge 2 ] || die "$1 needs a value"; PLACEMENT_FILE="$2"; shift 2 ;;
      --extra-disk-gib) [ $# -ge 2 ] || die "$1 needs a value"; EXTRA_DISK_GIB="$2"; shift 2 ;;
      --disk-gib|--disk-gib-file)
        [ $# -ge 2 ] || die "$1 needs a value"
        if [ "$1" = --disk-gib ]; then
          [[ "$2" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "--disk-gib needs non-negative GiB"
          DISK_GIB="$2"
        else DISK_GIB_FILE="$2"; fi
        shift 2 ;;
      --pid)
        [ "${ALLOW_PID:-}" = 1 ] || die "unknown option '$1'"
        [ $# -ge 2 ] || die "--pid needs a value"
        PID="$2"; PID_EXPLICIT=1; shift 2 ;;
      *) die "unknown option '$1'" ;;
    esac
  done
}

validate_pid() {
  [[ "$PID" =~ ^[1-9][0-9]*$ ]] || die "--pid must be a positive process ID"
}

write_info() {
  printf 'by\t%s\nproject\t%s\ntask\t%s\nfor\t%s\nsince\t%s\nuntil\t%s\npid\t%s\nhost\t%s\nstart\t%s\n' \
    "$BY" "$PROJECT" "$TASK" "$PURPOSE" "$1" "$UNTIL" "$PID" "$(local_host)" "$(date +%s)" >"$LOCKS/$2.d/info"
}

# Retain counts and process identities only, never device serials/details or
# process arguments. Missing adb/ps is evidence unavailable, not a take error.
device_clients() {
  python3 - "$PID_EXPLICIT" "$PID" <<'PY'
import os, signal, subprocess, sys
def cancelled(signum, frame):
    raise SystemExit(128 + signum)
for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
    signal.signal(signum, cancelled)
def probe(args):
    try:
        child = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return None, None
    completed = False
    try:
        output, _ = child.communicate(timeout=2)
        completed = True
        return output, child.returncode
    except subprocess.TimeoutExpired:
        return None, None
    finally:
        if not completed:
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            child.communicate()
adb, adb_status = probe(['adb', 'devices', '-l'])
processes, ps_status = probe(['ps', '-axo', 'pid=,comm='])
if adb_status != 0:
    adb = None
if ps_status != 0:
    processes = None
pid_status = None
if sys.argv[1]:
    _, pid_status = probe(['ps', '-p', sys.argv[2], '-o', 'pid='])
clients = []
if processes is not None:
    for line in processes.decode('utf-8', errors='replace').splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) == 2 and parts[0].isdigit():
            name = os.path.basename(parts[1])
            if name in ('adb', 'devicectl'):
                clients.append(parts[0] + ':' + name)
print('adb_device_lines\t' + ('unknown' if adb is None else str(len(adb.splitlines()))))
print('device_clients\t' + ('unknown' if processes is None else ','.join(clients) or 'none'))
sys.exit(10 if pid_status == 1 else 0)
PY
}
pid_dead() {
  local rc=0
  ps -p "$1" -o pid= >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq 1 ]
}

warn_holder() {
  echo "res: --pid $PID is not a long-lived process; pass the wrapper's \$\$; use scripts/heavy-build.sh <command...>" >&2
}

mark_holder_warning() {
  local id
  for id in "$@"; do
    [ "$(field "$id" by)" = "$BY" ] && [ "$(field "$id" pid)" = "$PID" ] || continue
    [ -n "$(field "$id" pid_warning)" ] || printf 'pid_warning\tshort-lived pid\n' >>"$LOCKS/$id.d/info"
  done
}

# Only successful, fresh, explicit-PID waits/build takes get the delayed check.
# Plain take remains fast. A later observational status catches an invoking
# shell that exits only AFTER res returns (a synchronous check cannot predict it).
check_holder_after_take() {
  [ -n "$PID_EXPLICIT" ] || return 0
  [ -z "$(field "$1" pid_warning)" ] || return 0
  [ "${CHECK_FRESH:-1}" = 1 ] || return 0
  sleep 2
  if pid_dead "$PID"; then warn_holder; mark_holder_warning "$@"; fi
}

# Rollback is run in a signal-shielded child: the controller records a pending
# cancellation while the child and its rm/log helpers finish releasing the
# proven-fresh directory. Interrupted waits keep waiting; a helper killed before
# its shield is armed is relaunched while the fresh directory remains.
rollback_created_id() {
  local id="$1" by="$2" LOCKS="$LOCKS" LOG="$LOG" REG="$REG"
  case "$LOCKS" in /*) ;; *) LOCKS="$PWD/$LOCKS" ;; esac
  case "$LOG" in /*) ;; *) LOG="$PWD/$LOG" ;; esac
  case "$REG" in /*) ;; *) REG="$PWD/$REG" ;; esac
  cd "$LOCKS/$id.d" || return 1
  if [ -z "$(field "$id" by)" ]; then
    rm -rf "$LOCKS/$id.d" || return 1
    log return "$id" "$by" 'interrupted acquisition before metadata publication'
  else
    cmd_return "$id" --by "$by" >/dev/null || return $?
  fi
  # A failed rm must not count as release; a subsequent holder at the same
  # pathname is a different directory and must not be removed by this attempt.
  [ ! "$LOCKS/$id.d" -ef . ]
}

protected_rollback_created() {
  local id="$1" by="$2" child rc=0
  while :; do
    (trap - EXIT; trap '' INT TERM HUP; rollback_created_id "$id" "$by") & child=$!
    while :; do
      if wait "$child"; then return 0; else rc=$?; fi
      if ! kill -0 "$child" 2>/dev/null; then
        # wait may have been interrupted just as cleanup completed. Read the
        # child's cached verdict before treating a replacement path as ours.
        if wait "$child"; then return 0; else rc=$?; fi
        break
      fi
    done
    [ ! -d "$LOCKS/$id.d" ] && return 0
    [ "$rc" -gt 128 ] || return "$rc"
  done
}

# Legacy wait also owns a transaction from mkdir through the delayed PID
# diagnostic. TAKE_CREATED distinguishes a fresh hold from an idempotent one.
wait_take_attempt() {
  local id="$1"; shift
  local TAKE_CREATED=0 TAKE_TRANSACTION=1 CHECK_FRESH=0
  local TRANSACTION_PENDING_SIGNAL=0 TRANSACTION_CLEANING=0 TRANSACTION_COMMITTED=0
  local cleanup_failed=0 rc=0
  local BY="$BY" PROJECT="$PROJECT" PURPOSE="$PURPOSE" TASK="$TASK" UNTIL="$UNTIL"
  local NOTE="$NOTE" FORCE="$FORCE" OFFLINE="$OFFLINE" DEVICE="$DEVICE" POLICY="$POLICY"
  local PID="$PID" PID_EXPLICIT="$PID_EXPLICIT"
  rollback_attempt() {
    [ "$TAKE_CREATED" -eq 1 ] || return 0
    if protected_rollback_created "$id" "$BY"; then TAKE_CREATED=0; return 0; fi
    [ ! -d "$LOCKS/$id.d" ] && TAKE_CREATED=0
    return 1
  }
  transaction_signal() {
    local code="$1"
    [ "$TRANSACTION_PENDING_SIGNAL" -ne 0 ] || TRANSACTION_PENDING_SIGNAL="$code"
    [ "$TRANSACTION_CLEANING" -eq 0 ] || return 0
    TRANSACTION_CLEANING=1
    rollback_attempt || cleanup_failed=1
    TRANSACTION_CLEANING=0
    cleanup_build_waiter
    trap - EXIT
    [ "$cleanup_failed" -eq 0 ] || exit 1
    exit "$TRANSACTION_PENDING_SIGNAL"
  }
  arm_transaction_signals() {
    trap 'transaction_signal 130' INT
    trap 'transaction_signal 143' TERM
    trap 'transaction_signal 129' HUP
  }
  unwind() {
    local status=$?
    if [ "$TRANSACTION_COMMITTED" -eq 1 ] && [ "$status" -eq 0 ]; then
      # Keep transaction_signal armed across the final trap removal/exit gap.
      trap - EXIT
      exit 0
    fi
    TRANSACTION_CLEANING=1
    rollback_attempt || cleanup_failed=1
    TRANSACTION_CLEANING=0
    cleanup_build_waiter
    trap - EXIT
    [ "$cleanup_failed" -eq 0 ] || exit 1
    [ "$TRANSACTION_PENDING_SIGNAL" -eq 0 ] || exit "$TRANSACTION_PENDING_SIGNAL"
    exit "$status"
  }
  finish_attempt() {
    local status="$1"
    TRANSACTION_CLEANING=1
    rollback_attempt || cleanup_failed=1
    TRANSACTION_CLEANING=0
    trap - EXIT
    [ "$cleanup_failed" -eq 0 ] || exit 1
    [ "$TRANSACTION_PENDING_SIGNAL" -eq 0 ] || exit "$TRANSACTION_PENDING_SIGNAL"
    trap - INT TERM HUP
    return "$status"
  }
  trap unwind EXIT
  arm_transaction_signals
  if cmd_take "$id" "$@"; then :
  else rc=$?; finish_attempt "$rc"; return $?; fi
  CHECK_FRESH="$TAKE_CREATED"
  check_holder_after_take "$id"
  TRANSACTION_COMMITTED=1
  # The signal handler still owns fresh rollback across this final EXIT-trap
  # removal. A cancellation before process exit therefore cannot leak it.
  trap - EXIT
  exit 0
}

build_guard_start() {
  [ "${BUILD_GUARD:-0}" = 0 ] || return 0
  mkdir -p "$RES_DIR"
  shlock -p "$$" -f "$RES_DIR/.build-admission.lock" 2>/dev/null || return 2
  BUILD_GUARD=1
}

build_guard_end() {
  [ "${BUILD_GUARD:-0}" = 1 ] || return 0
  local recorded_pid
  recorded_pid=$(cat "$RES_DIR/.build-admission.lock" 2>/dev/null || true)
  # INN's user-space shlock pads its ASCII PID to ten columns; BSD shlock does not.
  recorded_pid="${recorded_pid#"${recorded_pid%%[![:space:]]*}"}"
  recorded_pid="${recorded_pid%"${recorded_pid##*[![:space:]]}"}"
  if [ "$recorded_pid" = "$$" ]; then
    rm -f "$RES_DIR/.build-admission.lock"
  fi
  BUILD_GUARD=0
}

# Resolve a build's checkout identity without invoking git: owned checkout
# locks, a canonical git common directory, then project are progressively less
# precise. Existing holders without this metadata conservatively block overlap.
build_slot_select() {
  local LOAD_LIMIT LOAD_LIMIT_WITH_LANES MIN_AVAIL_GIB LANE3_LOAD LANE3_AVAIL_GIB THRESHOLDS_SOURCE
  local LANE_LOAD_PER_CORE LANE_MIN_AVAIL_GIB BUILD_LOAD_PER_CORE BUILD_MAX_CONCURRENCY
  local BUILD_CONCURRENT_LOAD_PER_CORE BUILD_CONCURRENT_MIN_AVAIL_GIB LOAD_OVERRIDE_MINUTES LOAD_POLL_SECONDS selection rc=0
  machine_thresholds || return $?
  selection=$(python3 - "$RES_DIR" "$LOCKS" "$BUILD_MAX_CONCURRENCY" "$BY" "$PID" "$PROJECT" "${CHECKOUT:-}" "$PWD" <<'PY'
import json, os, sys
root, locks, maximum, by, pid, project, explicit, cwd = sys.argv[1:]
maximum = int(maximum)
checkout_paths = set()
def hold(directory):
    try:
        with open(os.path.join(directory, 'info')) as stream:
            return dict(line.rstrip('\n').split('\t', 1) for line in stream if '\t' in line)
    except FileNotFoundError:
        return {}
def repo(path):
    here = os.path.realpath(path)
    if not os.path.isdir(here): return None
    while True:
        marker = os.path.join(here, '.git')
        if os.path.isdir(marker): gitdir = marker
        elif os.path.isfile(marker):
            try:
                text = open(marker).read().strip()
            except OSError: return None
            if not text.startswith('gitdir: '): return None
            gitdir = os.path.realpath(os.path.join(here, text[8:]))
        else:
            parent = os.path.dirname(here)
            if parent == here: return None
            here = parent; continue
        common = os.path.join(gitdir, 'commondir')
        if os.path.isfile(common):
            try: gitdir = os.path.realpath(os.path.join(gitdir, open(common).read().strip()))
            except OSError: return None
        checkout_paths.add(here)
        return 'repo:' + os.path.realpath(gitdir)
identities = set()
rows = {}
with open(os.path.join(root, 'resources.tsv')) as stream:
    for line in stream:
        if line.startswith('#') or not line.strip(): continue
        row = line.rstrip('\n').split('\t', 4)
        if len(row) == 5: rows[row[0]] = row
for id, row in rows.items():
    if row[1] != 'checkout': continue
    value = hold(os.path.join(locks, id + '.d'))
    if value.get('by') == by and value.get('pid') == pid:
        identities.add('lock:' + id)
        # Checkout registrations may name a path in their description.
        for item in rows[id][4].split():
            if item.startswith('/'): repo(item)
if explicit:
    if explicit in rows and rows[explicit][1] == 'checkout': identities.add('lock:' + explicit)
    else:
        resolved = repo(explicit)
        if resolved is None:
            print('res: --checkout must name a registered checkout or a path inside a git checkout', file=sys.stderr); sys.exit(1)
        identities.add(resolved)
else:
    resolved = repo(cwd)
    if resolved is not None: identities.add(resolved)
if not identities and project: identities.add('project:' + project)
holds, free = [], None
for number in range(1, 4):
    id = 'heavy-build' if number == 1 else 'heavy-build-' + str(number)
    directory = os.path.join(locks, id + '.d')
    if not os.path.isdir(directory):
        if number <= maximum and free is None: free = id
        continue
    value = hold(directory); holds.append((id, value))
    if value.get('by') == by:
        print("res: build slot is held by %s (pid=%s, since=%s); return-build before a fresh acquisition" %
              (by, value.get('pid', '?'), value.get('since', '?')), file=sys.stderr); sys.exit(1)
if free is None or len(holds) >= maximum:
    print('res: heavy-build %d/%d holders; waiting for a slot' % (len(holds), maximum), file=sys.stderr); sys.exit(2)
if holds:
    for _, value in holds:
        try:
            existing = set(json.loads(value.get('checkouts', '')))
        except (TypeError, ValueError): existing = set()
        if not identities or not existing:
            print('res: concurrent build checkout identity unresolved; waiting for solo admission', file=sys.stderr); sys.exit(2)
        if identities & existing:
            print('res: concurrent build checkout is already held by another heavy-build holder', file=sys.stderr); sys.exit(2)
print(free + '\t' + str(len(holds)) + '\t' + json.dumps(sorted(identities), separators=(',', ':')) + '\t' + json.dumps(sorted(checkout_paths), separators=(',', ':')))
PY
  ) || rc=$?
  [ "$rc" -eq 0 ] || return "$rc"
  IFS=$'\t' read -r BUILD_SLOT BUILD_ACTIVE_COUNT REQUEST_CHECKOUTS REQUEST_CHECKOUT_PATHS <<<"$selection"
}

build_mark_peak() {
  python3 - "$LOCKS" "$1" <<'PY'
import os, sys, tempfile
root, current = sys.argv[1:]
holds = []
for id in ('heavy-build', 'heavy-build-2', 'heavy-build-3'):
    directory = os.path.join(root, id + '.d')
    try:
        with open(os.path.join(directory, 'info')) as stream:
            value = dict(line.rstrip('\n').split('\t', 1) for line in stream if '\t' in line)
    except FileNotFoundError: continue
    holds.append((id, directory, value))
for id, directory, value in holds:
    try: previous = int(value.get('peak_concurrent', '1'))
    except ValueError: previous = 1
    value['peak_concurrent'] = str(max(previous, len(holds)))
    if id == current: value['build_committed'] = '1'
    try:
        fd, temporary = tempfile.mkstemp(prefix='.peak.', dir=directory)
        with os.fdopen(fd, 'w') as stream:
            for key, item in value.items(): stream.write(key + '\t' + item + '\n')
        os.replace(temporary, os.path.join(directory, 'info'))
    except FileNotFoundError: pass
PY
}

build_usage() {
  cat <<'EOF'
res take-build --by <session> --project <slug> --for "<purpose>" [take options] [--lane heavy-lane-1|2|3] [--checkout <path|resource>]
res take-build --wait --by <session> --project <slug> --for "<purpose>" --timeout <minutes> [take options] [--lane <id>] [--checkout <path|resource>]
res wait-build --by <session> --project <slug> --for "<purpose>" --timeout <minutes> [take options] [--lane <id>] [--checkout <path|resource>]
res wait-lane --by <session> --project <slug> --for "<purpose>" --timeout <minutes> [take options]
res return-build --by <session> [--pid <holder-pid>] [--note "<text>"]
