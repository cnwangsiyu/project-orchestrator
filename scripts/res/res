}

cmd_take() {
  local id="${1:-}" ALLOW_PID=1; shift || true
  registry_record "$id" || die "unknown resource '$id'"
  parse "$@"
  [ -n "$BY" ] && [ -n "$PROJECT" ] && [ -n "$PURPOSE" ] || die "take needs --by, --project and --for"
  validate_pid
  if [ "$REG_KIND" = remote ] && [ "$REG_DEVICE" = - ] && [ "${POOL_ACQUIRE:-0}" != 1 ]; then
    local POOL_NEED= prefer_host= prefer_slot= excluded_slots= excluded_hosts=
    pool_controller take "$id" 0 0
    return $?
