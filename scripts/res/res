    def matching_size(options, free):
        assigned = {}
        def assign(index, seen):
            for id in sorted(options[index] & free):
                if id in seen: continue
                seen.add(id)
                if id not in assigned or assign(assigned[id], seen): assigned[id] = index; return True
            return False
        for index in range(len(options)): assign(index, set())
        return len(assigned)
    def fifo_allows(id, state, claimed=False):
