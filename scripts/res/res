            with admission():
                directory = os.path.join(locks, id + '.d')
                if os.path.isdir(directory) or action == 'wait' and (not eligible(id) or quarantined(id, state)): continue
                if not fifo_allows(id, state):
                    blocked = True; heads = waiting()
                    continue
                if box:
                    reason, *_ = evaluate(id, box, can_override())
                    if not gate_open(reason): continue
                if waiter:
                    refresh_waiter()
                previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, (signal.SIGINT, signal.SIGTERM, signal.SIGHUP))
                try:
                    try: os.mkdir(directory)
                    except FileExistsError: continue
                    created = (directory, os.open(directory, os.O_RDONLY | os.O_DIRECTORY))
                finally: signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
                hold = dict(by=by, project=project, task=task, **{'for': purpose}, since=datetime.datetime.now().strftime('%Y-%m-%d %H:%M'),
                            until=until, pid=str(pid), host=host, start=str(int(time.time())), pool_controller=controller_key)
                if not alive(pid): hold['pid_warning'] = 'short-lived pid'
                publish(directory, hold)
                description = rows[id][3]
            scratch = os.path.realpath(root) != os.path.realpath(os.path.expanduser('~/.claude/orchestrator/_shared'))
            inject = os.environ.get('RES_TEST_POOL_REJECT', '') if scratch else ''
            check_log = os.environ.get('RES_TEST_POOL_CHECK_LOG', '') if scratch else ''
            if check_log:
                with open(check_log, 'a') as stream: stream.write(id + '\n')
            if inject == 'error': raise ValueError('injected health read failure after reservation')
            if inject == 'expire' and waiter:
                own['heartbeat'] = '1'; publish(waiter, own)
            barrier = os.environ.get('RES_TEST_POOL_CLAIM_BARRIER', '') if scratch else ''
            if barrier:
                with open(os.path.join(barrier, controller), 'w'): pass
                while not os.path.exists(os.path.join(barrier, 'release')): time.sleep(0.02)
            # Recheck the current registry, health, and FIFO after the atomic claim.
            with admission(), host_guard(box):
                state = health()
                rejected = False
                if action == 'wait':
                    rows, remote = read_registry()
                    rejected = not eligible(id) or rows[id][3] != description or quarantined(id, state)
                    refresh_waiter()
                elif box:
                    rows, remote = read_registry()
                    rejected = (id not in rows or rows[id][3] != description or rows[id][1] == 'never'
                                or rows[id][1] == 'ask-user' and not force)
                if box: dynamic = dynamic_config()
                permitted = not rejected and fifo_allows(id, state, claimed=True)
                if not rejected and not permitted: blocked = True; heads = waiting()
                if rejected or not permitted or inject == 'all':
                    rollbacks += int(rollback())
                    if rollbacks >= 3:
                        last_order = max((int(order) for order, _, _ in waiting() if order.isdecimal()), default=0)
                        own['order'] = '%020d' % max(time.time_ns(), last_order + 1)
                        own['blocked'] = 'rollback'; refresh_waiter()
                        log('waiter-yield', request + '-any', by + ' (' + project + ('/' + task if task else '') + ')', 'rollbacks=3')
                        print("res: yielding pool '%s' (FIFO) after 3 candidate rollbacks" % request, file=sys.stderr)
                        break
                    continue
                if box:
                    reason, detail, entries, cost, current = evaluate(id, box, can_override(), claimed=True)
                    if not gate_open(reason):
                        rollback()
                        continue
                    if cost: reserve(box, entries, current, cost)
                    if cost or floating(id): log('gate-admit', id, holder, 'reason=' + reason + ' ' + detail)
            log('take', id, by + ' (' + project + ('/' + task if task else '') + ')', purpose + (' · until ' + until if until else ''))
            print('took ' + id)
            print_notes(id)
            if action == 'wait':
                log('waiter-acquire', request + '-any', by + ' (' + project + ('/' + task if task else '') + ')', 'slot=' + id)
                remove_waiter(); print('slot=' + id)
            committed = True; sys.exit(0)
    if action == 'take':
        hold = info(os.path.join(locks, request + '.d'))
        if blocked: print("res: '%s': reserved for waiting pool %s (FIFO); retry or use wait-pool" % (request, heads[0][2].get('holder', '?') if heads else '?'), file=sys.stderr)
        elif gate_reasons:
            reason = next(iter(gate_reasons))
            print("res: '%s': devbox gate %s" % (request, reason), file=sys.stderr)
            if reason.startswith('closed-'): sys.exit(3)
        else: print("res: '%s' is held by %s (pid=%s, since=%s)" % (request, hold.get('by', '?'), hold.get('pid', '?'), hold.get('since', '?')), file=sys.stderr)
        sys.exit(2)
    heads = waiting()
    if 'load' in gate_reasons and heads and current_waiter(heads[0][1], heads[0][2]):
        own.setdefault('load_blocked_since', str(time.time()))
    else:
        own.pop('load_blocked_since', None)
    own['blocked'] = ('memory' if 'memory' in gate_reasons else 'load' if 'load' in gate_reasons else
                      'FIFO' if blocked else own.get('blocked', 'slot'))
    refresh_waiter()
    remaining = float(own['started_at']) + float(timeout) * 60 - time.time()
    if remaining <= 0:
        log('waiter-timeout', request + '-any', by + ' (' + project + ('/' + task if task else '') + ')', 'after ' + timeout + ' minutes')
        remove_waiter(); print("res: timed out waiting for pool '%s' after %s minutes" % (request, timeout), file=sys.stderr); sys.exit(2)
    wait = min(float(delay), remaining)
    print("res: waiting for pool '%s' (FIFO); retry in %ss" % (request, '%g' % wait), file=sys.stderr, flush=True)
    scratch = os.path.realpath(root) != os.path.realpath(os.path.expanduser('~/.claude/orchestrator/_shared'))
    if scratch:
        mark = os.environ.get('PAUSE_MARK', '') if float(delay) == 1 else os.environ.get('SECOND_MARK', os.environ.get('PAUSE_ON_SECOND', '')) if float(delay) == 2 else ''
        if mark:
            with open(mark, 'w'): pass
            while not os.path.exists(mark + '.release'):
                time.sleep(0.02)
            refresh_waiter()
        if os.environ.get('RES_TEST_POOL_FAST_POLL') == '1': wait = min(wait, 0.03)
    time.sleep(wait); sys.exit(6)
except (OSError, ValueError, TypeError, KeyError) as error:
    label = 'box health' if action == 'box-health' else 'pool'
    print('res: ' + label + ': ' + str(error), file=sys.stderr); sys.exit(1)
finally:
    if not committed: rollback()
    elif created: os.close(created[1])
    if sys.exc_info()[0] is not None and not (isinstance(sys.exc_info()[1], SystemExit) and sys.exc_info()[1].code == 6): remove_waiter()
PY
}


cmd_wait_pool() {
  local pool="${1:-}"; shift || true; pool="${pool%-}"
  [[ "$pool" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "wait-pool needs a resource prefix"
  local timeout= args=() ALLOW_PID=1 prefer_host= prefer_slot= POOL_NEED= excluded_slots= excluded_hosts= delay=1 rc POOL_CHILD_PID=
  local POOL_EPISODE="$RANDOM.$RANDOM.$RANDOM"
  local POOL_PENDING_SIGNAL=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout|--need|--prefer-host|--prefer-slot|--exclude-slot|--exclude-host)
        [ $# -ge 2 ] || die "$1 needs a value"
        case "$1" in
          --timeout) [ -z "$timeout" ] || die "duplicate --timeout"; timeout="$2" ;;
          --need) POOL_NEED="$2" ;;
          --prefer-host) prefer_host="$2" ;;
          --prefer-slot) prefer_slot="$2" ;;
          --exclude-slot) excluded_slots="$2" ;;
          --exclude-host) excluded_hosts="$2" ;;
        esac; shift 2 ;;
      --by|--project|--for|--task|--until|--note|--pid)
        [ $# -ge 2 ] || die "$1 needs a value"; args+=("$1" "$2"); shift 2 ;;
      --force|--offline) args+=("$1"); shift ;;
      *) die "unknown option '$1'" ;;
    esac
  done
  [[ "$timeout" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "wait-pool needs --timeout <non-negative minutes>"
  parse ${args[@]+"${args[@]}"}; validate_pid
  [ -n "$BY" ] && [ -n "$PROJECT" ] && [ -n "$PURPOSE" ] || die "wait-pool needs --by, --project and --for"
  pool_cancel() {
    local code="$1"
    [ "$POOL_PENDING_SIGNAL" -eq 0 ] || code="$POOL_PENDING_SIGNAL"
    trap '' INT TERM HUP
    [ -z "$POOL_CHILD_PID" ] || kill -s "$2" "$POOL_CHILD_PID" 2>/dev/null || true
    [ -z "$POOL_CHILD_PID" ] || wait "$POOL_CHILD_PID" 2>/dev/null || true
    pool_controller cancel "$pool" 0 0 >/dev/null
    trap - EXIT
    exit "$code"
  }
  trap 'pool_controller cleanup "$pool" 0 0 >/dev/null' EXIT
  trap 'pool_cancel 130 INT' INT
  trap 'pool_cancel 143 TERM' TERM
  trap 'pool_cancel 129 HUP' HUP
  while :; do
    POOL_PENDING_SIGNAL=0
    trap '[ "$POOL_PENDING_SIGNAL" -ne 0 ] || POOL_PENDING_SIGNAL=130' INT
    trap '[ "$POOL_PENDING_SIGNAL" -ne 0 ] || POOL_PENDING_SIGNAL=143' TERM
    trap '[ "$POOL_PENDING_SIGNAL" -ne 0 ] || POOL_PENDING_SIGNAL=129' HUP
    POOL_EXEC_CHILD=1 pool_controller wait "$pool" "$timeout" "$delay" & POOL_CHILD_PID=$!
    trap 'pool_cancel 130 INT' INT
    trap 'pool_cancel 143 TERM' TERM
    trap 'pool_cancel 129 HUP' HUP
    case "$POOL_PENDING_SIGNAL" in 130) pool_cancel 130 INT ;; 143) pool_cancel 143 TERM ;; 129) pool_cancel 129 HUP ;; esac
    if wait "$POOL_CHILD_PID"; then rc=0; else rc=$?; fi
    POOL_CHILD_PID=
    [ "$rc" -eq 6 ] || { trap - EXIT INT TERM HUP; return "$rc"; }
    delay=$((delay * 2)); [ "$delay" -le 15 ] || delay=15
  done
}


registry_record() {
  local wanted="$1" id
  if [[ "$wanted" =~ ^heavy-build-[23]$ ]] && [ "${BUILD_SLOT_INTERNAL:-0}" = 1 ]; then wanted=heavy-build; fi
  REG_KIND= REG_POLICY= REG_DEVICE= REG_DESCRIPTION=
  while IFS=$'\t' read -r id REG_KIND REG_POLICY REG_DEVICE REG_DESCRIPTION; do
    [ "$id" != "$wanted" ] || return 0
  done <"$REG"
  return 1
}

cmd_return_build() {
  local ALLOW_PID=1 id owner selected_pid options=() BUILD_SLOT_INTERNAL=1; parse "$@"
  [ -n "$BY" ] || die "return-build needs --by"
  [ -z "$PID_EXPLICIT" ] || validate_pid
  [ -z "$FORCE$PROJECT$PURPOSE$TASK$UNTIL$OFFLINE$DEVICE$POLICY" ] || die "return-build accepts only --by, --pid and --note"
  options=(--by "$BY" --note "$NOTE")
  owner="$BY"; selected_pid="${PID_EXPLICIT:+$PID}"
  for id in heavy-lane-3 heavy-lane-2 heavy-lane-1 heavy-build-3 heavy-build-2 heavy-build; do
    [ "$(field "$id" by)" = "$owner" ] || continue
    [ -z "$selected_pid" ] || [ "$(field "$id" pid)" = "$selected_pid" ] || continue
    cmd_return "$id" "${options[@]}"
  done
}

# Preserve the mkdir verdict through a signal before the shell can set its
# ownership flag. Only new transactions use this; legacy take is unchanged.
transaction_mkdir() {
  local rc=0
  trap '[ "$TRANSACTION_PENDING_SIGNAL" -ne 0 ] || TRANSACTION_PENDING_SIGNAL=130' INT
  trap '[ "$TRANSACTION_PENDING_SIGNAL" -ne 0 ] || TRANSACTION_PENDING_SIGNAL=143' TERM
  trap '[ "$TRANSACTION_PENDING_SIGNAL" -ne 0 ] || TRANSACTION_PENDING_SIGNAL=129' HUP
  (trap '' INT TERM HUP; mkdir "$1" 2>/dev/null) || rc=$?
  [ "$rc" -ne 0 ] || TAKE_CREATED=1
  arm_transaction_signals
  [ "$TRANSACTION_PENDING_SIGNAL" -eq 0 ] || transaction_signal "$TRANSACTION_PENDING_SIGNAL"
  return "$rc"
}

take_mkdir() {
  if [ "${TAKE_TRANSACTION:-0}" = 1 ]; then transaction_mkdir "$1"
  else mkdir "$1" 2>/dev/null; fi
}

pool_report() {
  local BY= PROJECT= TASK= PURPOSE= PID="$PPID" UNTIL= FORCE= POOL_NEED= prefer_host= prefer_slot= excluded_slots= excluded_hosts=
  pool_controller "$1" "${2:-}" 0 0
}

cmd_status() {
  [ -f "$REG" ] || die "no registry at $REG"
  local scan_id scan_kind scan_policy scan_device scan_description devices=0
  while IFS=$'\t' read -r scan_id scan_kind scan_policy scan_device scan_description; do
    [ -z "${1:-}" ] || [ "$scan_id" = "$1" ] || continue
    [ "$scan_device" = - ] || [ -z "$scan_id" ] || [[ "$scan_id" = \#* ]] || devices=1
  done <"$REG"
  if [ "$devices" -eq 0 ]; then
    pool_report status "${1:-}"
    return $?
  fi
  # A status of one checkout needs no device probe. One awk renders everything: a fork per
  # field and row cost ~1.5 s.
  if [ -z "${1:-}" ] || [ "$(reg_line "$1" | cut -f4)" != - ]; then probe; fi
  local infos=() t pid_snapshot=0; t=$(mktemp); printf '%s\n' "$DEVS" >"$t"
  ps -axo pid= >"$t.pids" 2>/dev/null && pid_snapshot=1
  for f in "$LOCKS"/*.d/info; do [ -f "$f" ] && infos+=("$f"); done
  awk -F'\t' -v only="${1:-}" -v host="$(local_host)" -v pid_snapshot="$pid_snapshot" -v epoch="$(date +%s)" '
    function state(dev,   i, l) {
      if (dev == "-") return "-"
      for (i = 1; i <= nd; i++) if (index(D[i], dev " (")) {
        l = D[i]; sub(/.*\((UDID|ADB|USBMUX)\) +/, "", l); sub(/  .*/, "", l)
        return (l ~ /^available/ || l == "device") ? "connected" : (l == "" ? "not seen" : l)
      }
      return "not seen"
    }
    FILENAME == devs { D[++nd] = $0; next }
    FILENAME == pids { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0); P[$0] = 1; next }
    FILENAME != reg { n = split(FILENAME, a, "/"); id = a[n-1]; sub(/\.d$/, "", id); if (id ~ /^heavy-build-[23]$/) id = "heavy-build"; H[id, $1] = $2; held[id] = 1; next }
    /^#/ || $1 == "" { next }
    { known[$4] = 1 }
    only != "" && $1 != only { next }
    !hdr++ { printf "%-16s %-9s %-9s %-12s %-34s %s\n", "ID", "KIND", "POLICY", "LINK", "HOLDER", "SINCE → UNTIL / PURPOSE" }
    {
      if ($1 in held) {
        t = H[$1, "task"]; u = H[$1, "until"]
        holder = H[$1, "by"] " (" H[$1, "project"] (t != "" ? "/" t : "") ")"
        pid = H[$1, "pid"]
        if (pid_snapshot && H[$1, "host"] == host && pid ~ /^[0-9]+$/ && pid + 0 > 0 && !(pid in P)) {
          start = H[$1, "start"]
          short_pid = H[$1, "pid_warning"] != "" || (start ~ /^[0-9]+$/ && epoch >= start && epoch - start <= 5)
          holder = (short_pid ? "STALE?(short-lived pid) " : "STALE ") holder
          if (short_pid) fix = 1
        }
        detail = H[$1, "since"] " → " (u != "" ? u : "?") " · " H[$1, "for"]
      } else { holder = "FREE"; detail = $5 }
      printf "%-16s %-9s %-9s %-12s %-34s %s\n", $1, $2, $3, state($4), holder, detail
    }
    END {
      if (fix) print "res: short-lived holder PID; use scripts/heavy-build.sh <command...>; lock, build and return must share one long-lived process" > "/dev/stderr"
      if (only != "") exit
      for (i = 1; i <= nd; i++) {
        l = D[i]; id = ""
        if (match(l, /^[^ ]+ \((USBMUX|ADB)\) device$/)) { id = l; sub(/ .*/, "", id); src = (l ~ /ADB/) ? "ADB" : "USBMUX" }
        else if (l ~ /\(UDID\) +(available|connected).*physical/) { id = l; sub(/ \(UDID\).*/, "", id); sub(/.* /, "", id); src = "devicectl" }
        if (id != "" && !(id in known) && !(id in seen)) { seen[id] = 1; out = out "  " id " " src "\n" }
      }
      if (out != "") printf "\nConnected but not registered (add with: res add <id> --device <id> --for \"<what it is>\"):\n%s", out
    }
  ' reg="$REG" devs="$t" pids="$t.pids" "$t" "$t.pids" ${infos[@]+"${infos[@]}"} "$REG"
  rm -f "$t" "$t.pids"
  if [ -z "${1:-}" ]; then pool_report scores
  elif [ "$1" = heavy-build ]; then pool_report scores "$1"
  elif registry_record "$1" && [ "$REG_KIND" = remote ]; then pool_report scores "$1"; fi
  if [ -z "${1:-}" ] || [ "${1:-}" = heavy-build ]; then show_build_waiters; fi
  case "${1:-}" in ''|heavy-*) show_build_waiters "$LANE_WAITERS" lanes ;; esac
  local pool_root
  for pool_root in "$POOL_WAITERS"/*; do
    [ -d "$pool_root" ] || continue
    case "${1:-}" in ''|"${pool_root##*/}"|"${pool_root##*/}"-*) show_build_waiters "$pool_root" "pool ${pool_root##*/}" ;; esac
  done
  [ -z "${1:-}" ] || show_notes "$1"
}

cmd_add() {
  local id="${1:-}"; shift || true; parse "$@"
  [ -n "$id" ] && [ -n "$DEVICE" ] && [ -n "$PURPOSE" ] || die "add needs <id>, --device and --for"
  case "$id" in *[!A-Za-z0-9_.-]*) die "id may use letters, digits, . _ - only" ;; esac
  [ -z "$(reg_line "$id")" ] || die "'$id' already exists"
  [ "$DEVICE" = - ] || ! awk -F'\t' -v d="$DEVICE" '$4==d{f=1} END{exit !f}' "$REG" || die "device $DEVICE is already registered"
  POLICY="${POLICY:-ask-user}"
  case "$POLICY" in open|ask-user|never) ;; *) die "policy must be open, ask-user or never" ;; esac
  local kind=device; [ "$DEVICE" = - ] && kind=checkout
  printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$kind" "$POLICY" "$DEVICE" "$PURPOSE" >>"$REG"
  log add "$id" "${BY:-?}" "$POLICY · $DEVICE · $PURPOSE"
  echo "added $id ($kind, $POLICY)"
}

cmd_take() {
  local id="${1:-}" ALLOW_PID=1; shift || true
  registry_record "$id" || die "unknown resource '$id'"
  parse "$@"
  [ -n "$BY" ] && [ -n "$PROJECT" ] && [ -n "$PURPOSE" ] || die "take needs --by, --project and --for"
  validate_pid
  if [ "$REG_KIND" = remote ] && [ "$REG_DEVICE" = - ] && [ "${POOL_ACQUIRE:-0}" != 1 ]; then
    local POOL_NEED= prefer_host= prefer_slot= excluded_slots= excluded_hosts=
    pool_controller take "$id" 0 0
    return $?
  fi
  local policy="$REG_POLICY" dev="$REG_DEVICE" link
  case "$policy" in
    never) echo "res: '$id' is off limits (policy never): $REG_DESCRIPTION" >&2; exit 3 ;;
    ask-user) [ -n "$FORCE" ] || { echo "res: '$id' needs the user's OK first (policy ask-user); once given, retry with --force" >&2; exit 3; } ;;
  esac
  case "$id" in heavy-*) (machine_thresholds) || return $? ;; esac
  case "$id" in heavy-*)
    if [ "${TAKE_FRESH_ONLY:-0}" != 1 ] && [ "$(field "$id" by)" = "$BY" ]; then
      echo "already held: $id by $(holder_details "$id")"; show_notes "$id"
      return 0
    fi ;;
  esac
  if [[ "$id" =~ ^heavy-lane-[123]$ ]] || { [[ "$id" =~ ^heavy-build(-[23])?$ ]] && [ "${BUILD_SLOT_INTERNAL:-0}" = 1 ]; }; then
    local reading rc=0 admission=legacy check_args=(--pid "$PID")
    case "$id" in
      heavy-lane-1|heavy-lane-2)
        admission=lane; check_args+=(--admission lane)
        [ "${LOAD_OVERRIDE_ACTIVE:-0}" != 1 ] || check_args+=(--load-override) ;;
      heavy-build|heavy-build-2|heavy-build-3)
        if [ "${BUILD_ACTIVE_COUNT:-0}" -eq 0 ]; then admission=build
        else admission=build-concurrent; fi
        check_args+=(--admission "$admission")
        [ "${LOAD_OVERRIDE_ACTIVE:-0}" != 1 ] || check_args+=(--load-override) ;;
    esac
    reading=$(cmd_heavy_check "${check_args[@]}") || rc=$?
    [ -z "$reading" ] || printf '%s\n' "$reading"
    ATTEMPT_BLOCK_REASON=$(reading_field "$reading" blocked)
    ATTEMPT_POLL_SECONDS=$(reading_field "$reading" poll_seconds)
    ATTEMPT_OVERRIDE_MINUTES=$(reading_field "$reading" override_minutes)
    [ "$rc" -eq 0 ] || return "$rc"
    if [ "$id" = heavy-lane-3 ] && ! lane3_open "$reading"; then
      echo "res: heavy-lane-3 unavailable (see active LANE3_LOAD and LANE3_AVAIL_GIB thresholds above)" >&2
      ATTEMPT_BLOCK_REASON=load
      return 5
    fi
  fi
  if [ "$dev" != - ] && [ -z "$OFFLINE" ] && [ "$(field "$id" by)" != "$BY" ]; then
    probe quick; link=$(conn "$dev")
    [ "$link" = connected ] || { DEVS=; probe; link=$(conn "$dev"); }
    [ "$link" = connected ] || { echo "res: '$id' is not connected ($link) — ask the user to plug in / unlock / trust it; --offline holds it anyway" >&2; exit 4; }
  fi
  local device_evidence=$'adb_device_lines\tunknown\ndevice_clients\tunknown'
  local device_log= device_pid_dead=0 device_probe_rc=0
  if [ "$dev" != - ] && [ ! -d "$LOCKS/$id.d" ]; then
    # Finish both bounded probes before creating a lease. A hung probe can
    # produce unknown evidence, but cannot strand half-published ownership.
    device_evidence=$(device_clients 2>/dev/null) || device_probe_rc=$?
    case "$device_probe_rc" in
      0) ;;
      10) device_pid_dead=1 ;;
      *) device_evidence=$'adb_device_lines\tunknown\ndevice_clients\tunknown' ;;
    esac
  fi
  mkdir -p "$LOCKS"
  if take_mkdir "$LOCKS/$id.d"; then
    TAKE_CREATED=1
    write_info "$(now)" "$id" || return $?
    # Recheck the health snapshot after mkdir; a losing pool transaction unwinds.
    if [ "${POOL_ACQUIRE:-0}" = 1 ]; then
      box_health check "$id" "$POOL_NEED" "$excluded_slots" "$excluded_hosts" || return $?
      # A slow health read may expire/delete our heartbeat. Restore it before
      # the FIFO recheck, or a fresh hold is spuriously returned to younger waiters.
      update_build_waiter slot CLOSED
    fi
    local RESERVED_MESSAGE=
    if lane_reserved_for_waiter "$id"; then
      RESERVED_MESSAGE="reserved for waiting build $RESERVED_WAITER_HOLDER; retry or use wait-lane"
    elif lane_waiter_blocks "$id"; then :
    elif pool_waiter_blocks "$id"; then :; fi
    if [ -n "$RESERVED_MESSAGE" ]; then
      echo "res: '$id': $RESERVED_MESSAGE" >&2
      if [ "${TAKE_TRANSACTION:-0}" = 1 ]; then
        return 2
      fi
      protected_rollback_created "$id" "$BY" || die "failed to yield '$id' to waiter"
      TAKE_CREATED=0
      return 2
    fi
    if [ -n "$PID_EXPLICIT" ]; then
      if { [ "$dev" != - ] && [ "$device_pid_dead" = 1 ]; } || { [ "$dev" = - ] && pid_dead "$PID"; }; then
        warn_holder; mark_holder_warning "$id"
      fi
    fi
    if [ "$dev" != - ]; then
      printf '%s\n' "$device_evidence" >>"$LOCKS/$id.d/info" || true
      device_log=" · $(printf '%s\n' "$device_evidence" | awk -F'\t' '{printf "%s%s=%s", (NR>1 ? " " : ""), $1, $2}')" || device_log=' · device_clients=unknown'
    fi
    log take "$id" "$BY ($PROJECT${TASK:+/$TASK})" "$PURPOSE${UNTIL:+ · until $UNTIL}$device_log"
    echo "took $id"; show_notes "$id"
  # A concurrent same-name wrapper may win after the transaction's precheck.
  # Single-resource take/wait may reuse a hold; build/lane acquisition must own mkdir.
  elif [ "${TAKE_FRESH_ONLY:-0}" != 1 ] && [ "$(field "$id" by)" = "$BY" ]; then
    echo "already held: $id by $(holder_details "$id")"; show_notes "$id"
  else
    echo "res: '$id' is held by $(holder_details "$id") ($(field "$id" project)), until $(field "$id" until | sed 's/^$/?/') — $(field "$id" for)" >&2
    echo "res: message that session (SendMessage; for a codex:<thread> holder, its project's orchestrator) and wait; do not use the resource meanwhile" >&2
    return 2
  fi
}

cmd_extend() {
  local id="${1:-}"; shift || true; need_id "$id"; parse "$@"
  [ -n "$BY" ] && [ -n "$UNTIL" ] || die "extend needs --by and --until"
  [ -d "$LOCKS/$id.d" ] || die "'$id' is not held"
  [ "$(field "$id" by)" = "$BY" ] || die "'$id' is held by $(field "$id" by), not $BY"
  local info="$LOCKS/$id.d/info" tmp; tmp=$(mktemp)
  awk -F'\t' -v u="$UNTIL" 'BEGIN{OFS="\t"} $1=="until"{$2=u} {print}' "$info" >"$tmp" && mv "$tmp" "$info"
  log extend "$id" "$BY" "until $UNTIL"
  echo "extended $id until $UNTIL"
}

cmd_return() {
  local id="${1:-}"; shift || true
  registry_record "$id" || die "unknown resource '$id'"
  parse "$@"
  [ -n "$BY" ] || die "return needs --by"
  if [ "$REG_KIND" = remote ] && [ "$REG_DEVICE" = - ]; then
    local PURPOSE="$NOTE" POOL_NEED= prefer_host= prefer_slot= excluded_slots= excluded_hosts=
    pool_controller return "$id" 0 0
    return $?
  fi
  [ -d "$LOCKS/$id.d" ] || { echo "$id was not held"; return 0; }
  local holder owned_guard=0 build_detail= start peak duration mode; holder=$(field "$id" by)
  case "$id" in heavy-build|heavy-build-2|heavy-build-3)
    if [ "${BUILD_GUARD:-0}" != 1 ]; then
      build_guard_start || { echo "res: build admission is changing; retry return-build" >&2; return 2; }
      owned_guard=1
    fi ;;
  esac
  if [ "$holder" != "$BY" ]; then
    [ -n "$FORCE" ] && [ -n "$NOTE" ] || die "'$id' is held by $holder; only --force --note \"<why>\" may reclaim it"
    log reclaim "$id" "$BY" "from $holder: $NOTE"
  else
    if [[ "$id" =~ ^heavy-build(-[23])?$ ]] && [ "$(field "$id" build_committed)" = 1 ]; then
      start=$(field "$id" start); peak=$(field "$id" peak_concurrent)
      case "$start" in ''|*[!0-9]*) start=0 ;; esac
      case "$peak" in ''|*[!0-9]*) peak=1 ;; esac
      duration=$(( $(date +%s) - start )); [ "$duration" -ge 0 ] || duration=0
      mode=solo; [ "$peak" -le 1 ] || mode=concurrent
      build_detail="build_mode=$mode peak_concurrent=$peak duration_seconds=$duration"
    fi
    log return "$id" "$BY" "$NOTE${build_detail:+${NOTE:+ · }$build_detail}"
  fi
  rm -rf "$LOCKS/$id.d"
  [ "$owned_guard" -eq 0 ] || build_guard_end
  echo "returned $id"
}

show_notes() {
  if [ -s "$NOTES/$1.md" ]; then
    echo; echo "── notes for $1 ($NOTES/$1.md) — read before use ──"; cat "$NOTES/$1.md"
  fi
  case "$1" in
    heavy-*)
      if [ "$1" != heavy-build ] && [ -s "$NOTES/heavy-build.md" ]; then
        echo; echo "── heavy-task protocol ($NOTES/heavy-build.md) — read before use ──"; cat "$NOTES/heavy-build.md"
      fi ;;
  esac
}

cmd_note() {
  local id="${1:-}"; shift || true; need_id "$id"; parse "$@"
  [ -n "$BY" ] && [ -n "$NOTE" ] || die "note needs --by and --note"
  mkdir -p "$NOTES"
  [ -f "$NOTES/$id.md" ] || printf '# %s\n\n' "$(reg_line "$id" | cut -f5)" >"$NOTES/$id.md"
  printf -- '- %s (%s): %s\n' "$(date '+%Y-%m-%d')" "$BY" "$NOTE" >>"$NOTES/$id.md"
  log note "$id" "$BY" "$NOTE"
  echo "noted on $id"
}

cmd_log() { [ -f "$LOG" ] && tail -n "${1:-20}" "$LOG" || true; }

case "${1:-}" in
  status) shift; cmd_status "$@" ;;
  take) shift; cmd_take "$@" ;;
  wait) shift; cmd_wait "$@" ;;
  take-build)
    shift
    if [ "${1:-}" = --wait ]; then shift; cmd_acquire build 1 "$@"
    else cmd_acquire build 0 "$@"; fi ;;
  wait-build) shift; cmd_acquire build 1 "$@" ;;
  wait-lane) shift; cmd_acquire lane 1 "$@" ;;
  wait-pool)
    shift
    cmd_wait_pool "$@"
    # Bash can read more source after a long wait if the executable was overwritten.
    exit 0 ;;
  box-health)
    shift
    [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = --json ]; } || die 'box-health accepts only --json'
    pool_report box-health "${1:-}" ;;
  quarantine|unquarantine|report-infra) box_health "$@" ;;
  return-build) shift; cmd_return_build "$@" ;;
  heavy-check) shift; cmd_heavy_check "$@" ;;
  extend) shift; cmd_extend "$@" ;;
  return) shift; cmd_return "$@" ;;
  add) shift; cmd_add "$@" ;;
  note) shift; cmd_note "$@" ;;
  log) shift; cmd_log "$@" ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 1 ;;
esac
