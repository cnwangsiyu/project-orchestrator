                pools[kind.lower()] = dict(open=sum(remote[id][0] == 'open' and not floating(id) for id in slots),
                    dynamic=sum(remote[id][0] == 'open' and floating(id) for id in slots), never=sum(remote[id][0] == 'never' for id in slots),
                    held=sum(os.path.isdir(os.path.join(locks, id + '.d')) for id in slots),
                    takes24h=sum(counts.get(id, 0) for id in slots))
            caps, prefs = {}, {}
            for id in ids:
                if remote[id][0] != 'open': continue
                for cap in remote[id][2]: caps[cap] = caps.get(cap, 0) + 1
                for pref in remote[id][3]: prefs[pref] = prefs.get(pref, 0) + 1
            takes = sum(counts.get(id, 0) for id in ids)
            warnings = []
            if value['probeStale']: warnings.append('stale or missing host probe; refresh through runner')
            if not value['metricsFresh']: warnings.append('stale or missing admission metrics; static rows only')
            if value['cores'] is None: warnings.append('unknown cores; slot-count ranking fallback')
            shown[box] = dict(**value, pools=pools, caps=dict(sorted(caps.items())), prefer=dict(sorted(prefs.items())),
                takes24h=takes, takeShare=takes / total_takes if total_takes else 0,
                coreShare=(value['cores'] or 0) / total_cores if box in active and total_cores else 0,
                unusedOpen24h=[id for id in ids if remote[id][0] == 'open' and not counts.get(id)],
                neverUsedOpen=[id for id in ids if remote[id][0] == 'open' and id not in ever], warnings=warnings)
        report = dict(at=now, windowHours=24, hosts=shown, miniTakes24h=dict(sorted(mini.items())), gateDenials24h=dict(sorted(denials.items())))
        if request == '--json': print(json.dumps(report, indent=2))
        else:
            print('Read-only scheduler audit: trailing 24 hours; takes are starts, not CPU utilisation')
            for box, value in shown.items():
                print('Host ' + box + ' ' + score_line(value))
                print('  pools=' + json.dumps(value['pools'], sort_keys=True))
                print('  caps=' + json.dumps(value['caps'], sort_keys=True) + ' prefer=' + json.dumps(value['prefer'], sort_keys=True))
                print('  takes24h=%d take_share=%.1f%% core_share=%.1f%% free_disk_gib=%s' % (value['takes24h'], value['takeShare']*100, value['coreShare']*100, value['freeGiB']))
                print('  unused_open_24h=' + ','.join(value['unusedOpen24h']) + ' never_used_open=' + ','.join(value['neverUsedOpen']))
                for warning in value['warnings']: print('  WARNING: ' + warning)
            print('Mini takes24h: ' + json.dumps(report['miniTakes24h'], sort_keys=True))
            print('Gate denials24h: ' + json.dumps(report['gateDenials24h'], sort_keys=True))
        committed = True; sys.exit(0)
