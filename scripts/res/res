        return rows, remote
    rows, remote = read_registry()
    def health():
        try:
            with open(os.path.join(root, 'box-health.json')) as stream: state = json.load(stream)
        except FileNotFoundError: return {}
        if not isinstance(state, dict): raise ValueError('invalid box-health.json')
        for value in state.values():
            if not isinstance(value, dict): raise ValueError('invalid box health entry')
            if not isinstance(value.get('failures', []), list): raise ValueError('invalid failures')
            expiry = value.get('quarantinedUntil', 0)
            if not isinstance(expiry, (int, float)) or not math.isfinite(expiry) or expiry < 0: raise ValueError('invalid quarantine expiry')
            for key in ('manual', 'autoQuarantined'):
                if key in value and not isinstance(value[key], bool): raise ValueError('invalid quarantine flag')
            for failure in value.get('failures', []):
                if not isinstance(failure, dict) or not isinstance(failure.get('at'), (int, float)) or not math.isfinite(failure['at']): raise ValueError('invalid failure timestamp')
        return state
    def number(value):
        return type(value) in (int, float) and -sys.maxsize <= value <= sys.maxsize
    def regular_text(file):
        with os.fdopen(os.open(file, os.O_RDONLY | os.O_NONBLOCK)) as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode): raise ValueError('expected a regular file')
            return stream.read()
    def dynamic_config():
        host_pattern = r'[A-Za-z0-9][A-Za-z0-9.-]*'
        defaults = dict(LOAD_PER_CORE=1, MIN_AVAIL_GIB=4, HEAVY_CORES=3, HEAVY_GIB=4, LIGHT_CORES=1, LIGHT_GIB=2)
        values = {}
        try:
            content = regular_text(os.path.join(root, 'machine.conf'))
            if not content.endswith('\n'): return {}
            for line in content.splitlines():
                key, _, value = (part.strip() for part in line.partition('='))
                if not key.startswith('DEVBOX_'): continue
                if key in values: return {}
                if key == 'DEVBOX_DYNAMIC_ADMISSION' and value in ('0', '1'):
                    values[key] = value
                elif key == 'DEVBOX_DYNAMIC_HOSTS' and (not value or re.fullmatch(host_pattern + '(,' + host_pattern + ')*', value)):
                    values[key] = value
                else:
                    setting, _, suffix = key[7:].partition('.')
                    if setting not in defaults or suffix and not re.fullmatch(host_pattern, suffix): return {}
                    if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)?', value) or not 0 < float(value) <= 65536: return {}
                    values[key] = float(value)
        except (OSError, ValueError): return {}
        if values.get('DEVBOX_DYNAMIC_ADMISSION') != '1': return {}
        return {box: {key: values.get('DEVBOX_' + key + '.' + box, values.get('DEVBOX_' + key, default))
                      for key, default in defaults.items()}
                for box in values.get('DEVBOX_DYNAMIC_HOSTS', '').split(',') if box}
    def slot_type(id):
        if re.fullmatch(r'devbox-cn-[0-9]+', id): return 'HEAVY'
        if re.fullmatch(r'devbox-cn-light(?:-[0-9]+)?', id): return 'LIGHT'
    def floating(id):
        return id in rows and 'dynamic-only' in rows[id][3].split()
    def host_slots(box, kind):
        return {id: member[0] for id, member in remote.items() if member[1] == box and slot_type(id) == kind}
    def static_full(box, kind, own_slot=None):
        slots = host_slots(box, kind)
        if not any(floating(id) for id in slots): return False
        cap = sum(policy == 'open' and not floating(id) for id, policy in slots.items())
        held = sum(id != own_slot and os.path.isdir(os.path.join(locks, id + '.d')) for id in slots)
        return held >= cap
    metrics_dir = os.path.join(root, 'devbox-metrics')
    reserve_dir = os.path.join(root, 'devbox-reservations')
    def sample(box, current):
        try:
            value = json.loads(regular_text(os.path.join(metrics_dir, box + '.json')))
            if (isinstance(value, dict) and all(number(value.get(key)) for key in ('at', 'cores', 'load5', 'memAvailableGiB'))
                    and 0 <= current - value['at'] < 300 and value['cores'] > 0 and value['cores'] == int(value['cores'])
                    and min(value['load5'], value['memAvailableGiB']) >= 0):
                return value
        except (OSError, ValueError): pass
        return {}
    def reservations(box, current):
        try:
            values = json.loads(regular_text(os.path.join(reserve_dir, box + '.json')))
        except FileNotFoundError: return []
        # A corrupt reservation ledger must not silently reopen a measured host.
        if not isinstance(values, list) or any(not isinstance(value, list) or len(value) != 3
                or not all(number(item) and item > 0 for item in value) for value in values):
            raise ValueError('invalid devbox reservations for ' + box)
        return [value for value in values if current - value[0] < 300]
    @contextmanager
    def host_guard(box):
        if not box:
            yield
            return
        os.makedirs(reserve_dir, exist_ok=True)
        with open(os.path.join(reserve_dir, box + '.lock'), 'a') as guard:
            fcntl.flock(guard, fcntl.LOCK_EX)
            yield
    def reserve(box, entries, current, cost):
        # Keep recent starts after return as both utilization signals can lag.
        with tempfile.NamedTemporaryFile(mode='w', dir=reserve_dir, delete=False) as stream:
            temp = stream.name
            try:
                json.dump(entries + [[current, *cost]], stream)
                stream.close()
                os.replace(temp, os.path.join(reserve_dir, box + '.json'))
            finally:
                if os.path.exists(temp): os.unlink(temp)
    def gate(box, kind, settings, current, only_dynamic=False, override=False):
        value = sample(box, current) if settings else {}
        entries = reservations(box, current) if settings else []
        cpu, mem = (sum(entry[i] for entry in entries) for i in (1, 2))
        cost = (settings[kind + '_CORES'], settings[kind + '_GIB']) if settings else None
        detail = 'host=%s load5=%s reserved_cores=%g reserved_gib=%g mem_available_gib=%s' % (
            box, value.get('load5', '?'), cpu, mem, value.get('memAvailableGiB', '?'))
        if not value:
            reason = 'stale-or-missing-metrics' if settings else 'disabled'
            return ('closed-' if only_dynamic else 'static-') + reason, detail, entries, cost
        limit = value['cores'] * settings['LOAD_PER_CORE']
        floor = settings['MIN_AVAIL_GIB']
        detail += ' load_limit=%g mem_floor_gib=%g task_cores=%g task_gib=%g' % (limit, floor, *cost)
        if value['memAvailableGiB'] - mem - cost[1] < floor: return 'memory', detail, entries, cost
        if value['load5'] + cpu + cost[0] > limit:
            return 'load-override' if override else 'load', detail, entries, cost
        return 'headroom', detail, entries, cost
    def gate_open(reason):
        return reason in ('headroom', 'load-override', 'static-disabled', 'static-stale-or-missing-metrics')
    dynamic = dynamic_config()
    def capacity(hosts):
        try:
            with open(os.path.join(root, 'devbox-hosts.json')) as stream: probes = json.load(stream)
            if not isinstance(probes, dict): probes = {}
        except (OSError, ValueError): probes = {}
        fallback = {}
        held = dict.fromkeys(hosts, 0)
        for id, (_, box, _, _) in remote.items():
            if box not in held: continue
            match = re.search(r'(?:^|\s)cores=([0-9]{1,19})(?=\s|$)', rows[id][3])
            if match:
                cores = int(match.group(1))
                if 0 < cores <= sys.maxsize: fallback.setdefault(box, cores)
            if os.path.isdir(os.path.join(locks, id + '.d')): held[box] += 1
        result = {}
        for box in hosts:
            probe = probes.get(box, {})
            if not isinstance(probe, dict): probe = {}
            try:
                when = datetime.datetime.fromisoformat(probe.get('probedAt', '').replace('Z', '+00:00'))
                fresh = when.tzinfo is not None and 0 <= now - when.timestamp() <= 86400
            except (AttributeError, TypeError, ValueError, OverflowError): fresh = False
            cores = probe.get('cores') if fresh else None
            cores = int(cores) if number(cores) and cores > 0 and cores == int(cores) else fallback.get(box, 8)
            free = probe.get('freeGiB') if fresh else None
            result[box] = dict(cores=cores, heldSlots=held[box], score=held[box] / cores,
                               nextScore=(held[box] + 1) / cores, freeGiB=free if number(free) and free >= 0 else None)
        return result
    def warm_slots(project, remote):
        try:
            with open(os.path.join(root, 'devbox-affinity.json')) as stream: affinities = json.load(stream)
            if not isinstance(affinities, dict): return {}
        except (OSError, ValueError): return {}
        # Match devbox-run's project identity and its default identity+branch keys.
        identity = project if re.fullmatch(r'id-[a-f0-9]{64}', project) else 'id-' + hashlib.sha256(('project:' + project).encode()).hexdigest()
        warm = {}
        for key, value in affinities.items():
            if not key.startswith(identity + '+') or not isinstance(value, dict): continue
            slot = value.get('slot')
            if not isinstance(slot, str) or slot not in remote or value.get('host') != remote[slot][1]: continue
            try:
                stamp = datetime.datetime.fromisoformat(value.get('time', '').replace('Z', '+00:00'))
                used = stamp.timestamp()
                if stamp.tzinfo is None or not math.isfinite(used) or used <= 0 or used > now: continue
            except (AttributeError, TypeError, ValueError, OverflowError): continue
            warm[slot] = max(warm.get(slot, 0), used)
        return warm
