    if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)?',extra_disk_gib) or float(extra_disk_gib)>65536: raise ValueError('invalid extra disk GiB')
    input_placement = None
    if placement_file:
        input_placement = json.loads(regular_text(placement_file))
        if (not isinstance(input_placement, dict) or input_placement.get('version') != 1
                or not number(input_placement.get('at')) or not 0 <= time.time()-input_placement['at'] < 180
                or not isinstance(input_placement.get('slots'), dict)):
            raise ValueError('invalid or stale input placement file')
        for value in input_placement['slots'].values():
            if (not isinstance(value, dict) or type(value.get('eligible')) is not bool
                    or not all(number(value.get(key)) and 0 <= value[key] <= 1e9 for key in ('waitSec','rebuildSec','extraDiskGiB'))
                    or not isinstance(value.get('hardReasons'), list)):
                raise ValueError('invalid input placement score')
    if input_placement:
        for id, box in dynamic_ids.items():
            if id in input_placement['slots']: continue
            template = next((v for slot,v in input_placement['slots'].items() if slot in remote and remote[slot][1] == box), None)
            if template: input_placement['slots'][id] = dict(template)
    def gate(box, kind, settings, current, only_dynamic=False, override=False, id=None, weights=None, claimed=False):
        value = sample(box, current) if settings else {}
        entries = reservations(box, current) if settings else []
        if claimed: entries = [entry for entry in entries if len(entry) < 5 or entry[4]['slot'] != id]
        recent = [entry for entry in entries if current - entry[0] < 300 or len(entry) == 5 and entry[4]['slot'] in dynamic_ids]
        cpu, mem = (sum(entry[i] for entry in recent) for i in (1, 2))
        disk = sum(entry[3] for entry in entries if len(entry) >= 4)
        cost = (settings[kind + '_CORES'], settings[kind + '_GIB'],
                float(disk_gib) if disk_gib else disk_costs.get(id,
                    settings['project_disk'][kind] or settings[kind + '_DISK_GIB'])) if settings else None
        if cost: cost=(float(claim_cores) if claim_cores else cost[0], float(claim_mem) if claim_mem else cost[1], cost[2]+float(extra_disk_gib))
        if cost and weights is not None: cost=weights
        if cost and input_placement and weights is None:
            extra = input_placement['slots'].get(id, {}).get('extraDiskGiB', 0)
            cost = (*cost[:2], cost[2] + extra)
        if cost and maintenance: cost = (*cost[:2], 0)
        detail = 'host=%s load5=%s reserved_cores=%g reserved_gib=%g mem_available_gib=%s' % (
            box, value.get('load5', '?'), cpu, mem, value.get('memAvailableGiB', '?'))
        detail += ' free_disk_gib=%s reserved_disk_gib=%g' % (value.get('freeGiB', '?'), disk)
        some = io_reading(value, 'io_some_avg60')
        full = io_reading(value, 'io_full_avg10')
        detail += ' io_some_avg60=%s io_full_avg10=%s io=%s' % (
            some if some is not None else '?', full if full is not None else '?',
            'unknown' if some is None or full is None else 'known')
        if not value:
            reason = 'stale-or-missing-metrics' if settings else 'disabled'
            return ('closed-' if only_dynamic else 'static-') + reason, detail, entries, cost
        if box in host_rows:
            ceiling = int(settings['MAX_CLAIMS']) or max(1, int(value['cores'] / min(settings['HEAVY_CORES'], settings['LIGHT_CORES'])))
            occupied = sum(os.path.isdir(os.path.join(locks, slot + '.d')) for slot, member in remote.items() if member[1] == box and not slot.startswith('devbox-host-') and (not claimed or slot != id))
            if occupied >= ceiling: return 'max-claims', detail + ' max_claims=' + str(ceiling), entries, cost
        limit = value['cores'] * settings['LOAD_PER_CORE']
        floor = settings['MIN_AVAIL_GIB']
        detail += ' load_limit=%g mem_floor_gib=%g task_cores=%g task_gib=%g task_disk_gib=%g disk_floor_gib=53' % (limit, floor, *cost)
        if (kind == 'HEAVY' or box in host_rows) and io_closed(box, value, settings): return 'io-pressure', detail, entries, cost
        reason = headroom(value['load5'], value['memAvailableGiB'], value['freeGiB'],
                          (cpu, mem, disk), cost, limit, floor, float('-inf') if maintenance else 53)
        if reason == 'load' and override: reason = 'load-override'
        return 'headroom' if reason == 'open' else reason, detail, entries, cost
    def gate_open(reason):
        return reason in ('headroom', 'load-override', 'static-disabled', 'static-stale-or-missing-metrics')
    dynamic, light_reclaim, soft_minutes = devbox_settings()
    if action == 'reserved-disk':
        if request not in remote or not slot_type(request): raise ValueError('expected a registered devbox lease')
        entries = reservations(remote[request][1], time.time())
        print(json.dumps(dict(reservedGiB=sum(entry[3] for entry in entries if len(entry) >= 4))))
        committed = True; sys.exit(0)
    if action == 'pool-capacity':
        if request not in ('devbox-cn', 'devbox-cn-light'): raise ValueError('unsupported capacity pool')
        kind = 'LIGHT' if request == 'devbox-cn-light' else 'HEAVY'
        result = {}
        for box in host_rows:
            if rows[host_rows[box]][1] != 'open' or 'leases-only' in rows[host_rows[box]][3].split():
                result[box]=dict(claims=0,gate='resolver-only-or-policy'); continue
            settings = dynamic.get(box); current=time.time()
            reason, _, entries, cost = gate(box, kind, settings, current, True)
            value = sample(box,current)
            count = 0
            if reason == 'headroom':
                recent = [entry for entry in entries if current-entry[0] < 300 or len(entry)==5 and entry[4]['slot'] in dynamic_ids]
                cpu=sum(entry[1] for entry in recent); mem=sum(entry[2] for entry in recent)
                disk=sum(entry[3] for entry in entries if len(entry)>=4)
                maximum=int(settings['MAX_CLAIMS']) or max(1,int(value['cores']/min(settings['HEAVY_CORES'],settings['LIGHT_CORES'])))
                held=sum(os.path.isdir(os.path.join(locks,id+'.d')) for id,member in remote.items() if member[1]==box and not id.startswith('devbox-host-'))
                count=max(0,min(math.floor((value['cores']*settings['LOAD_PER_CORE']-value['load5']-cpu)/cost[0]),
                                math.floor((value['memAvailableGiB']-mem-settings['MIN_AVAIL_GIB'])/cost[1]),
                                math.floor((value['freeGiB']-disk-53)/cost[2]) if cost[2] else maximum,
                                maximum-held))
            result[box]=dict(claims=count,gate=reason)
        print(json.dumps(json_safe(result),allow_nan=False)); committed=True; sys.exit(0)
    def capacity(hosts):
        try:
            with open(os.path.join(root, 'devbox-hosts.json')) as stream: probes = json.load(stream)
            if not isinstance(probes, dict): probes = {}
        except (OSError, ValueError): probes = {}
        fallback = {}
        held = dict.fromkeys(hosts, 0)
        for id, (_, box, _, _) in remote.items():
            if box not in held: continue
            match = re.search(r'(?:^|\s)cores=([0-9]{1,19})(?=\s|$)', rows[id][3])
            if match:
                cores = int(match.group(1))
                if 0 < cores <= sys.maxsize: fallback.setdefault(box, cores)
            if os.path.isdir(os.path.join(locks, id + '.d')): held[box] += 1
        result = {}
        for box in hosts:
            probe = probes.get(box, {})
            if not isinstance(probe, dict): probe = {}
            age = None
            try:
                when = datetime.datetime.fromisoformat(probe.get('probedAt', '').replace('Z', '+00:00'))
                age = now - when.timestamp() if when.tzinfo is not None else None
                fresh = age is not None and 0 <= age <= 3600
            except (AttributeError, TypeError, ValueError, OverflowError): fresh = False
            measured = sample(box, now)
            probed_cores = probe.get('cores')
            valid_cores = number(probed_cores) and probed_cores > 0 and probed_cores == int(probed_cores)
            if measured: cores, source = measured['cores'], 'metrics'
            elif fresh and valid_cores: cores, source = int(probed_cores), 'probe'
            elif box in fallback: cores, source = fallback[box], 'tag'
            elif age is not None and age >= 0 and valid_cores: cores, source = int(probed_cores), 'stale-probe'
            else: cores, source = None, 'unknown'
            free = measured.get('freeGiB') if measured else probe.get('freeGiB') if fresh else None
            entries = reservations(box, now) if measured else []
            recent = [entry for entry in entries if now - entry[0] < 300 or len(entry) == 5 and entry[4]['slot'] in dynamic_ids]
            reserved_cpu = sum(entry[1] for entry in recent)
            reserved_mem = sum(entry[2] for entry in recent)
            kind = 'LIGHT' if request == 'devbox-cn-light' else 'HEAVY'
            settings = dynamic.get(box, {})
            task_cpu = float(claim_cores) if claim_cores else settings.get(kind + '_CORES', (config_current_values or {}).get('DEVBOX_' + kind + '_CORES.' + box,
                         (config_current_values or {}).get('DEVBOX_' + kind + '_CORES', 1 if kind == 'LIGHT' else 3)))
            task_mem = float(claim_mem) if claim_mem else settings.get(kind + '_GIB', 2 if kind == 'LIGHT' else 4)
            # CPU hardware does not shrink when a disk probe expires. Unknown
            # hardware uses a labelled slot-count fallback, never invented cores.
            result[box] = dict(cores=cores, coresSource=source, probeAgeSec=age,
                               probeStale=not fresh, metricsFresh=bool(measured), heldSlots=held[box],
                               score=held[box] / (cores or 1), nextScore=(held[box] + 1) / (cores or 1),
                               spareCores=cores - (measured['load5'] + reserved_cpu if box in host_rows else max(measured['load5'], reserved_cpu)) - task_cpu if measured else None,
                               spareMemGiB=measured['memAvailableGiB'] - reserved_mem - task_mem if measured else None,
                               freeGiB=free if number(free) and free >= 0 else None)
        return result
    def warm_slots(project, remote):
        try:
            with open(os.path.join(root, 'devbox-affinity.json')) as stream: affinities = json.load(stream)
            if not isinstance(affinities, dict): return {}
        except (OSError, ValueError): return {}
        # Match devbox-run's project identity and its default identity+branch keys.
        identity = project if re.fullmatch(r'id-[a-f0-9]{64}', project) else 'id-' + hashlib.sha256(('project:' + project).encode()).hexdigest()
        warm = {}
        latest = {}
        for value in affinities.values():
            if not isinstance(value, dict) or not isinstance(value.get('slot'), str): continue
            try: used = datetime.datetime.fromisoformat(value.get('time', '').replace('Z', '+00:00')).timestamp()
            except (AttributeError, TypeError, ValueError, OverflowError): continue
            if 0 < used <= now: latest[value.get('slot')] = max(latest.get(value.get('slot'), 0), used)
        for key, value in affinities.items():
            if not key.startswith(identity + '+') or not isinstance(value, dict): continue
            if value.get('verifiedWorkspace') is False or warm_family and value.get('refFamily') != warm_family: continue
            slot = value.get('slot')
            if not isinstance(slot, str) or slot not in remote or value.get('host') != remote[slot][1]: continue
            try:
                stamp = datetime.datetime.fromisoformat(value.get('time', '').replace('Z', '+00:00'))
                used = stamp.timestamp()
                if stamp.tzinfo is None or not math.isfinite(used) or used <= 0 or used > now: continue
            except (AttributeError, TypeError, ValueError, OverflowError): continue
            if used < latest.get(slot, 0): continue
            if sample(remote[slot][1], now) and (not value.get('verifiedWorkspace') or value.get('repository') != identity): continue
            warm[slot] = max(warm.get(slot, 0), used)
        return warm
    hosts = {value[1] for value in remote.values()}
    def score_line(value):
        return ('heldSlots=%d cores=%s score=%.4f nextScore=%.4f cores_source=%s probe_age_seconds=%s facts=%s spare_cores=%s' %
                (value['heldSlots'], value['cores'] if value['cores'] is not None else '?', value['score'], value['nextScore'],
                 value['coresSource'], int(value['probeAgeSec']) if value['probeAgeSec'] is not None else '?',
                 'STALE-PROBE' if value['probeStale'] else 'fresh', value['spareCores'] if value['spareCores'] is not None else '?'))
    if action == 'audit':
        counts, ever, mini, denials = {}, set(), {}, {}
        try:
            with open(journal) as stream:
                for line in stream:
                    fields = line.rstrip('\n').split('\t')
                    if len(fields) < 3: continue
                    at, event, id = fields[:3]
                    if event == 'take': ever.add(id)
                    try: recent = 0 <= now - datetime.datetime.strptime(at, '%Y-%m-%d %H:%M').timestamp() < 86400
                    except ValueError: continue
                    if not recent: continue
                    if event == 'take':
                        counts[id] = counts.get(id, 0) + 1
                        if id.startswith('heavy-'): mini[id] = mini.get(id, 0) + 1
                    elif event == 'gate-deny' and id in remote:
                        reason = re.search(r'(?:^|\s)reason=([\w-]+)', fields[-1])
                        if reason:
                            key = remote[id][1] + ':' + reason.group(1)
