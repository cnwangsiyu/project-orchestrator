cmd_status() {
  [ "$#" -le 1 ] || die 'status accepts at most one resource id'
  [ -f "$REG" ] || die "no registry at $REG"
  if [ -n "${1:-}" ]; then
    if ! registry_record "$1"; then
      # A pool name (prefix of slot ids such as devbox-cn) keeps the pool view with its waiters.
      [[ "$1" = devbox-cn* ]] && grep -q "^devbox-host-" "$REG" || grep -q "^$1-" "$REG" 2>/dev/null || die "unknown resource '$1'"
      pool_report status "$1"
      return $?
    fi
    if [ "$REG_DEVICE" = - ] && { [ "$REG_KIND" = remote ] || [[ "$1" = heavy-* ]]; }; then
      pool_report status "$1"
      return $?
    fi
    observe_resource status "$1" || return $?
    show_notes "$1"
    return 0
  fi
  local scan_id scan_kind scan_policy scan_device scan_description devices=0
  while IFS=$'\t' read -r scan_id scan_kind scan_policy scan_device scan_description; do
    [ "$scan_device" = - ] || [ -z "$scan_id" ] || [[ "$scan_id" = \#* ]] || devices=1
  done <"$REG"
  if [ "$devices" -eq 0 ]; then
    pool_report status "${1:-}"
    return $?
  fi
  probe
  observe_resource status '' || return $?
  pool_report cleanup-pending-status ''
  pool_report scores
  show_build_waiters
  show_build_waiters "$LANE_WAITERS" lanes
  local pool_root
  for pool_root in "$POOL_WAITERS"/*; do
    [ -d "$pool_root" ] || continue
    show_build_waiters "$pool_root" "pool ${pool_root##*/}"
  done
}

cmd_add() {
