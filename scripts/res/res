import json
import os
import re
import stat
import time


def read_hold(directory, owner_field='by'):
    """Retry publication/replacement races; never turn an incomplete hold into FREE."""
    invalid = None
    for attempt in range(5):
        invalid = None
        try:
            descriptor = os.open(directory, os.O_RDONLY | os.O_NONBLOCK | os.O_DIRECTORY)
        except FileNotFoundError:
            return {}
        try:
            before_dir = os.fstat(descriptor)
            try:
                fd = os.open('info', os.O_RDONLY | os.O_NONBLOCK, dir_fd=descriptor)
                with os.fdopen(fd, 'rb') as stream:
                    before = os.fstat(stream.fileno())
                    if not stat.S_ISREG(before.st_mode): raise ValueError('lease info is not regular')
                    if before.st_size > 1024 * 1024: raise ValueError('lease info is too large')
                    data = stream.read(before.st_size + 1)
                    after = os.fstat(stream.fileno())
                current = os.stat('info', dir_fd=descriptor)
                same_file = (before.st_ino, before.st_dev, before.st_mtime_ns, before.st_ctime_ns, before.st_size)
                if same_file != (after.st_ino, after.st_dev, after.st_mtime_ns, after.st_ctime_ns, after.st_size):
                    raise BlockingIOError('lease info changed during read')
                if not os.path.samestat(after, current) or len(data) != before.st_size:
                    raise BlockingIOError('lease info was replaced')
                if not data or not data.endswith(b'\n'):
                    raise BlockingIOError('incomplete lease publication')
                value = {}
                try:
                    for line in data.decode().splitlines():
                        name, text = line.split('\t', 1)
                        if not name: raise ValueError('empty lease field')
                        value[name] = text
                    if not value.get(owner_field): raise ValueError('missing lease owner')
                except (UnicodeError, ValueError) as error:
                    invalid = str(error)
                if not os.path.samestat(before_dir, os.stat(directory)):
                    raise BlockingIOError('lease directory was replaced')
                if invalid is None: return value
            except FileNotFoundError:
                pass
            except BlockingIOError:
                pass
        finally:
            os.close(descriptor)
        if attempt < 4: time.sleep(0.02)
    if invalid is not None: raise ValueError('corrupt lease state: ' + invalid)
    return {owner_field: '?', '_observation': 'pending'}


def observed_alive(pid):
    try: os.kill(int(pid), 0); return True
    except ProcessLookupError: return False
    except (ValueError, TypeError, OverflowError, PermissionError): return True


def bounded_output(argv, deadline):
    import subprocess
    if time.monotonic() >= deadline: return None
    try:
        child = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError: return None
    try:
        output, _ = child.communicate(timeout=max(0.001, deadline - time.monotonic()))
        return output.decode(errors='replace') if child.returncode == 0 else None
    except subprocess.TimeoutExpired:
        import signal
        try: os.killpg(child.pid, signal.SIGKILL)
        except ProcessLookupError: pass
        child.communicate()
        return None


def device_link(root, id, row):
    device = row[2]
    if device == '-': return '-'
    if row[1] == 'never': return 'not probed'
    deadline = time.monotonic() + 0.65
    def probe_link():
        ios = id.startswith(('iphone', 'ipad', 'ios')) or bool(re.fullmatch(r'[0-9a-fA-F]{40}|[0-9a-fA-F]{8}-[0-9a-fA-F]{16}', device))
        if not ios:
            output = bounded_output(['adb', 'devices'], deadline)
            if output is None: return 'unknown'
            for line in output.splitlines():
                parts = line.split()
                if len(parts) == 2 and parts[0] == device:
                    return 'connected' if parts[1] == 'device' else parts[1]
            return 'not seen'
        command = ['idevice_id', '-l'] if any(os.access(os.path.join(directory, 'idevice_id'), os.X_OK) for directory in os.get_exec_path()) else ['pymobiledevice3', 'usbmux', 'list']
        output = bounded_output(command, deadline)
        if output is not None and device in output: return 'connected'
        output = bounded_output(['xcrun', 'devicectl', 'list', 'devices'], deadline)
        if output is None: return 'unknown'
        for line in output.splitlines():
            if device in line:
                match = re.search(r'\(UDID\)\s+(\S+)', line)
                if match: return 'connected' if match[1].startswith('available') else match[1]
        return 'not seen'
    cache = os.path.join(root, 'status-cache')
    file = os.path.join(cache, id + '.json')
    def cached():
        try:
            with open(file) as stream: value = json.load(stream)
            if value['device'] == device and 0 <= time.time() - value['at'] <= 3 and isinstance(value['link'], str):
                return value['link']
        except (OSError, ValueError, TypeError, KeyError): pass
        return None
    found = cached()
    if found is not None: return found
    import fcntl
    try:
        os.makedirs(cache, exist_ok=True)
        guard = open(os.path.join(cache, id + '.lock'), 'a')
    except OSError: return probe_link()  # Cache is optional, not lease state.
    with guard:
        while True:
            try: fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB); break
            except BlockingIOError:
                found = cached()
                if found is not None: return found
                if time.monotonic() >= deadline: return 'unknown'
                time.sleep(0.02)
        found = cached()
        if found is not None: return found
        link = probe_link()
        temporary = None
        try:
            candidate = os.path.join(cache, '.' + id + '.' + str(os.getpid()))
            fd = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            temporary = candidate
            with os.fdopen(fd, 'w') as stream:
                json.dump(dict(device=device, at=time.time(), link=link), stream)
            os.replace(temporary, file)
        except OSError: pass
        finally:
            if temporary and os.path.exists(temporary): os.unlink(temporary)
        return link


def guard_waiters(root, id, row):
    parents = []
    if id.startswith('heavy-'):
        parents.append(os.path.join(root, 'build-waiters'))
        if id.startswith('heavy-lane-'): parents.append(os.path.join(root, 'lane-waiters'))
    if row[0] == 'remote':
        pool = id if id.endswith('-light') else id.rsplit('-', 1)[0]
        if '-light-' in id: pool = id.rsplit('-', 1)[0]
        if 'dynamic-host-row' in row[3].split():
            parents.extend(os.path.join(root,'pool-waiters', category) for category in ('devbox-cn','devbox-cn-light'))
        else: parents.append(os.path.join(root, 'pool-waiters', pool))
    waiters = []
    host = os.uname().nodename
    ttl = int(os.environ.get('RES_WAITER_STALE_SECONDS', '300'))
    for parent in parents:
        try: names = os.listdir(parent)
        except FileNotFoundError: continue
        for name in names:
            if not name.startswith('waiter.'): continue
            value = read_hold(os.path.join(parent, name), 'holder')
            if not value or value.get('_observation'): continue
            try: fresh = 0 <= time.time() - int(value.get('heartbeat', '0')) <= ttl
            except ValueError: fresh = False
            if not fresh or value.get('host') == host and not observed_alive(value.get('pid')): continue
            if value.get('lane') and value['lane'] != id and id.startswith('heavy-lane-'): continue
            resource = value.get('resource')
            if resource and resource not in (id, 'heavy-build', 'heavy-lane-any', os.path.basename(parent) + '-any'): continue
            caps = re.search(r'(?:^|\s)caps=([^\s]+)', row[3])
            required = set(value.get('need', '').split(',')) - {''}
            if required and not required.issubset(set(caps[1].split(',')) if caps else set()): continue
            excluded = set(value.get('exclude_slots', '').split(','))
            if id in excluded: continue
            remote_host = re.search(r'[A-Za-z0-9_.-]+@([A-Za-z0-9][A-Za-z0-9.-]*)', row[3])
            if remote_host and remote_host[1].rstrip('.') in set(value.get('exclude_hosts', '').split(',')): continue
            waiters.append(value)
    waiters.sort(key=lambda value: (value.get('order', value.get('start', '')), value.get('holder', '')))
    return waiters


def observation_main(root, action, id, by=''):
    rows = {}
    with open(os.path.join(root, 'resources.tsv')) as stream:
        for line in stream:
            if line.startswith('#') or not line.strip(): continue
            parts = line.rstrip('\n').split('\t', 4)
            if len(parts) != 5 or not re.fullmatch(r'[A-Za-z0-9_.-]+', parts[0]): raise ValueError('corrupt resource registry')
            if parts[0] in rows: raise ValueError('duplicate resource registry entry')
            rows[parts[0]] = parts[1:]
    if id and id not in rows and any(resource.startswith('devbox-host-') for resource in rows):
        import subprocess
        if not os.environ.get('RES_SELF_COMMAND'): raise ValueError('dynamic holder requires a res file or RES_SOURCE')
        result = subprocess.run([os.environ['RES_SELF_COMMAND'],'slot-host',id], env={**os.environ,'RES_DIR':root}, capture_output=True,text=True,timeout=10)
        if result.returncode == 0:
            value=json.loads(result.stdout)
            rows[id]=['remote',value['policy'],'-',value['target']+' caps='+','.join(value['caps'])+' dynamic-host-row']
    if id and id not in rows: raise ValueError("unknown resource '%s'" % id)
    if action == 'holder':
        value = read_hold(os.path.join(root, 'locks', id + '.d'))
        state = 'pending' if value.get('_observation') else 'held' if value else 'free'
        waiters = guard_waiters(root, id, rows[id])
        oldest = waiters[0] if waiters else {}
        memory = {}
        if id.startswith('heavy-'):
            namespace = {}; exec(os.environ['RES_MACHINE_SOURCE'], namespace)
            memory['memory'] = namespace['memory_probe'](root, namespace['machine_config'](root), prefer_native=True)['memory']
        print(json.dumps({**memory, 'id': id, 'state': state, 'holder': value.get('by'), 'project': value.get('project'),
                          'task': value.get('task'), 'since': value.get('since'), 'until': value.get('until'),
                          'mine': 'yes' if by and value.get('by') == by else 'no',
                          'yield-requested': 'yes' if waiters else 'no', 'waiters': len(waiters),
                          'oldest-waiter': {'holder': oldest.get('holder'), 'since': oldest.get('since')}}))
        return
    print('%-16s %-9s %-9s %-12s %-34s %s' % ('ID', 'KIND', 'POLICY', 'LINK', 'HOLDER', 'SINCE \u2192 UNTIL / PURPOSE'))
    for name, row in rows.items():
        if id and name != id: continue
        value = read_hold(os.path.join(root, 'locks', name + '.d'))
        if name == 'heavy-build' and not value:
            value = next((v for n in ('heavy-build-2', 'heavy-build-3') if (v := read_hold(os.path.join(root, 'locks', n + '.d')))), {})
        holder = 'FREE'; detail = row[3]
        if value:
            holder = value.get('by', '?') + ' (' + value.get('project', '?') + ('/' + value['task'] if value.get('task') else '') + ')'
            if value.get('_observation'): holder = 'PENDING ' + holder
            elif value.get('host') == os.uname().nodename and not observed_alive(value.get('pid')):
                start = value.get('start', '')
                short = bool(value.get('pid_warning')) or start.isdecimal() and 0 <= time.time() - int(start) <= 5
                count = 0
                if name.startswith('heavy-'):
                    namespace = {'__name__': 'res_build_processes'}
                    exec(os.environ['RES_BUILD_PROCESS_SOURCE'], namespace)
                    count, _ = namespace['probe'](value)
                label = 'STALE-PID (build alive) ' if count else 'STALE-PID (build probe unavailable) ' if count is None else 'STALE?(short-lived pid) ' if short else 'STALE '
                holder = label + holder
                if short: print('res: short-lived holder PID; use scripts/heavy-build.sh <command...>; lock, build and return must share one long-lived process', file=__import__('sys').stderr)
            detail = value.get('since', '?') + ' \u2192 ' + (value.get('until') or '?') + ' \u00b7 ' + value.get('for', '?')
            if value.get('remote_cleanup_required'): detail += ' \u00b7 remote cleanup required'
        link = device_link(root, name, row) if id else '-'
        if not id and row[2] != '-':
            link = 'not seen'
            for line in os.environ.get('RES_STATUS_DEVS', '').splitlines():
                if row[2] + ' (' in line:
                    match = re.search(r'\((?:UDID|ADB|USBMUX)\)\s+(\S+)', line)
                    if match: link = 'connected' if match[1] == 'device' or match[1].startswith('available') else match[1]
                    break
        print('%-16s %-9s %-9s %-12s %-34s %s' % (name, row[0], row[1], link, holder, detail))
    if not id:
        known = {row[2] for row in rows.values()}
        extra = []
        for line in os.environ.get('RES_STATUS_DEVS', '').splitlines():
            match = re.match(r'(\S+) \((USBMUX|ADB)\) device$', line)
            if not match: match = re.search(r'(\S+) \(UDID\)\s+(?:available|connected).*physical', line)
            if match and match[1] not in known:
                extra.append('  ' + match[1] + ' ' + (match[2] if match.lastindex == 2 else 'devicectl'))
        if extra: print('\nConnected but not registered (add with: res add <id> --device <id> --for "<what it is>"):\n' + '\n'.join(sorted(set(extra))))


def observation_cli(root, action, *args):
    if action == 'holder':
        if not args or len(args) not in (1, 3) or len(args) == 3 and (args[1] != '--by' or not args[2]):
            raise ValueError('holder needs <id> [--by <session>]')
        observation_main(root, action, args[0], args[2] if len(args) == 3 else '')
    else:
        if len(args) != 1: raise ValueError('status needs one resource id')
        observation_main(root, action, args[0])
        notes = os.path.join(root, 'notes', args[0] + '.md')
        try:
            with open(notes) as stream: content = stream.read()
        except FileNotFoundError: content = ''
        if content: print('\n\u2500\u2500 notes for %s (%s) \u2014 read before use \u2500\u2500\n%s' % (args[0], notes, content), end='')
